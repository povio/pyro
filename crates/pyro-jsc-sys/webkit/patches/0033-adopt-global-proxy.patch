Pyro patch 0033: a new context's global object adopts another context's global proxy.

JSGlobalContextAdoptGlobalProxy (API/JSForkPrivate.h): what WebCore's JSWindowProxy::setWindow
does for a frame that navigates. The proxy targets the new global (JSGlobalProxy::setTarget, whose
structure transition moves the proxy's realm along) and becomes that global's globalThis (and the
value of its reified `globalThis` property), so a script that kept `iframe.contentWindow` reaches
the frame's next document, and the frame's WindowProxy stays one object across navigations, as in
the HTML standard.

diff --git a/Source/JavaScriptCore/API/JSFork.cpp b/Source/JavaScriptCore/API/JSFork.cpp
index 4d96f154a5..0fa971c494 100644
--- a/Source/JavaScriptCore/API/JSFork.cpp
+++ b/Source/JavaScriptCore/API/JSFork.cpp
@@ -788,6 +788,27 @@ const ClassInfo JSNamedPropertiesObject::s_info = { "WindowProperties"_s, &Base:
 
 } // namespace
 
+bool JSGlobalContextAdoptGlobalProxy(JSGlobalContextRef ctx, JSObjectRef proxyRef)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    auto* proxy = proxyRef ? dynamicDowncast<JSGlobalProxy>(toJS(proxyRef)) : nullptr;
+    if (!proxy || !proxy->target() || &proxy->target()->vm() != &vm)
+        return false;
+    if (proxy->target() == globalObject)
+        return true;
+    // What WebCore's JSWindowProxy::setWindow does: the proxy's prototype and structure
+    // follow the new target (Structure::changeGlobalProxyTargetTransition).
+    proxy->setTarget(vm, globalObject);
+    // JSGlobalObject::setGlobalThis is private; its one store, with the barrier.
+    globalObject->addressOfGlobalThis()->set(vm, globalObject, proxy);
+    // The `globalThis` property (a static one, reified when the global was made) still
+    // holds the proxy the global was made with.
+    globalObject->putDirect(vm, Identifier::fromString(vm, "globalThis"_s), proxy, static_cast<unsigned>(PropertyAttribute::DontEnum));
+    return true;
+}
+
 void JSGlobalContextInstallNamedProperties(JSGlobalContextRef ctx, JSNamedPropertyFilter filter, JSObjectGetPropertyCallback getter)
 {
     JSGlobalObject* globalObject = toJS(ctx);
