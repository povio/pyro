 JS_EXPORT bool JSGlobalContextSetModuleLoader(JSGlobalContextRef ctx, JSModuleLoaderFetchCallback callback, void* info);
 
+/* The `type` import attribute of a module request (HTML "module type"). */
+typedef enum {
+    kJSModuleTypeJavaScript = 0, /* no `type` attribute */
+    kJSModuleTypeJSON = 1,
+    kJSModuleTypeCSS = 2,
+    kJSModuleTypeWebAssembly = 3,
+    kJSModuleTypeText = 4,
+} JSModuleType;
+
+/* Like JSModuleLoaderFetchCallback, with the request's module type. Resolve a
+   JavaScript request with JSModuleSourceCreate, a JSON one with
+   JSModuleSourceCreateWithType(kJSModuleTypeJSON) and a CSS one with the
+   object to export as `default` (a CSSStyleSheet); any other value rejects
+   the import with a TypeError. Module map entries are keyed by (URL, type), so
+   one URL can be fetched once per type. */
+typedef void (*JSModuleLoaderTypedFetchCallback)(JSGlobalContextRef ctx, JSStringRef identifier, JSModuleType type, JSObjectRef resolve, JSObjectRef reject, void* info);
+
+/* Installs (or, with a NULL callback, removes) a typed fetch callback; it
+   replaces any JSGlobalContextSetModuleLoader callback. Without one, requests
+   with a `type` attribute are rejected with a TypeError instead of being
+   fetched as JavaScript. */
+JS_EXPORT bool JSGlobalContextSetTypedModuleLoader(JSGlobalContextRef ctx, JSModuleLoaderTypedFetchCallback callback, void* info);
+
 /* Supplies the document base URL for specifiers whose script has no URL to
    resolve against. Returns a string the caller owns, or NULL. It runs during
    module resolution and must not run script. */
