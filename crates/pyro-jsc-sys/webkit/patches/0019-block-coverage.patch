index 0000000000..dc8b692920
--- /dev/null
+++ b/Source/JavaScriptCore/API/JSCoverage.cpp
@@ -0,0 +1,151 @@
+/*
+ * Pyro: see JSCoveragePrivate.h.
+ */
+
+#include "config.h"
+#include "JSCoveragePrivate.h"
+
+#include "APICast.h"
+#include "ControlFlowProfiler.h"
+#include "DeleteAllCodeEffort.h"
+#include "JSCInlines.h"
+#include "JSGlobalObject.h"
+#include "JSLock.h"
+#include "OpaqueJSString.h"
+#include "SourceProvider.h"
+#include "VM.h"
+#include <wtf/HashMap.h>
+#include <wtf/Lock.h>
+#include <wtf/NeverDestroyed.h>
+
+using namespace JSC;
+
+namespace {
+
+// The enables of each VM not yet matched by a disable. The VM keeps its own count of
+// profiler users, which must never go below zero.
+UncheckedKeyHashMap<VM*, unsigned>& coverageUsers()
+{
+    static NeverDestroyed<UncheckedKeyHashMap<VM*, unsigned>> users;
+    return users;
+}
+Lock coverageUsersLock;
+
+} // namespace
+
+void JSContextGroupSetCoverageEnabled(JSContextGroupRef group, bool enabled)
+{
+    if (!group)
+        return;
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+    {
+        Locker lock { coverageUsersLock };
+        auto& users = coverageUsers();
+        auto it = users.find(&vm);
+        unsigned count = it == users.end() ? 0 : it->value;
+        if (!enabled && !count)
+            return;
+        count = enabled ? count + 1 : count - 1;
+        if (count)
+            users.set(&vm, count);
+        else
+            users.remove(&vm);
+    }
+    // As Web Inspector's Runtime.enableControlFlowProfiler: no code may be on the stack
+    // while the profiler (whose counters compiled code points at) comes or goes.
+    vm.whenIdle([&vm, enabled] {
+        bool recompile = enabled ? vm.enableControlFlowProfiler() : vm.disableControlFlowProfiler();
+        if (recompile)
+            vm.deleteAllCode(PreventCollectionAndDeleteAllCode);
+    });
+}
+
+static JSStringRef copyString(const String& string)
+{
+    if (string.isNull())
+        return nullptr;
+    return OpaqueJSString::tryCreate(String { string }).leakRef();
+}
+
+static void release(JSStringRef string)
+{
+    if (string)
+        string->deref();
+}
+
+// Calls `callback` for one source; the strings it makes are released after.
+template<typename Body>
+static void withSource(SourceID sourceID, const ControlFlowProfiler::CoverageSource& entry, bool withText, const Body& body)
+{
+    SourceProvider& provider = *entry.provider;
+    // A `//# sourceURL=` comment names the script, as in V8.
+    const String& directive = provider.sourceURLDirective();
+    JSCoverageSource source {
+        sourceID,
+        reinterpret_cast<JSGlobalContextRef>(entry.globalObject),
+        copyString(directive.isEmpty() ? provider.sourceURL() : directive),
+        provider.sourceOrigin().isNull() ? nullptr : copyString(provider.sourceOrigin().url().string()),
+        withText ? copyString(provider.source().toString()) : nullptr,
+        provider.sourceType() == SourceProviderSourceType::Module,
+    };
+    body(source);
+    release(source.url);
+    release(source.originURL);
+    release(source.source);
+}
+
+void JSContextGroupCoverageNewSources(JSContextGroupRef group, size_t* cursor, JSCoverageSourceCallback callback, void* data)
+{
+    if (!group || !cursor || !callback)
+        return;
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+    ControlFlowProfiler* profiler = vm.controlFlowProfiler();
+    if (!profiler)
+        return;
+    Vector<std::pair<SourceID, ControlFlowProfiler::CoverageSource>> sources;
+    const Vector<SourceID>& order = profiler->coverageSourceOrder();
+    for (size_t i = *cursor; i < order.size(); ++i)
+        sources.append({ order[i], profiler->coverageSources().get(order[i]) });
+    *cursor = std::max(*cursor, order.size());
+    for (auto& [sourceID, entry] : sources) {
+        withSource(sourceID, entry, true, [&](const JSCoverageSource& source) {
+            callback(data, &source, nullptr, 0, nullptr, 0);
+        });
+    }
+}
+
+void JSContextGroupTakeCoverage(JSContextGroupRef group, JSCoverageSourceCallback callback, void* data)
+{
+    if (!group || !callback)
+        return;
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+    ControlFlowProfiler* profiler = vm.controlFlowProfiler();
+    if (!profiler)
+        return;
+
+    // Copied first: the callback may run code that compiles more.
+    Vector<std::pair<SourceID, ControlFlowProfiler::CoverageSource>> sources;
+    for (SourceID id : profiler->coverageSourceOrder())
+        sources.append({ id, profiler->coverageSources().get(id) });
+
+    for (auto& [sourceID, entry] : sources) {
+        Vector<JSCoverageBlock> blocks;
+        for (const BasicBlockRange& range : profiler->coverageBlocks(sourceID)) {
+            if (range.m_endOffset < range.m_startOffset)
+                continue;
+            blocks.append(JSCoverageBlock { range.m_startOffset, range.m_endOffset, static_cast<uint64_t>(range.m_executionCount) });
+        }
+        Vector<JSCoverageFunction> functions;
+        for (auto& function : profiler->coverageFunctions(sourceID))
+            functions.append(JSCoverageFunction { function.start, function.end, function.executed, function.name.isEmpty() ? nullptr : copyString(function.name) });
+
+        withSource(sourceID, entry, false, [&](const JSCoverageSource& source) {
+            callback(data, &source, blocks.span().data(), blocks.size(), functions.span().data(), functions.size());
+        });
+        for (auto& function : functions)
+            release(function.name);
+    }
+}
diff --git a/Source/JavaScriptCore/API/JSCoveragePrivate.h b/Source/JavaScriptCore/API/JSCoveragePrivate.h
new file mode 100644
index 0000000000..c6a5b1fd4c
--- /dev/null
+++ b/Source/JavaScriptCore/API/JSCoveragePrivate.h
@@ -0,0 +1,78 @@
+/*
+ * Pyro: block coverage, for CDP's precise coverage (Playwright's
+ * page.coverage.startJSCoverage). Built on the control flow profiler that Web Inspector
+ * uses: with it on, code is compiled with a counter at the start of every basic block.
+ * Off (the default) it costs nothing; turning it on or off recompiles all code.
+ */
+
+#ifndef JSCoveragePrivate_h
+#define JSCoveragePrivate_h
+
+#include <JavaScriptCore/JSBase.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Counted: block coverage is on while the enables outnumber the disables (a disable
+   without an enable is ignored). The first enable and the last disable drop all
+   compiled code of `group`, which recompiles on its next run (with or without the
+   counters); they take effect once no JavaScript of `group` is running. Disabling
+   forgets what was counted. Code that ran before coverage was on is reported only
+   for the functions that run again. */
+JS_EXPORT void JSContextGroupSetCoverageEnabled(JSContextGroupRef group, bool enabled);
+
+/* A source that has code compiled since coverage was turned on: its id (unique in the
+   process), the global object it first ran in (an identity only: it may be gone), its
+   URL (its `//# sourceURL=` comment, else the URL given to JSEvaluateScript or the
+   module's), the URL of the code that created it (for eval and new Function, which have
+   no URL of their own; NULL when none), its text (NULL where noted) and whether it is a
+   module. */
+typedef struct {
+    intptr_t sourceID;
+    JSGlobalContextRef globalObject;
+    JSStringRef url;
+    JSStringRef originURL;
+    JSStringRef source;
+    bool isModule;
+} JSCoverageSource;
+
+/* One basic block (or the part of it between the functions it encloses): source
+   offsets in UTF-16 units, `end` inclusive, and how many times it ran. */
+typedef struct {
+    int32_t start;
+    int32_t end;
+    uint64_t count;
+} JSCoverageBlock;
+
+/* A function declared by code compiled while coverage was on: offsets as in
+   JSCoverageBlock (`end` is its closing brace), whether it ran, and its name (NULL
+   when anonymous). */
+typedef struct {
+    uint32_t start;
+    uint32_t end;
+    bool executed;
+    JSStringRef name;
+} JSCoverageFunction;
+
+/* The strings and arrays live for the duration of the call. */
+typedef void (*JSCoverageSourceCallback)(void* data, const JSCoverageSource* source,
+    const JSCoverageBlock* blocks, size_t blockCount, const JSCoverageFunction* functions, size_t functionCount);
+
+/* Calls `callback` (with its text, and no blocks or functions) for each source first
+   compiled after the first `*cursor` ones, in that order, and advances `*cursor`. Start
+   at 0 each time coverage is turned on. Nothing when coverage is off. */
+JS_EXPORT void JSContextGroupCoverageNewSources(JSContextGroupRef group, size_t* cursor, JSCoverageSourceCallback callback, void* data);
+
+/* Calls `callback` (with no text) for every source of `group` that has code compiled
+   since coverage was turned on, with what ran. Nothing when coverage is off. */
+JS_EXPORT void JSContextGroupTakeCoverage(JSContextGroupRef group, JSCoverageSourceCallback callback, void* data);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* JSCoveragePrivate_h */
