+void ControlFlowProfiler::noteCoverageSource(SourceProvider* provider, JSGlobalObject* globalObject)
+{
+    if (!provider)
+        return;
+    SourceID id = provider->asID();
+    if (id <= 0)
+        return;
+    if (m_coverageSources.add(id, CoverageSource { provider, globalObject }).isNewEntry)
+        m_coverageSourceOrder.append(id);
+}
+
+void ControlFlowProfiler::noteCoverageFunction(SourceID sourceID, unsigned start, unsigned end, const String& name, bool executed)
+{
+    if (start == UINT_MAX || end == UINT_MAX || end < start)
+        return;
+    auto& functions = m_coverageFunctions.add(sourceID, UncheckedKeyHashMap<uint64_t, CoverageFunction> { }).iterator->value;
+    uint64_t key = ((static_cast<uint64_t>(start) << 32) | end) + 1;
+    auto result = functions.add(key, CoverageFunction { start, end, executed, name });
+    if (!result.isNewEntry) {
+        // A function is first seen unexecuted (declared by its parent's code) and marked
+        // executed once its own code is compiled; it never goes back.
+        result.iterator->value.executed |= executed;
+        if (result.iterator->value.name.isEmpty())
+            result.iterator->value.name = name;
+    }
+}
+
+Vector<ControlFlowProfiler::CoverageFunction> ControlFlowProfiler::coverageFunctions(SourceID sourceID) const
+{
+    Vector<CoverageFunction> result;
+    auto it = m_coverageFunctions.find(sourceID);
+    if (it == m_coverageFunctions.end())
+        return result;
+    for (auto& function : it->value.values())
+        result.append(function);
+    return result;
+}
+
+Vector<BasicBlockRange> ControlFlowProfiler::coverageBlocks(SourceID sourceID) const
+{
+    Vector<BasicBlockRange> result;
+    auto bucket = m_sourceIDBuckets.find(sourceID);
+    if (bucket == m_sourceIDBuckets.end())
+        return result;
+    for (const BasicBlockLocation* block : bucket->value.values()) {
+        size_t executionCount = block->executionCount();
+        for (BasicBlockLocation::Gap gap : block->getExecutedRanges())
+            result.append(BasicBlockRange { gap.first, gap.second, executionCount > 0, executionCount });
+    }
+    return result;
+}
+
