+// Trusted Types for eval and Function, through the embedder's callbacks
+// (JSGlobalContextSetCompileStringsCallbacks): without them, the defaults.
+String JSAPIGlobalObject::codeForEval(JSGlobalObject* globalObject, JSValue value)
+{
+    auto* thisObject = uncheckedDowncast<JSAPIGlobalObject>(globalObject);
+    if (!thisObject->m_codeForEvalCallback || !value.isObject())
+        return nullString();
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto callback = reinterpret_cast<JSCodeForEvalCallback>(thisObject->m_codeForEvalCallback);
+    JSValueRef exception = nullptr;
+    JSStringRef result = callback(toRef(globalObject), toRef(asObject(value)), &exception);
+    String code = result ? result->string() : nullString();
+    if (result)
+        JSStringRelease(result);
+    if (exception) {
+        throwException(globalObject, scope, toJS(globalObject, exception));
+        return nullString();
+    }
+    return code;
+}
+
+bool JSAPIGlobalObject::canCompileStrings(JSGlobalObject* globalObject, CompilationType type, String code, const ArgList& args)
+{
+    auto* thisObject = uncheckedDowncast<JSAPIGlobalObject>(globalObject);
+    if (!thisObject->m_canCompileStringsCallback)
+        return true;
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto callback = reinterpret_cast<JSCanCompileStringsCallback>(thisObject->m_canCompileStringsCallback);
+    Vector<JSValueRef, 8> arguments;
+    for (size_t i = 0; i < args.size(); ++i)
+        arguments.append(toRef(globalObject, args.at(i)));
+    auto codeRef = OpaqueJSString::tryCreate(code.isNull() ? emptyString() : code);
+    JSValueRef exception = nullptr;
+    bool allowed = callback(toRef(globalObject), static_cast<int>(type), codeRef.get(), arguments.size(), arguments.span().data(), &exception);
+    if (exception) {
+        throwException(globalObject, scope, toJS(globalObject, exception));
+        return false;
+    }
+    return allowed;
+}
