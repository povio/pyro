+bool JSGlobalContextSetCompileStringsCallbacks(JSGlobalContextRef ctx, JSCodeForEvalCallback codeForEval, JSCanCompileStringsCallback canCompileStrings)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject)
+        return false;
+    apiGlobalObject->setCompileStringsCallbacks(reinterpret_cast<void*>(codeForEval), reinterpret_cast<void*>(canCompileStrings));
+    return true;
+}
+
+void JSGlobalContextSetTrustedTypesEnforcement(JSGlobalContextRef ctx, JSTrustedTypesEnforcement enforcement)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    TrustedTypesEnforcement value = TrustedTypesEnforcement::None;
+    switch (enforcement) {
+    case kJSTrustedTypesReportOnly: value = TrustedTypesEnforcement::ReportOnly; break;
+    case kJSTrustedTypesEnforced: value = TrustedTypesEnforcement::Enforced; break;
+    case kJSTrustedTypesEnforcedWithEvalEnabled: value = TrustedTypesEnforcement::EnforcedWithEvalEnabled; break;
+    default: break;
+    }
+    globalObject->setTrustedTypesEnforcement(value);
+}
