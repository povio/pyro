+/* Trusted Types for string compilation (eval, Function). `codeForEval` gets an object
+   passed to eval and returns its code as a new string the caller releases (a TrustedScript),
+   or NULL to leave it unevaluated, as eval does with any other object. `canCompileStrings`
+   decides whether `code` may compile: `compilationType` is 0 for Function (with the
+   constructor's arguments), 1 for direct and 2 for indirect eval. It is asked only while the
+   global's enforcement (below) is not kJSTrustedTypesNone, and not for an eval of a
+   TrustedScript. Either may set `*exception`. False when `ctx` has no C-API global. */
+typedef JSStringRef (*JSCodeForEvalCallback)(JSContextRef ctx, JSObjectRef value, JSValueRef* exception);
+typedef bool (*JSCanCompileStringsCallback)(JSContextRef ctx, int compilationType, JSStringRef code, size_t argumentCount, const JSValueRef arguments[], JSValueRef* exception);
+JS_EXPORT bool JSGlobalContextSetCompileStringsCallbacks(JSGlobalContextRef ctx, JSCodeForEvalCallback codeForEval, JSCanCompileStringsCallback canCompileStrings);
+
+typedef enum {
+    kJSTrustedTypesNone = 0,
+    kJSTrustedTypesReportOnly = 1,
+    kJSTrustedTypesEnforced = 2,
+    kJSTrustedTypesEnforcedWithEvalEnabled = 3,
+} JSTrustedTypesEnforcement;
+/* The global's `require-trusted-types-for 'script'` state for eval and Function. */
+JS_EXPORT void JSGlobalContextSetTrustedTypesEnforcement(JSGlobalContextRef ctx, JSTrustedTypesEnforcement enforcement);
+
 #ifdef __cplusplus
 }
 #endif
