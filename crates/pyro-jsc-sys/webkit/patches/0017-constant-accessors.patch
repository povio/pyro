+static JSC_DECLARE_CUSTOM_GETTER(constantAccessorGetter);
+
+// Pyro: what makes the value of a lazy constant accessor on its first read
+// (JSSetConstantAccessorInitializer); one per process.
+static std::atomic<JSConstantAccessorInitializer> constantAccessorInitializer;
+
+// The getter of every constant accessor, eager or lazy, for its whole life: the function a
+// property descriptor reifies for it is cached by getter (createCustomGetterFunction), so the
+// property's `get` stays the same function when a lazy one gets its value and when its realm
+// is torn down, as for a WebIDL attribute. What the accessor holds tells the states apart
+// (CustomGetterSetter::constant, isClearedConstant): a value, nothing yet (a lazy one before
+// its first read), or nothing for good (cleared with its realm).
+static bool isConstantAccessorGetter(CustomGetterSetter::CustomGetter getter)
+{
+    return getter == CustomGetterSetter::CustomGetter(constantAccessorGetter);
+}
+
+// Pyro: `receiver`'s own constant accessor `name` (JSObjectSetConstantAccessor,
+// JSObjectSetLazyConstantAccessor), through its global proxy, and where it is (`holder`,
+// `offset`); null if it has none.
+static CustomGetterSetter* constantAccessorOf(VM& vm, JSValue receiver, PropertyName name, JSObject*& holder, PropertyOffset& offset)
+{
+    if (!receiver.isObject())
+        return nullptr;
+    JSObject* object = asObject(receiver);
+    if (object->type() == GlobalProxyType)
+        object = uncheckedDowncast<JSGlobalProxy>(object)->target();
+    unsigned attributes;
+    offset = object->structure()->get(vm, name, attributes);
+    if (!isValidOffset(offset) || !(attributes & PropertyAttribute::CustomAccessor))
+        return nullptr;
+    JSValue value = object->getDirect(offset);
+    if (!value.isCell() || value.asCell()->type() != CustomGetterSetterType)
+        return nullptr;
+    auto* accessor = static_cast<CustomGetterSetter*>(value.asCell());
+    if (!isConstantAccessorGetter(accessor->getter()))
+        return nullptr;
+    holder = object;
+    return accessor;
+}
+
+// The getter. A read of the holder's property (directly, through its global proxy, or as a
+// bare global variable) gets the constant; so does the reified getter called with the
+// holder, or with undefined or null (its realm's global, as for a WebIDL [Global] interface).
+// Any other receiver has no such own property and gets the TypeError of a failed brand check.
+// A lazy accessor's first read makes the constant (the initializer) and keeps it from then on.
+// Once the constant is cleared with its realm (JSObjectClearConstantAccessors), reads throw.
+// The DFG folds reads of the property on its holder instead of calling this, once there is a
+// constant to fold.
+static EncodedJSValue readConstantAccessor(JSGlobalObject* globalObject, EncodedJSValue thisValue, PropertyName name)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    JSValue receiver = JSValue::decode(thisValue);
+    if (receiver.isUndefinedOrNull())
+        receiver = globalObject->globalThis();
+    JSObject* holder = nullptr;
+    PropertyOffset offset = invalidOffset;
+    CustomGetterSetter* accessor = constantAccessorOf(vm, receiver, name, holder, offset);
+    if (!accessor)
+        return throwVMTypeError(globalObject, scope, "Illegal invocation"_s);
+    if (JSValue constant = accessor->constant())
+        return JSValue::encode(constant);
+    JSConstantAccessorInitializer initializer = constantAccessorInitializer.load(std::memory_order_acquire);
+    if (accessor->isClearedConstant() || !initializer)
+        return throwVMError(globalObject, scope, "Execution context was destroyed."_s);
+
+    JSGlobalObject* realm = holder->realm();
+    auto propertyName = OpaqueJSString::tryCreate(String(name.uid()));
+    if (!propertyName) [[unlikely]]
+        return throwVMError(globalObject, scope, createOutOfMemoryError(globalObject));
+    JSValueRef exception = nullptr;
+    JSValueRef made = initializer(toRef(realm), toRef(holder), propertyName.get(), &exception);
+    RETURN_IF_EXCEPTION(scope, { });
+    if (exception)
+        return throwVMError(globalObject, scope, toJS(globalObject, exception));
+    if (!made)
+        return throwVMError(globalObject, scope, "Execution context was destroyed."_s);
+    JSValue value = toJS(realm, made);
+
+    // The initializer may have run code that filled or cleared the property: look again.
+    accessor = constantAccessorOf(vm, receiver, name, holder, offset);
+    if (!accessor)
+        return throwVMTypeError(globalObject, scope, "Illegal invocation"_s);
+    if (JSValue constant = accessor->constant())
+        return JSValue::encode(constant);
+    if (accessor->isClearedConstant())
+        return throwVMError(globalObject, scope, "Execution context was destroyed."_s);
+    // A CustomGetterSetter does not change once published (the DFG reads it concurrently), so
+    // the property gets a new one, made whole before the slot points to it. Same getter, setter,
+    // attributes and structure: the reified getter stays the same function, and inline caches
+    // that call the getter stay valid (it reads this one).
+    CustomGetterSetter* filled = CustomGetterSetter::createConstant(vm, accessor->getter(), accessor->setter(), value);
+    WTF::storeStoreFence();
+    holder->putDirectOffset(vm, offset, filled);
+    return JSValue::encode(value);
+}
+
+JSC_DEFINE_CUSTOM_GETTER(constantAccessorGetter, (JSGlobalObject* globalObject, EncodedJSValue thisValue, PropertyName name))
+{
+    return readConstantAccessor(globalObject, thisValue, name);
+}
+
+// JSObjectSetConstantAccessor, and its lazy form when `value` is empty.
+static bool setConstantAccessor(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSValueRef value, JSCustomSetterCallback setter, JSPropertyAttributes attributes)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(vm);
+    JSObject* jsObject = toJS(object);
+    if (jsObject->type() == GlobalProxyType)
+        jsObject = uncheckedDowncast<JSGlobalProxy>(jsObject)->target();
+    Identifier name = propertyName->identifier(&vm);
+    if (parseIndex(name))
+        return false;
+    // Set once: compiled code may hold the constant of an existing one. A configurable
+    // property of that name (a copied prototype accessor) is replaced.
+    unsigned existingAttributes;
+    if (isValidOffset(jsObject->structure()->get(vm, name, existingAttributes))) {
+        if (existingAttributes & PropertyAttribute::DontDelete)
+            return false;
+        DeletePropertySlot slot;
+        bool deleted = jsObject->methodTable()->deleteProperty(jsObject, globalObject, name, slot);
+        // A C API class's deleteProperty callback may throw.
+        if (scope.exception()) [[unlikely]] {
+            scope.clearException();
+            return false;
+        }
+        if (!deleted)
+            return false;
+    }
+    unsigned attrs = static_cast<unsigned>(PropertyAttribute::CustomAccessor) | static_cast<unsigned>(PropertyAttribute::DontDelete);
+    if (attributes & kJSPropertyAttributeDontEnum)
+        attrs |= static_cast<unsigned>(PropertyAttribute::DontEnum);
+    if (!setter)
+        attrs |= static_cast<unsigned>(PropertyAttribute::ReadOnly);
+    PutValueFunc putValue = setter ? PutValueFunc(reinterpret_cast<bool (*)(JSGlobalObject*, EncodedJSValue, EncodedJSValue, PropertyName)>(setter)) : PutValueFunc(nullptr);
+    CustomGetterSetter* accessor = value
+        ? CustomGetterSetter::createConstant(vm, constantAccessorGetter, putValue, toJS(globalObject, value))
+        : CustomGetterSetter::create(vm, constantAccessorGetter, putValue);
+    return jsObject->putDirectCustomAccessor(vm, name, accessor, attrs);
+}
+
+} // namespace JSC
+
+bool JSObjectSetConstantAccessor(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSValueRef value, JSCustomSetterCallback setter, JSPropertyAttributes attributes)
+{
+    if (!ctx || !object || !propertyName || !value)
+        return false;
+    return setConstantAccessor(ctx, object, propertyName, value, setter, attributes);
+}
+
+bool JSObjectSetLazyConstantAccessor(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSCustomSetterCallback setter, JSPropertyAttributes attributes)
+{
+    if (!ctx || !object || !propertyName || !constantAccessorInitializer.load(std::memory_order_acquire))
+        return false;
+    return setConstantAccessor(ctx, object, propertyName, nullptr, setter, attributes);
+}
+
+void JSSetConstantAccessorInitializer(JSConstantAccessorInitializer initializer)
+{
+    constantAccessorInitializer.store(initializer, std::memory_order_release);
+}
+
+void JSObjectClearConstantAccessors(JSContextRef ctx, JSObjectRef object)
+{
+    if (!ctx || !object)
+        return;
+    VM& vm = toJS(ctx)->vm();
+    JSLockHolder locker(vm);
+    JSObject* jsObject = toJS(object);
+    if (jsObject->type() == GlobalProxyType)
+        jsObject = uncheckedDowncast<JSGlobalProxy>(jsObject)->target();
+    Vector<PropertyOffset, 4> offsets;
+    jsObject->structure()->forEachProperty(vm, [&](const auto& entry) {
+        if (!(entry.attributes() & PropertyAttribute::CustomAccessor))
+            return true;
+        JSValue value = jsObject->getDirect(entry.offset());
+        if (value.isCell() && value.asCell()->type() == CustomGetterSetterType) {
+            auto* accessor = static_cast<CustomGetterSetter*>(value.asCell());
+            if (isConstantAccessorGetter(accessor->getter()) && !accessor->isClearedConstant())
+                offsets.append(entry.offset());
+        }
+        return true;
+    });
+    // A CustomGetterSetter does not change once published (the DFG reads it concurrently), so
+    // each property gets a new one without a constant, never to be made (a lazy one's included):
+    // the getter throws and the DFG folds nothing. Same getter, setter, attributes and structure,
+    // so the reified getter stays the same function and inline caches stay valid.
+    for (PropertyOffset offset : offsets) {
+        auto* accessor = static_cast<CustomGetterSetter*>(jsObject->getDirect(offset).asCell());
+        CustomGetterSetter* cleared = CustomGetterSetter::createClearedConstant(vm, accessor->getter(), accessor->setter());
+        WTF::storeStoreFence();
+        jsObject->putDirectOffset(vm, offset, cleared);
+    }
+}
