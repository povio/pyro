Pyro patch 0036: the promise rejection tracker for the embedder.

The C API reports rejected promises only through JSGlobalContextSetUnhandledRejectionCallback:
once the microtask queue is empty, for the promises rejected since that have no handler. An
embedder could not learn that a handler was added to a promise later (HTML's rejectionhandled
event, and dropping a promise from its about-to-be-notified list between the checkpoint and the
task that reports it). JSGlobalContextSetPromiseRejectionTracker (API/JSForkPrivate.h) gives
JSAPIGlobalObject a per-global callback for the HostPromiseRejectionTracker operations the
embedder asks for (a bit set: one that needs only Handle is not called for every rejection),
called as they happen with the promise and its reason; the default tracking stays as it is.

diff --git a/Source/JavaScriptCore/API/JSAPIGlobalObject.cpp b/Source/JavaScriptCore/API/JSAPIGlobalObject.cpp
index 76cd1f68..65d6dbc5 100644
--- a/Source/JavaScriptCore/API/JSAPIGlobalObject.cpp
+++ b/Source/JavaScriptCore/API/JSAPIGlobalObject.cpp
@@ -97,6 +97,19 @@ void JSAPIGlobalObject::reportUncaughtExceptionAtEventLoop(JSGlobalObject* globa
     Base::reportUncaughtExceptionAtEventLoop(globalObject, exception);
 }
 
+// HostPromiseRejectionTracker for the embedder (JSGlobalContextSetPromiseRejectionTracker): told of
+// the operations it asked for as they happen, before the default tracking (the VM's list of rejected promises,
+// which the unhandled rejection callback is called for once the microtask queue is empty).
+void JSAPIGlobalObject::promiseRejectionTracker(JSGlobalObject* globalObject, JSPromise* promise, JSPromiseRejectionOperation operation)
+{
+    auto* thisObject = uncheckedDowncast<JSAPIGlobalObject>(globalObject);
+    if (thisObject->m_promiseRejectionTrackerCallback && (thisObject->m_promiseRejectionTrackerOperations & (1u << static_cast<unsigned>(operation)))) {
+        auto callback = reinterpret_cast<JSPromiseRejectionTrackerCallback>(thisObject->m_promiseRejectionTrackerCallback);
+        callback(toRef(globalObject), toRef(promise), toRef(globalObject, promise->result()), static_cast<int>(operation));
+    }
+    Base::promiseRejectionTracker(globalObject, promise, operation);
+}
+
 // Trusted Types for eval and Function, through the embedder's callbacks
 // (JSGlobalContextSetCompileStringsCallbacks): without them, the defaults.
 String JSAPIGlobalObject::codeForEval(JSGlobalObject* globalObject, JSValue value)
@@ -505,6 +518,17 @@ bool JSGlobalContextSetCompileStringsCallbacks(JSGlobalContextRef ctx, JSCodeFor
     return true;
 }
 
+bool JSGlobalContextSetPromiseRejectionTracker(JSGlobalContextRef ctx, JSPromiseRejectionTrackerCallback callback, unsigned operations)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject)
+        return false;
+    apiGlobalObject->setPromiseRejectionTrackerCallback(reinterpret_cast<void*>(callback), operations);
+    return true;
+}
+
 void JSGlobalContextSetTrustedTypesEnforcement(JSGlobalContextRef ctx, JSTrustedTypesEnforcement enforcement)
 {
     JSGlobalObject* globalObject = toJS(ctx);
