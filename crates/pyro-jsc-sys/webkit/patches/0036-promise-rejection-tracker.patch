     void* m_moduleBaseURLCallback { nullptr };
diff --git a/Source/JavaScriptCore/API/JSForkPrivate.h b/Source/JavaScriptCore/API/JSForkPrivate.h
index 0d6e7592..58a6de4e 100644
--- a/Source/JavaScriptCore/API/JSForkPrivate.h
+++ b/Source/JavaScriptCore/API/JSForkPrivate.h
@@ -292,6 +292,21 @@ typedef enum {
 /* The global's `require-trusted-types-for 'script'` state for eval and Function. */
 JS_EXPORT void JSGlobalContextSetTrustedTypesEnforcement(JSGlobalContextRef ctx, JSTrustedTypesEnforcement enforcement);
 
+/* Promise rejection tracking (HTML's HostPromiseRejectionTracker): `callback` is called as it
+   happens when a promise of `ctx`'s realm is rejected without a handler (`operation`
+   kJSPromiseRejectionReject) and when a handler is first added to a rejected promise
+   (kJSPromiseRejectionHandle), with the promise and its rejection reason, for the operations
+   whose bit (1 << operation) is set in `operations`. It may not run JavaScript. The unhandled
+   rejection callback (JSGlobalContextSetUnhandledRejectionCallback) is still called, once the
+   microtask queue is empty, for the promises rejected since that have no handler by then. NULL
+   removes the callback. False when `ctx` is not a C-API global. */
+enum {
+    kJSPromiseRejectionReject = 0,
+    kJSPromiseRejectionHandle = 1,
+};
+typedef void (*JSPromiseRejectionTrackerCallback)(JSContextRef ctx, JSObjectRef promise, JSValueRef reason, int operation);
+JS_EXPORT bool JSGlobalContextSetPromiseRejectionTracker(JSGlobalContextRef ctx, JSPromiseRejectionTrackerCallback callback, unsigned operations);
+
 #ifdef __cplusplus
 }
 #endif
