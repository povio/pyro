     void* m_codeForEvalCallback { nullptr };
     void* m_canCompileStringsCallback { nullptr };
+    void* m_promiseRejectionTrackerCallback { nullptr };
+    unsigned m_promiseRejectionTrackerOperations { 0 };
     void* m_moduleLoaderCallback { nullptr };
