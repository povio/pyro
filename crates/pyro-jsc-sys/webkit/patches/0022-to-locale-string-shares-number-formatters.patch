+    return numberFormat;
+}
+
+// pyro: Number.prototype.toLocaleString(locales, options) reads the options as the spec says (getters and
+// proxies observe those reads), but a fresh ICU formatter costs its first format a DecimalFormatSymbols load from the
+// locale data: about 170 us with the system ICU, for every call. Formatting does not observe which formatter formats,
+// so a call whose options resolve to the skeleton and data locale of a recent call formats with that call's formatter.
+IntlNumberFormat* JSGlobalObject::toLocaleStringNumberFormatWithOptions(JSValue locales, JSValue options)
+{
+    VM& vm = this->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    IntlNumberFormat* numberFormat = IntlNumberFormat::create(vm, numberFormatStructure());
+    numberFormat->initializeNumberFormat(this, locales, options, IntlNumberFormat::OpenFormatter::No);
+    RETURN_IF_EXCEPTION(scope, nullptr);
+
+    if (!vm.intlCache().hasLanguageChange() && m_toLocaleStringNumberFormatsWithOptionsLanguagesEpoch == vm.intlCache().languagesEpoch()) {
+        for (auto& recent : m_toLocaleStringNumberFormatsWithOptions) {
+            if (recent && recent->hasSameFormatterAs(*numberFormat))
+                return recent.get();
+        }
+    } else {
+        for (auto& recent : m_toLocaleStringNumberFormatsWithOptions)
+            recent.clear();
+        m_toLocaleStringNumberFormatsWithOptionsLanguagesEpoch = vm.intlCache().languagesEpoch();
+    }
+
+    numberFormat->openNumberFormatter(this);
+    RETURN_IF_EXCEPTION(scope, nullptr);
+
+    m_toLocaleStringNumberFormatsWithOptions[m_nextToLocaleStringNumberFormatWithOptions].set(vm, this, numberFormat);
+    m_nextToLocaleStringNumberFormatWithOptions = (m_nextToLocaleStringNumberFormatWithOptions + 1) % m_toLocaleStringNumberFormatsWithOptions.size();
     return numberFormat;
 }
 
