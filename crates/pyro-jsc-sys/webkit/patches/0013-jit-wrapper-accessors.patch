+/* A custom accessor (as above) whose getter the JITs also call directly, as a
+   DOM attribute: the property carries the class of C API wrapper objects, so
+   every tier first proves the receiver is one (another receiver gets a
+   TypeError from the generic path, as a DOM attribute would), and then the
+   baseline, DFG and FTL inline caches and the DFG/FTL CallDOMGetter call
+   `fastGetter` with the receiver and its private data instead of `getter` with
+   an encoded this-value and property name. `getter` still serves the
+   interpreter, reified getter functions, super and with-this reads. The
+   callback may throw with JSContextThrowException (and return NULL or any
+   value). `resultType` says what the getter returns, as a promise the compiler
+   relies on (JSFastGetterResult*): say Any unless every result fits.
+   `readsOnly`: the getter changes nothing script can observe and runs no
+   script, so compiled code may reuse a result while nothing has been written
+   in between. `context` is passed back to `fastGetter`. */
+typedef JSValueRef (*JSFastGetterCallback)(JSContextRef ctx, JSObjectRef thisObject, void* privateData, void* context);
+enum {
+    kJSFastGetterResultAny = 0,
+    kJSFastGetterResultNumber = 1,
+    kJSFastGetterResultBoolean = 2,
+    kJSFastGetterResultString = 3,
+    kJSFastGetterResultObjectOrNull = 4
+};
+JS_EXPORT bool JSObjectSetFastGetter(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSCustomGetterCallback getter, JSCustomSetterCallback setter, JSPropertyAttributes attributes, JSFastGetterCallback fastGetter, void* context, int resultType, bool readsOnly);
