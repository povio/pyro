+// Pyro: the inline caches' `wrapper[i]` (AccessCase::IndexedCallbackObjectLoad): the
+// class chain's indexed getter, then the generic get for an index it does not answer.
+JSC_DECLARE_JIT_OPERATION(operationGetByValCallbackObject, EncodedJSValue, (JSGlobalObject*, EncodedJSValue, EncodedJSValue));
+JSC_DEFINE_JIT_OPERATION(operationGetByValCallbackObject, EncodedJSValue, (JSGlobalObject* globalObject, EncodedJSValue encodedBase, EncodedJSValue encodedProperty))
+{
+    VM& vm = globalObject->vm();
+    CallFrame* callFrame = DECLARE_CALL_FRAME(vm);
+    JITOperationPrologueCallFrameTracer tracer(vm, callFrame);
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    JSValue baseValue = JSValue::decode(encodedBase);
+    JSValue property = JSValue::decode(encodedProperty);
+    auto* object = static_cast<JSCallbackObject<JSNonFinalObject>*>(baseValue.asCell());
+    if (property.isInt32() && property.asInt32() >= 0) {
+        unsigned index = static_cast<unsigned>(property.asInt32());
+        PropertySlot slot(baseValue, PropertySlot::InternalMethodType::Get);
+        bool handled = false;
+        if (object->tryIndexedGetter(globalObject, index, slot, handled)) {
+            OPERATION_RETURN_IF_EXCEPTION(scope, encodedJSValue());
+            OPERATION_RETURN(scope, JSValue::encode(slot.getValue(globalObject, index)));
+        }
+        OPERATION_RETURN_IF_EXCEPTION(scope, encodedJSValue());
+        OPERATION_RETURN(scope, JSValue::encode(baseValue.get(globalObject, index)));
+    }
+    auto propertyName = property.toPropertyKey(globalObject);
+    OPERATION_RETURN_IF_EXCEPTION(scope, encodedJSValue());
+    OPERATION_RETURN(scope, JSValue::encode(baseValue.get(globalObject, propertyName)));
+}
+
 } // namespace JSC
