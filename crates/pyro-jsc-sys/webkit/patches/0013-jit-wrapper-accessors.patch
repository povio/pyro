+namespace JSC {
+
+// A fast getter installed through the C API: the DOMJIT::GetterSetter the
+// inline caches and the DFG hold a pointer to (immortal: compiled code keeps
+// pointing at it), plus the C callback the snippet's slow path calls. One per
+// distinct (getter, fastGetter, context, resultType, readsOnly), shared by
+// every VM in the process, so equal attributes merge in the DFG.
+struct APIFastGetter final : public DOMJIT::GetterSetter {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(APIFastGetter);
+public:
+#if ENABLE(JIT)
+    static Ref<DOMJIT::CallDOMGetterSnippet> compile(const DOMJIT::GetterSetter&);
+#endif
+    APIFastGetter(DOMJIT::GetterSetter::CustomGetter getter, JSFastGetterCallback fast, void* context, SpeculatedType resultType, bool readsOnly)
+        : DOMJIT::GetterSetter(getter,
+#if ENABLE(JIT)
+            &APIFastGetter::compile,
+#else
+            static_cast<SnippetCompilerWithContext>(nullptr),
+#endif
+            resultType, this)
+        , fast(fast)
+        , fastContext(context)
+        , readsOnly(readsOnly)
+    {
+    }
+
+    JSFastGetterCallback fast;
+    void* fastContext;
+    bool readsOnly;
+};
+
+static Lock apiFastGettersLock;
+static Vector<std::unique_ptr<APIFastGetter>>& apiFastGetters() WTF_REQUIRES_LOCK(apiFastGettersLock)
+{
+    static NeverDestroyed<Vector<std::unique_ptr<APIFastGetter>>> getters;
+    return getters.get();
+}
+
+static const APIFastGetter* internAPIFastGetter(DOMJIT::GetterSetter::CustomGetter getter, JSFastGetterCallback fast, void* context, SpeculatedType resultType, bool readsOnly)
+{
+    Locker locker { apiFastGettersLock };
+    auto& getters = apiFastGetters();
+    for (auto& g : getters) {
+        if (g->getter() == getter && g->fast == fast && g->fastContext == context && g->resultType() == resultType && g->readsOnly == readsOnly)
+            return g.get();
+    }
+    getters.append(makeUnique<APIFastGetter>(getter, fast, context, resultType, readsOnly));
+    return getters.last().get();
+}
+
+JSC_DECLARE_JIT_OPERATION(operationAPIFastGetter, EncodedJSValue, (JSGlobalObject*, void*, void*));
+JSC_DEFINE_JIT_OPERATION(operationAPIFastGetter, EncodedJSValue, (JSGlobalObject* globalObject, void* cell, void* getter))
+{
+    VM& vm = globalObject->vm();
+    CallFrame* callFrame = DECLARE_CALL_FRAME(vm);
+    JITOperationPrologueCallFrameTracer tracer(vm, callFrame);
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    // The compiled code proved the receiver's class (the annotation's classInfo).
+    auto* object = static_cast<JSCallbackObject<JSNonFinalObject>*>(cell);
+    auto* g = static_cast<const APIFastGetter*>(getter);
+    JSValueRef result = g->fast(toRef(globalObject), toRef(object), object->getPrivate(), g->fastContext);
+    OPERATION_RETURN(scope, result ? JSValue::encode(toJS(globalObject, result)) : JSValue::encode(jsUndefined()));
+}
+
+#if ENABLE(JIT)
+Ref<DOMJIT::CallDOMGetterSnippet> APIFastGetter::compile(const DOMJIT::GetterSetter& gs)
+{
+    auto* g = static_cast<const APIFastGetter*>(gs.context());
+    Ref<DOMJIT::CallDOMGetterSnippet> snippet = DOMJIT::CallDOMGetterSnippet::create();
+    snippet->requireGlobalObject = true;
+    snippet->numGPScratchRegisters = 1;
+    if (g->readsOnly)
+        snippet->effect = DOMJIT::Effect::forRead(DOMJIT::HeapRange::top());
+    snippet->setGenerator([=] (CCallHelpers& jit, SnippetParams& params) {
+        GPRReg result = params[0].gpr();
+        GPRReg base = params[1].gpr();
+        GPRReg globalObject = params[2].gpr();
+        GPRReg getter = params.gpScratch(0);
+        jit.move(CCallHelpers::TrustedImmPtr(g), getter);
+        params.addSlowPathCall(jit.jump(), jit, operationAPIFastGetter, result, globalObject, base, getter);
+        return CCallHelpers::JumpList();
+    });
+    return snippet;
+}
+#endif
+
+} // namespace JSC
+
+bool JSObjectSetFastGetter(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSCustomGetterCallback getter, JSCustomSetterCallback setter, JSPropertyAttributes attributes, JSFastGetterCallback fastGetter, void* context, int resultType, bool readsOnly)
+{
+    if (!ctx || !object || !propertyName || !getter || !fastGetter)
+        return false;
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    JSObject* jsObject = toJS(object);
+    Identifier name = propertyName->identifier(&vm);
+    if (parseIndex(name))
+        return false;
+    unsigned attrs = static_cast<unsigned>(PropertyAttribute::CustomAccessor);
+    if (attributes & kJSPropertyAttributeDontEnum)
+        attrs |= static_cast<unsigned>(PropertyAttribute::DontEnum);
+    if (attributes & kJSPropertyAttributeDontDelete)
+        attrs |= static_cast<unsigned>(PropertyAttribute::DontDelete);
+    if (!setter)
+        attrs |= static_cast<unsigned>(PropertyAttribute::ReadOnly);
+    SpeculatedType spec;
+    switch (resultType) {
+    case kJSFastGetterResultNumber: spec = SpecBytecodeNumber; break;
+    case kJSFastGetterResultBoolean: spec = SpecBoolean; break;
+    case kJSFastGetterResultString: spec = SpecString; break;
+    case kJSFastGetterResultObjectOrNull: spec = SpecObject | SpecOther; break;
+    default: spec = SpecBytecodeTop; break;
+    }
+    auto rawGetter = reinterpret_cast<EncodedJSValue (*)(JSGlobalObject*, EncodedJSValue, PropertyName)>(getter);
+    GetValueFunc getValue(rawGetter);
+    PutValueFunc putValue = setter ? PutValueFunc(reinterpret_cast<bool (*)(JSGlobalObject*, EncodedJSValue, EncodedJSValue, PropertyName)>(setter)) : PutValueFunc(nullptr);
+    const APIFastGetter* domJIT = internAPIFastGetter(rawGetter, fastGetter, context, spec, readsOnly);
+    auto* accessor = DOMAttributeGetterSetter::create(vm, getValue, putValue, DOMAttributeAnnotation { JSCallbackObject<JSNonFinalObject>::info(), domJIT });
+    return jsObject->putDirectCustomAccessor(vm, name, accessor, attrs);
+}
