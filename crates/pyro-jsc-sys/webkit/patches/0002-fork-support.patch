+/* Defined everywhere; only Darwin's scavenger suspends threads and reads is_orphaned. */
+void pas_thread_local_cache_did_fork_in_child(void)
+{
+    pas_thread_local_cache_node* node;
+
+    pas_heap_lock_lock();
+    for (node = pas_thread_local_cache_node_first; node; node = node->next) {
+        if (node->cache && node->cache->thread != pthread_self())
+            node->cache->is_orphaned = true;
+    }
+    pas_heap_lock_unlock();
+}
