+// Pyro: ICU 78 (CLDR 48) joins a date and a time with the "atTime" pattern of the
+// date's length, which for a medium or short date now carries a word in some locales:
+// "Oct 1 at 2:00 PM" in English, "à" in French, "o" in Polish, "во" in Macedonian.
+// ICU 77 and earlier, which Chromium ships, joined them with the standard pattern:
+// "Oct 1, 2:00 PM". Where the atTime pattern of a medium or short Gregorian date quotes
+// a literal and the standard one is not a bare `{1} {0}`, the standard one joins them.
+// (Where CLDR 48 moved the word out of the standard pattern into the atTime one, as
+// Finnish "klo", it left the standard one bare, and ICU 77 joined with the word: that
+// stays.) Elsewhere, and with an earlier ICU, nothing changes.
+static bool joinsWithAtTimePatterns()
+{
+    static const bool result = [] {
+        UVersionInfo version;
+        u_getVersion(version);
+        return version[0] >= 78;
+    }();
+    return result;
+}
+
+// The joining pattern of a date of `style` in the Gregorian calendar of the ICU locale ID
+// `locale` (without keywords), from it or its nearest parent that has one: the standard
+// pattern (`DateTimePatterns`, at 9 + style) or the atTime one (`DateTimePatterns%atTime`).
+static Vector<char16_t, 32> joiningPattern(const char* locale, UDateFormatStyle style, bool atTime)
+{
+    std::array<char, ULOC_FULLNAME_CAPACITY> current { };
+    memcpy(current.data(), locale, std::min(strlen(locale), current.size() - 1));
+    for (unsigned depth = 0; depth < 8; ++depth) {
+        UErrorCode status = U_ZERO_ERROR;
+        auto bundle = std::unique_ptr<UResourceBundle, ICUDeleter<ures_close>>(ures_open(nullptr, current[0] ? current.data() : "root", &status));
+        auto calendar = std::unique_ptr<UResourceBundle, ICUDeleter<ures_close>>(ures_getByKey(bundle.get(), "calendar", nullptr, &status));
+        auto gregorian = std::unique_ptr<UResourceBundle, ICUDeleter<ures_close>>(ures_getByKey(calendar.get(), "gregorian", nullptr, &status));
+        auto patterns = std::unique_ptr<UResourceBundle, ICUDeleter<ures_close>>(ures_getByKey(gregorian.get(), atTime ? "DateTimePatterns%atTime" : "DateTimePatterns", nullptr, &status));
+        if (U_SUCCESS(status)) {
+            int32_t size = ures_getSize(patterns.get());
+            int32_t index = atTime ? style : (size >= 13 ? 9 + style : 8);
+            int32_t length = 0;
+            const char16_t* data = ures_getStringByIndex(patterns.get(), index, &length, &status);
+            if (U_SUCCESS(status) && length > 0)
+                return Vector<char16_t, 32>(std::span { data, static_cast<size_t>(length) });
+        }
+        if (!current[0])
+            break;
+        std::array<char, ULOC_FULLNAME_CAPACITY> parent { };
+        UErrorCode parentStatus = U_ZERO_ERROR;
+        uloc_getParent(current.data(), parent.data(), parent.size(), &parentStatus);
+        if (U_FAILURE(parentStatus) || !strcmp(parent.data(), current.data()))
+            break;
+        current = parent;
+    }
+    return { };
+}
+
+Vector<char16_t, 32> dateTimeJoiningPatternBeforeCLDR48(const char* locale, UDateFormatStyle style)
+{
+    if (!joinsWithAtTimePatterns() || (style != UDAT_MEDIUM && style != UDAT_SHORT))
+        return { };
+    std::array<char, ULOC_FULLNAME_CAPACITY> icuLocale { };
+    UErrorCode status = U_ZERO_ERROR;
+    uloc_forLanguageTag(locale, icuLocale.data(), icuLocale.size(), nullptr, &status);
+    if (U_FAILURE(status) || !icuLocale[0])
+        return { };
+    std::array<char, ULOC_KEYWORDS_CAPACITY> calendar { };
+    status = U_ZERO_ERROR;
+    int32_t calendarLength = uloc_getKeywordValue(icuLocale.data(), "calendar", calendar.data(), calendar.size(), &status);
+    if (U_FAILURE(status) || (calendarLength > 0 && strcmp(calendar.data(), "gregorian")))
+        return { };
+    std::array<char, ULOC_FULLNAME_CAPACITY> base { };
+    status = U_ZERO_ERROR;
+    uloc_getBaseName(icuLocale.data(), base.data(), base.size(), &status);
+    if (U_FAILURE(status))
+        return { };
+    if (!joiningPattern(base.data(), style, true).contains('\''))
+        return { };
+    auto standard = joiningPattern(base.data(), style, false);
+    static constexpr char16_t bare[] = u"{1} {0}";
+    if (standard.span().size() == std::size(bare) - 1 && std::equal(standard.begin(), standard.end(), bare))
+        return { };
+    return standard;
+}
+
 UDateTimePatternGenerator* IntlCache::cacheSharedPatternGenerator(const ASCIICString& locale, UErrorCode& status)
 {
     auto generator = std::unique_ptr<UDateTimePatternGenerator, ICUDeleter<udatpg_close>>(udatpg_open(locale.data(), &status));
     if (U_FAILURE(status))
         return nullptr;
+    for (auto style : { UDAT_MEDIUM, UDAT_SHORT }) {
+        auto pattern = dateTimeJoiningPatternBeforeCLDR48(locale.data(), style);
+        if (pattern.isEmpty())
+            continue;
+        UErrorCode setStatus = U_ZERO_ERROR;
+        udatpg_setDateTimeFormatForStyle(generator.get(), style, pattern.span().data(), pattern.size(), &setStatus);
+    }
     m_cachedDateTimePatternGeneratorLocale = locale;
     m_cachedDateTimePatternGenerator = WTF::move(generator);
     return m_cachedDateTimePatternGenerator.get();
