+} // namespace JSC
+
+#if !JSC_OBJC_API_ENABLED
+
+using namespace JSC;
+
+bool JSGlobalContextSetModuleLoader(JSGlobalContextRef ctx, JSModuleLoaderFetchCallback callback, void* info)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject)
+        return false;
+    apiGlobalObject->setModuleLoader(reinterpret_cast<void*>(callback), info);
+    return true;
+}
+
+JSValueRef JSModuleSourceCreate(JSContextRef ctx, JSStringRef source, JSStringRef url, JSValueRef* exception)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    String urlString = url->string();
+    URL sourceURL { { }, urlString };
+    if (!sourceURL.isValid()) {
+        if (exception)
+            *exception = toRef(globalObject, createTypeError(globalObject, "invalid module URL"_s));
+        return nullptr;
+    }
+    auto sourceCode = makeSource(source->string(), SourceOrigin { sourceURL }, SourceTaintedOrigin::Untainted, urlString, TextPosition(), SourceProviderSourceType::Module);
+    return toRef(globalObject, JSSourceCode::create(vm, WTF::move(sourceCode)));
 }
+
+JSObjectRef JSLoadAndEvaluateModule(JSContextRef ctx, JSStringRef url, JSValueRef* exception)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject) {
+        if (exception)
+            *exception = toRef(globalObject, createError(globalObject, "Context does not support module loading"_s));
+        return nullptr;
+    }
+
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(vm);
+    JSValue result = apiGlobalObject->loadAndEvaluateModule(locker, url->string());
+    if (scope.exception()) {
+        JSValue reason = scope.exception()->value();
+        scope.clearException();
+        auto* promise = JSPromise::create(vm, globalObject->promiseStructure());
+        promise->reject(vm, reason);
+        return toRef(promise);
+    }
+    return toRef(asObject(result));
+}
+
+#endif
