+// The module hooks below follow JSAPIGlobalObject.mm, with the delegate replaced
+// by a C callback (JSModuleLoaderRefPrivate.h).
+
+static std::expected<URL, String> computeValidImportSpecifier(const URL& base, const String& specifier)
+{
+    URL absoluteURL(specifier);
+    if (absoluteURL.isValid())
+        return absoluteURL;
+
+    if (!specifier.startsWith('/') && !specifier.startsWith("./"_s) && !specifier.startsWith("../"_s))
+        return makeUnexpected(makeString("Module specifier: "_s, specifier, " does not start with \"/\", \"./\", or \"../\". Referenced from: "_s, base.string()));
+
+    if (specifier.startsWith('/')) {
+        absoluteURL = URL(URL("file://"_s), specifier);
+        if (absoluteURL.isValid())
+            return absoluteURL;
+    }
+
+    if (base == URL())
+        return makeUnexpected("Could not determine the base URL for loading."_s);
+
+    if (!base.isValid())
+        return makeUnexpected(makeString("Referrering script's url is not valid: "_s, base.string()));
+
+    absoluteURL = URL(base, specifier);
+    if (absoluteURL.isValid())
+        return absoluteURL;
+    return makeUnexpected(makeString("Could not form valid URL from identifier and base. Tried:"_s, absoluteURL.string()));
+}
+
+Identifier JSAPIGlobalObject::moduleLoaderResolve(JSGlobalObject* globalObject, JSModuleLoader*, JSValue key, JSValue referrer, RefPtr<ScriptFetcher>, bool)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    String name = key.toWTFString(globalObject);
+    RETURN_IF_EXCEPTION(scope, { });
+
+    URL base;
+    if (JSString* referrerString = dynamicDowncast<JSString>(referrer)) {
+        String value = referrerString->value(globalObject);
+        RETURN_IF_EXCEPTION(scope, { });
+        base = URL { { }, value };
+    }
+
+    auto result = computeValidImportSpecifier(base, name);
+    if (result)
+        return Identifier::fromString(vm, result.value().string());
+
+    throwVMError(globalObject, scope, createError(globalObject, result.error()));
+    return { };
+}
+
+JSPromise* JSAPIGlobalObject::moduleLoaderImportModule(JSGlobalObject* globalObject, JSModuleLoader*, JSString* specifierValue, RefPtr<ScriptFetchParameters> fetchParams, const SourceOrigin& sourceOrigin, bool deferred)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto reject = [&] (ThrowScope& scope) -> JSPromise* {
+        auto* promise = JSPromise::create(vm, globalObject->promiseStructure());
+        return promise->rejectWithCaughtException(vm, scope);
+    };
+
+    auto specifier = specifierValue->value(globalObject);
+    RETURN_IF_EXCEPTION(scope, reject(scope));
+
+    Identifier originURL;
+    if (const String& originString = sourceOrigin.string(); !originString.isNull())
+        originURL = Identifier::fromString(vm, originString);
+    auto result = importModule(globalObject, Identifier::fromString(vm, specifier), originURL, WTF::move(fetchParams), nullptr, deferred);
+    RETURN_IF_EXCEPTION(scope, reject(scope));
+    return result;
+}
+
+JSPromise* JSAPIGlobalObject::moduleLoaderFetch(JSGlobalObject* globalObject, JSModuleLoader*, JSValue key, const String&, RefPtr<ScriptFetchParameters>, RefPtr<ScriptFetcher>)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto* thisObject = uncheckedDowncast<JSAPIGlobalObject>(globalObject);
+
+    JSPromise* promise = JSPromise::create(vm, globalObject->promiseStructure());
+
+    Identifier moduleKey = key.toPropertyKey(globalObject);
+    RETURN_IF_EXCEPTION(scope, promise->rejectWithCaughtException(vm, scope));
+
+    auto callback = reinterpret_cast<JSModuleLoaderFetchCallback>(thisObject->m_moduleLoaderCallback);
+    if (!callback) [[unlikely]] {
+        scope.release();
+        promise->reject(vm, createError(globalObject, "No module loader provided."_s));
+        return promise;
+    }
+
+    auto* resolve = JSNativeStdFunction::create(vm, globalObject, 1, "resolve"_s, [promise, moduleKey] (JSGlobalObject* globalObject, CallFrame* callFrame) {
+        VM& vm = globalObject->vm();
+        auto* source = dynamicDowncast<JSSourceCode>(callFrame->argument(0));
+        if (!source || source->sourceCode().provider()->sourceType() != SourceProviderSourceType::Module) [[unlikely]] {
+            promise->reject(vm, createTypeError(globalObject, "First argument of resolution callback is not a module source"_s));
+            return encodedJSUndefined();
+        }
+        const String& sourceURL = source->sourceCode().provider()->sourceURL();
+        if (Identifier::fromString(vm, sourceURL) != moduleKey) [[unlikely]] {
+            promise->reject(vm, createTypeError(globalObject, makeString("The same module source was provided for two different identifiers, previously: "_s, sourceURL, " and now: "_s, moduleKey.string())));
+            return encodedJSUndefined();
+        }
+        promise->resolve(globalObject, vm, source);
+        return encodedJSUndefined();
+    }, promise);
+
+    auto* reject = JSNativeStdFunction::create(vm, globalObject, 1, "reject"_s, [promise] (JSGlobalObject* globalObject, CallFrame* callFrame) {
+        promise->reject(globalObject->vm(), callFrame->argument(0));
+        return encodedJSUndefined();
+    }, promise);
+
+    auto identifier = OpaqueJSString::tryCreate(moduleKey.string());
+    callback(toGlobalRef(globalObject), identifier.get(), toRef(resolve), toRef(reject), thisObject->m_moduleLoaderInfo);
+    return promise;
+}
+
+JSObject* JSAPIGlobalObject::moduleLoaderCreateImportMetaProperties(JSGlobalObject* globalObject, JSModuleLoader*, JSValue key, JSModuleRecord*, RefPtr<ScriptFetcher>)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    JSObject* metaProperties = constructEmptyObject(vm, globalObject->nullPrototypeObjectStructure());
+    RETURN_IF_EXCEPTION(scope, nullptr);
+
+    metaProperties->putDirect(vm, Identifier::fromString(vm, "filename"_s), key);
+    RETURN_IF_EXCEPTION(scope, nullptr);
+
+    metaProperties->putDirect(vm, Identifier::fromString(vm, "url"_s), key);
+    RETURN_IF_EXCEPTION(scope, nullptr);
+
+    return metaProperties;
+}
+
+JSValue JSAPIGlobalObject::loadAndEvaluateModule(const JSLockHolder&, const String& url)
+{
+    VM& vm = this->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    JSPromise* promise = importModule(this, Identifier::fromString(vm, url), { }, nullptr, nullptr);
+    RETURN_IF_EXCEPTION(scope, { });
+    auto* result = JSPromise::create(vm, this->promiseStructure());
+    result->resolve(this, vm, promise);
+    RETURN_IF_EXCEPTION(scope, { });
+    return result;
+}
+
 #endif
 
