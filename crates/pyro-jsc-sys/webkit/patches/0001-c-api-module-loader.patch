diff --git a/Source/JavaScriptCore/API/JSModuleLoaderRefPrivate.h b/Source/JavaScriptCore/API/JSModuleLoaderRefPrivate.h
new file mode 100644
index 00000000..ed0d0441
--- /dev/null
+++ b/Source/JavaScriptCore/API/JSModuleLoaderRefPrivate.h
@@ -0,0 +1,40 @@
+/*
+ * Pyro: ES module loading for the C API on ports without the
+ * Objective-C API (JSCOnly). Mirrors JSContext.moduleLoaderDelegate and
+ * JSScript's module type, with C types. Only contexts created with
+ * JSGlobalContextCreateInGroup(group, NULL) (JSAPIGlobalObject) support it.
+ */
+
+#ifndef JSModuleLoaderRefPrivate_h
+#define JSModuleLoaderRefPrivate_h
+
+#include <JavaScriptCore/JSBase.h>
+#include <JavaScriptCore/JSValueRef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Called for every module the loader needs, with its resolved URL. Call
+   `resolve` with a value from JSModuleSourceCreate (for that same URL) or
+   `reject` with an error, now or later; both are protected until called only
+   if the embedder protects them. */
+typedef void (*JSModuleLoaderFetchCallback)(JSGlobalContextRef ctx, JSStringRef identifier, JSObjectRef resolve, JSObjectRef reject, void* info);
+
+/* Installs (or, with a NULL callback, removes) the fetch callback. Returns false
+   when the context does not support module loading. */
+JS_EXPORT bool JSGlobalContextSetModuleLoader(JSGlobalContextRef ctx, JSModuleLoaderFetchCallback callback, void* info);
+
+/* Creates the module source value passed to a fetch `resolve` function. */
+JS_EXPORT JSValueRef JSModuleSourceCreate(JSContextRef ctx, JSStringRef source, JSStringRef url, JSValueRef* exception);
+
+/* Loads `url` through the fetch callback and evaluates it. Returns a promise for
+   the evaluation, or NULL (with *exception set) when the context does not
+   support module loading. */
+JS_EXPORT JSObjectRef JSLoadAndEvaluateModule(JSContextRef ctx, JSStringRef url, JSValueRef* exception);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* JSModuleLoaderRefPrivate_h */
