+void JSGlobalContextSetGlobalProxyRefusesPreventExtensions(JSGlobalContextRef ctx)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    if (auto* proxy = dynamicDowncast<JSGlobalProxy>(globalObject->globalThis()))
+        proxy->setRefusesPreventExtensions();
+}
