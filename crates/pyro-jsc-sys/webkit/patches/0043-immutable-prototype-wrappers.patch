 }
 
+// Pyro patch 0043: a wrapper of a kJSClassAttributeImmutablePrototype class keeps its prototype
+// (SetImmutablePrototype) and stays extensible; any other keeps the ordinary internal methods.
+template <class Parent>
+bool JSCallbackObject<Parent>::setPrototype(JSObject* object, JSGlobalObject* globalObject, JSValue prototype, bool shouldThrowIfCantSet)
+{
+    auto* thisObject = uncheckedDowncast<JSCallbackObject>(object);
+    if (!thisObject->classRef()->immutablePrototype)
+        return Parent::setPrototype(object, globalObject, prototype, shouldThrowIfCantSet);
+    VM& vm = getVM(globalObject);
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    if (thisObject->getPrototypeDirect() == prototype)
+        return true;
+    return typeError(globalObject, scope, shouldThrowIfCantSet, "Cannot set prototype of immutable prototype object"_s);
+}
+
+template <class Parent>
+bool JSCallbackObject<Parent>::preventExtensions(JSObject* object, JSGlobalObject* globalObject)
+{
+    auto* thisObject = uncheckedDowncast<JSCallbackObject>(object);
+    if (!thisObject->classRef()->immutablePrototype)
+        return Parent::preventExtensions(object, globalObject);
+    return false;
+}
+
