@@ -291,6 +297,13 @@ JS_EXPORT const void* JSValueGetStringCharacters(JSContextRef ctx, JSValueRef va
    runs its context group. Releasing such a class while an object of it lives is an error. */
 #define kJSClassAttributeImmortal (1u << 29)
 
+/* Pyro patch 0043: a JSClassDefinition attribute for wrappers whose prototype script cannot
+   change and which refuse to become non-extensible (WebIDL's Location, HTML's cross-origin
+   Window and Location objects): [[SetPrototypeOf]] is SetImmutablePrototype (true only for the
+   current prototype; Object.setPrototypeOf throws otherwise) and [[PreventExtensions]] returns
+   false (Object.preventExtensions throws). JSObjectSetPrototype still sets their prototype. */
+#define kJSClassAttributeImmutablePrototype (1u << 28)
+
 /* Announces that a wrapper of a kJSClassAttributeImpureNamedProperties class may now answer
    `propertyName`: inline caches and compiled code that assumed otherwise are dropped. Cheap
    when nothing watches the name. May not run JavaScript; callable with the DOM borrowed. */
diff --git a/Source/JavaScriptCore/API/JSObjectRef.cpp b/Source/JavaScriptCore/API/JSObjectRef.cpp
index 2248b27a42..3229752037 100644
--- a/Source/JavaScriptCore/API/JSObjectRef.cpp
+++ b/Source/JavaScriptCore/API/JSObjectRef.cpp
@@ -333,6 +333,15 @@ void JSObjectSetPrototype(JSContextRef ctx, JSObjectRef object, JSValueRef value
 
     JSObject* jsObject = toJS(object);
     JSValue jsValue = toJS(globalObject, value);
+    // Pyro patch 0043: the embedder sets the prototype of a kJSClassAttributeImmutablePrototype
+    // wrapper, which script cannot.
+    JSClassRef jsClass = nullptr;
+    if (auto* callbackObject = dynamicDowncast<JSCallbackObject<JSNonFinalObject>>(jsObject))
+        jsClass = callbackObject->classRef();
+    if (jsClass && jsClass->immutablePrototype) {
+        jsObject->setPrototypeDirect(vm, jsValue.isObject() ? jsValue : jsNull());
+        return;
+    }
     jsObject->setPrototype(vm, globalObject, jsValue.isObject() ? jsValue : jsNull());
     handleExceptionIfNeeded(scope, ctx, nullptr);
 }
