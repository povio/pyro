 JS_EXPORT void JSCompleteJITPlans(JSContextGroupRef group, bool wait);
 
+/* Pyro patch 0040: the deferred work of `group`'s VM (its DeferredWorkTimer), which settles
+   asynchronous work that finishes off the JavaScript thread: WebAssembly.compile, instantiate,
+   compileStreaming and instantiateStreaming promises, among others. JavaScriptCore runs it from
+   the VM's WTF run loop, which an embedder with an event loop of its own never runs.
+   `callback(info)` is called whenever such work is scheduled, from any thread (a compilation
+   thread included) and with JavaScriptCore locks held: it may only wake the embedder's loop, which
+   then calls JSContextGroupRunDeferredWork on the VM's thread between tasks. A later call
+   replaces the callback; NULL removes it. */
+typedef void (*JSDeferredWorkCallback)(void* info);
+JS_EXPORT void JSContextGroupSetDeferredWorkCallback(JSContextGroupRef group, JSDeferredWorkCallback callback, void* info);
+
+/* Runs `group`'s deferred work that is ready (draining microtasks after each item), with no
+   JavaScript of this thread on the stack. Returns whether work is still pending. */
+JS_EXPORT bool JSContextGroupRunDeferredWork(JSContextGroupRef group);
