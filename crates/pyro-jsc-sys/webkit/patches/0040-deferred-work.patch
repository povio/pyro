Pyro patch 0040: the embedder runs a VM's deferred work (WebAssembly promises).

JavaScriptCore settles work that finishes off the JavaScript thread (WebAssembly.compile, instantiate,
compileStreaming, instantiateStreaming) through the VM's DeferredWorkTimer, a JSRunLoopTimer that fires
on the VM's WTF run loop. The JSCOnly build's generic run loop runs only when someone calls RunLoop::run
or cycle; an embedder with its own event loop never does, so those promises never settled.
JSContextGroupSetDeferredWorkCallback (JSForkPrivate.h) tells the embedder, through the timer's
existing set-notification, whenever deferred work is scheduled (from any thread), and
JSContextGroupRunDeferredWork runs the ready work on the VM's thread under the API lock
(DeferredWorkTimer::doWork, which drains microtasks after each item). Nothing changes for an embedder
that registers no callback.

diff --git a/Source/JavaScriptCore/API/JSFork.cpp b/Source/JavaScriptCore/API/JSFork.cpp
--- a/Source/JavaScriptCore/API/JSFork.cpp
+++ b/Source/JavaScriptCore/API/JSFork.cpp
@@ -24,6 +24,7 @@
 #include <wtf/HashMap.h>
 #include <wtf/Lock.h>
 #include <wtf/NeverDestroyed.h>
+#include "DeferredWorkTimer.h"
 #include "DeleteAllCodeEffort.h"
 #include "InitializeThreading.h"
 #include "IntlObject.h"
@@ -122,6 +123,33 @@ void JSCompleteJITPlans(JSContextGroupRef group, bool wait)
 #endif
 }
 
+void JSContextGroupSetDeferredWorkCallback(JSContextGroupRef group, JSDeferredWorkCallback callback, void* info)
+{
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+    // One notification per VM, so that a later call replaces it.
+    static Lock lock;
+    static NeverDestroyed<HashMap<VM*, JSRunLoopTimer::TimerNotificationCallback>> notifications;
+    Locker notificationsLocker { lock };
+    if (auto previous = notifications->take(&vm))
+        vm.deferredWorkTimer->removeTimerSetNotification(previous);
+    if (!callback)
+        return;
+    JSRunLoopTimer::TimerNotificationCallback notification = createSharedTask<JSRunLoopTimer::TimerNotificationType>([callback, info] {
+        callback(info);
+    });
+    vm.deferredWorkTimer->addTimerSetNotification(notification);
+    notifications->add(&vm, WTF::move(notification));
+}
+
+bool JSContextGroupRunDeferredWork(JSContextGroupRef group)
+{
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+    vm.deferredWorkTimer->doWork(vm);
+    return vm.deferredWorkTimer->hasAnyPendingWork();
+}
