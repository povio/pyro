@@ -44,6 +45,19 @@
    realms; with no other thread running JavaScript in `group`. */
 JS_EXPORT void JSCompleteJITPlans(JSContextGroupRef group, bool wait);
 
+/* Whether a name, in Latin-1 or UTF-16 code units, may be a named property of the
+   global of `ctx`. Runs on every lookup that misses the global: it must be cheap, and
+   must not call into JavaScriptCore. */
+typedef bool (*JSNamedPropertyFilter)(JSContextRef ctx, const void* characters, size_t length, bool is8Bit);
+
+/* Inserts a named properties object between the global object of `ctx` and
+   Object.prototype, which JavaScript and JSObjectSetPrototype cannot do (immutable
+   prototype exotic object). `getter` runs for names `filter` lets through, with `ctx`
+   the object's own global; it returns null for no such property. The callbacks are
+   process-wide. This replaces the global proxy, so call it on a new context, before
+   anything holds `globalThis`; JSContextGetGlobalObject returns the new proxy. */
+JS_EXPORT void JSGlobalContextInstallNamedProperties(JSGlobalContextRef ctx, JSNamedPropertyFilter filter, JSObjectGetPropertyCallback getter);
+
 #ifdef __cplusplus
 }
 #endif
