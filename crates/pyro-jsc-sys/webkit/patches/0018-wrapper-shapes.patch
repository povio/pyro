+struct OpaqueJSWrapperShape {
+    OpaqueJSWrapperShape(VM& vm, Structure* structure, JSClassRef jsClass)
+        : structure(vm, structure)
+        , jsClass(jsClass)
+    {
+    }
+
+    Strong<Structure> structure;
+    RefPtr<OpaqueJSClass> jsClass;
+};
+
+JSWrapperShapeRef JSWrapperShapeCreate(JSContextRef ctx, JSClassRef jsClass, JSObjectRef prototypeRef)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    // The structure JSObjectMake starts its objects with.
+    Structure* structure = globalObject->callbackObjectStructure();
+    if (Options::cacheCallbackObjectLookups()) {
+        if (jsClass->wrappersAreCacheable)
+            structure = globalObject->cacheableCallbackObjectStructure();
+        else if (jsClass->impureNamedProperties)
+            structure = globalObject->impureNamedCallbackObjectStructure();
+    }
+    // The transition JSObject::setPrototypeDirect makes for each of them.
+    JSObject* prototype = toJS(prototypeRef);
+    prototype->didBecomePrototype(vm);
+    if (structure->hasMonoProto()) {
+        DeferredStructureTransitionWatchpointFire deferred(vm, structure);
+        structure = Structure::changePrototypeTransition(vm, structure, prototype, deferred);
+    } else
+        return nullptr;
+    return new OpaqueJSWrapperShape(vm, structure, jsClass);
+}
+
+void JSWrapperShapeRelease(JSContextGroupRef contextGroup, JSWrapperShapeRef shape)
+{
+    VM* vm = toJS(contextGroup);
+    JSLockHolder locker(vm);
+    delete shape;
+}
+
+JSObjectRef JSObjectMakeWrapper(JSContextRef ctx, JSWrapperShapeRef shape, void* data, const unsigned char* keepAlive, JSWeakRef* weak)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    // A shape serves the global object that made it only: for another, the caller makes the
+    // wrapper the old way.
+    if (shape->structure->realm() != globalObject) [[unlikely]]
+        return nullptr;
+    // The object starts with the structure JSObject::setPrototypeDirect would move it to. The
+    // rest of setPrototypeDirect does nothing for a new object: it is no prototype yet (no
+    // structure chain to invalidate, no haveABadTime) and has no indexed storage (nothing to
+    // switch to slow-put storage).
+    JSCallbackObject<JSNonFinalObject>* object = JSCallbackObject<JSNonFinalObject>::create(globalObject, shape->structure.get(), shape->jsClass.get(), data);
+    if (keepAlive && weak)
+        *weak = new OpaqueJSWeak(object, &keptWhileOwner(), const_cast<unsigned char*>(keepAlive));
+    return toRef(object);
+}
