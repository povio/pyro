 JS_EXPORT JSWeakRef JSWeakCreateKeptWhile(JSContextGroupRef, JSObjectRef, const unsigned char* keepAlive);
 
+/* Pyro: the structure of new host wrappers of `jsClass` whose prototype is
+   `prototype` (an object), as JSObjectMake followed by JSObjectSetPrototype gives them: for a
+   host that makes many wrappers of one class with one prototype in one global object. Made
+   once; the wrappers made from it start with it instead of transitioning to it one by one.
+   Release it with JSWrapperShapeRelease before the context group goes away. */
+typedef struct OpaqueJSWrapperShape* JSWrapperShapeRef;
+JS_EXPORT JSWrapperShapeRef JSWrapperShapeCreate(JSContextRef ctx, JSClassRef jsClass, JSObjectRef prototype);
+JS_EXPORT void JSWrapperShapeRelease(JSContextGroupRef, JSWrapperShapeRef);
+
+/* Pyro: JSObjectMake, JSObjectSetPrototype and JSWeakCreateKeptWhile in one call
+   (one lock, no prototype chain walk: a new object has no cycle to check), for a new wrapper
+   with private data `data` in the global object of `ctx`, which made `shape`. When `keepAlive`
+   is not NULL, `*weak` receives a JSWeakCreateKeptWhile handle of the object. Returns NULL,
+   making nothing, when another global object made `shape`. */
+JS_EXPORT JSObjectRef JSObjectMakeWrapper(JSContextRef ctx, JSWrapperShapeRef shape, void* data, const unsigned char* keepAlive, JSWeakRef* weak);
+
 JS_EXPORT void JSWeakRetain(JSContextGroupRef, JSWeakRef);
 JS_EXPORT void JSWeakRelease(JSContextGroupRef, JSWeakRef);
+/* Pyro: JSWeakRelease of `count` handles under one lock. */
+JS_EXPORT void JSWeakReleaseMany(JSContextGroupRef, const JSWeakRef* weakRefs, size_t count);
 
 JS_EXPORT JSObjectRef JSWeakGetObject(JSWeakRef);
 
