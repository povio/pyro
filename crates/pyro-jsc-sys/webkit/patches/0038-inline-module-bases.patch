+bool JSGlobalContextSetInlineModuleBase(JSGlobalContextRef ctx, JSStringRef identifier, JSStringRef baseURL)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject || !identifier)
+        return false;
+    if (!baseURL) {
+        apiGlobalObject->removeInlineModuleBase(identifier->string());
+        return true;
+    }
+    // Registered even when it cannot be a base (about:blank): the identity
+    // still loads, and its specifiers resolve as a script without a URL does.
+    apiGlobalObject->setInlineModuleBase(identifier->string(), baseURL->string());
+    return true;
+}
+
 JSValueRef JSModuleSourceCreate(JSContextRef ctx, JSStringRef source, JSStringRef url, JSValueRef* exception)
 {
