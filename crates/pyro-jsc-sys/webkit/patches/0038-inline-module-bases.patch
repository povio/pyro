+/* Registers `identifier` as an inline module script's registry identity whose
+   specifiers resolve against `baseURL` (import maps included: its scope is
+   matched against `baseURL` as given, fragment and all). Loading `identifier`
+   as an entry point keeps it unresolved, so it need not be a URL; one that no
+   resolution can produce cannot collide with a fetched module. A NULL baseURL
+   removes the registration. A baseURL that cannot be a base (about:blank)
+   resolves as a script without a URL does. Returns false when the context
+   cannot load modules. */
+JS_EXPORT bool JSGlobalContextSetInlineModuleBase(JSGlobalContextRef ctx, JSStringRef identifier, JSStringRef baseURL);
+
 /* Creates the module source value passed to a fetch `resolve` function. */
 JS_EXPORT JSValueRef JSModuleSourceCreate(JSContextRef ctx, JSStringRef source, JSStringRef url, JSValueRef* exception);
 
