+// pyro: the key getUnlinkedGlobalCodeBlock makes for a module's code.
+static SourceCodeKey sourceCodeKeyForModule(const SourceCode& source, OptionSet<CodeGenerationMode> codeGenerationMode)
+{
+    return SourceCodeKey(
+        source, String(), SourceCodeType::ModuleType, StrictModeLexicallyScopedFeature, JSParserScriptMode::Module,
+        DerivedContextType::None, EvalContextType::None, false, codeGenerationMode,
+        std::nullopt);
+}
+
+// pyro: generateUnlinkedCodeBlockForFunctions for a precompiled module. A function that
+// does not compile is left to its first call, which reports the error, and does not stop the others.
+static void precompileFunctions(VM& vm, UnlinkedCodeBlock* unlinkedCodeBlock, const SourceCode& parentSource, OptionSet<CodeGenerationMode> codeGenerationMode, size_t& count)
+{
+    auto generate = [&](UnlinkedFunctionExecutable* unlinkedExecutable) {
+        CodeSpecializationKind kind = unlinkedExecutable->isClassConstructorFunction() ? CodeSpecializationKind::CodeForConstruct : CodeSpecializationKind::CodeForCall;
+        SourceCode source = unlinkedExecutable->linkedSourceCode(parentSource);
+        ParserError error;
+        UnlinkedFunctionCodeBlock* unlinkedFunctionCodeBlock = unlinkedExecutable->unlinkedCodeBlockFor(vm, source, kind, codeGenerationMode, error, unlinkedExecutable->parseMode());
+        if (!unlinkedFunctionCodeBlock)
+            return;
+        ++count;
+        precompileFunctions(vm, unlinkedFunctionCodeBlock, source, codeGenerationMode, count);
+    };
+
+    for (unsigned i = 0; i < unlinkedCodeBlock->numberOfFunctionDecls(); i++)
+        generate(unlinkedCodeBlock->functionDecl(i));
+    for (unsigned i = 0; i < unlinkedCodeBlock->numberOfFunctionExprs(); i++)
+        generate(unlinkedCodeBlock->functionExpr(i));
+}
+
+bool CodeCache::precompileModule(JSGlobalObject* globalObject, const SourceCode& source, bool functions)
+{
+    VM& vm = globalObject->vm();
+    if (!Options::useCodeCache())
+        return false;
+
+    OptionSet<CodeGenerationMode> codeGenerationMode = globalObject->defaultCodeGenerationMode();
+    SourceCodeKey key = sourceCodeKeyForModule(source, codeGenerationMode);
+    if (m_precompiledModules.contains(key))
+        return true;
+
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(vm);
+    auto module = makeUnique<PrecompiledModule>();
+    {
+        ParserError error;
+        std::unique_ptr<ModuleProgramNode> moduleProgramNode = parseRootNode<ModuleProgramNode>(
+            vm, source, ImplementationVisibility::Public, JSParserBuiltinMode::NotBuiltin,
+            StrictModeLexicallyScopedFeature, JSParserScriptMode::Module, SourceParseMode::ModuleAnalyzeMode, error);
+        if (!moduleProgramNode)
+            return false;
+
+        // The analyzer fills a record, as it does for a load. What it put there is what the
+        // record of a later load gets (JSModuleLoader::makeModule).
+        PrivateName privateName(PrivateName::Description, "PrecompiledModule"_s);
+        ModuleAnalyzer moduleAnalyzer(globalObject, Identifier::fromUid(privateName), source, moduleProgramNode->features());
+        if (scope.exception()) [[unlikely]] {
+            scope.clearException();
+            return false;
+        }
+        auto result = moduleAnalyzer.analyze(*moduleProgramNode);
+        if (!result)
+            return false;
+        JSModuleRecord* record = result.value();
+        module->requestedModules = record->requestedModules();
+        for (const auto& pair : record->importEntries())
+            module->importEntries.append(pair.value);
+        for (const auto& pair : record->exportEntries())
+            module->exportEntries.append(pair.value);
+        for (const auto& entry : record->starExportEntries())
+            module->starExportEntries.append(entry);
+        module->features = record->features();
+        module->hasTLA = record->hasTLA();
+    }
+
+    ParserError error;
+    bool isArrowFunctionContext = false;
+    UnlinkedModuleProgramCodeBlock* unlinkedCodeBlock = generateUnlinkedCodeBlockImpl<UnlinkedModuleProgramCodeBlock>(vm, source, StrictModeLexicallyScopedFeature, JSParserScriptMode::Module, codeGenerationMode, error, EvalContextType::None, DerivedContextType::None, isArrowFunctionContext);
+    if (!unlinkedCodeBlock)
+        return false;
+    module->code.set(vm, unlinkedCodeBlock);
+
+    size_t count = 0;
+    if (functions)
+        precompileFunctions(vm, unlinkedCodeBlock, source, codeGenerationMode, count);
+
+    m_modulePrecompileStats.functions += count;
+    m_modulePrecompileStats.characters += source.length();
+    m_precompiledModules.add(key, WTF::move(module));
+    return true;
+}
+
+const PrecompiledModule* CodeCache::findPrecompiledModule(JSGlobalObject* globalObject, const SourceCode& source)
+{
+    if (m_precompiledModules.isEmpty() || !Options::useCodeCache())
+        return nullptr;
+
+    auto iterator = m_precompiledModules.find(sourceCodeKeyForModule(source, globalObject->defaultCodeGenerationMode()));
+    if (iterator == m_precompiledModules.end()) {
+        ++m_modulePrecompileStats.recordMisses;
+        return nullptr;
+    }
+    ++m_modulePrecompileStats.recordHits;
+    return iterator->value.get();
+}
