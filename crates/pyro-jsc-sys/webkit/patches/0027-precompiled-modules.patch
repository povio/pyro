+bool JSModuleSourcePrecompile(JSContextRef ctx, JSStringRef source, JSStringRef url, bool functions)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    // The source JSModuleSourceCreateWithType makes for the same arguments.
+    String urlString = url->string();
+    URL sourceURL { { }, urlString };
+    if (!sourceURL.isValid())
+        return false;
+    auto sourceCode = makeSource(source->string(), SourceOrigin { sourceURL }, SourceTaintedOrigin::Untainted, urlString, TextPosition(), SourceProviderSourceType::Module);
+    return vm.codeCache()->precompileModule(globalObject, sourceCode, functions);
+}
+
+void JSContextGroupGetModulePrecompileStats(JSContextGroupRef group, JSModulePrecompileStats* stats)
+{
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+
+    CodeCache* codeCache = vm.codeCache();
+    const ModulePrecompileStats& counters = codeCache->modulePrecompileStats();
+    stats->precompiledModules = codeCache->numberOfPrecompiledModules();
+    stats->precompiledFunctions = counters.functions;
+    stats->precompiledCharacters = counters.characters;
+    stats->moduleRecordHits = counters.recordHits;
+    stats->moduleRecordMisses = counters.recordMisses;
+    stats->moduleCodeHits = counters.codeHits;
+    stats->functionCompiles = counters.functionCompiles;
+}
