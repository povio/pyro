+/* Parses a JavaScript module's source and compiles its code ahead of its first
+   load, with the code of every function in it when `functions`, and keeps the
+   result for as long as the context's group lives. A module source made later
+   with the same text and a URL of the same host, in any context of the group,
+   then loads without being parsed or compiled, and so does every load in a
+   process forked from this one. Nothing of the module runs. Returns false,
+   keeping nothing, for a source that does not parse. */
+JS_EXPORT bool JSModuleSourcePrecompile(JSContextRef ctx, JSStringRef source, JSStringRef url, bool functions);
+
+typedef struct {
+    /* What JSModuleSourcePrecompile keeps: modules, the functions compiled
+       with them, and the length of their sources. */
+    size_t precompiledModules;
+    size_t precompiledFunctions;
+    size_t precompiledCharacters;
+    /* Module loads that found their source precompiled, and those that did
+       not, since the group has had a precompiled module. */
+    size_t moduleRecordHits;
+    size_t moduleRecordMisses;
+    /* Module evaluations that took their code from a precompiled module. */
+    size_t moduleCodeHits;
+    /* Functions the group compiled to bytecode, those of
+       JSModuleSourcePrecompile included. */
+    size_t functionCompiles;
+} JSModulePrecompileStats;
+
+/* Counters of the group. A forked process starts from its parent's values. */
+JS_EXPORT void JSContextGroupGetModulePrecompileStats(JSContextGroupRef group, JSModulePrecompileStats* stats);
+
 /* Loads `url` through the fetch callback and evaluates it. Returns a promise for
    the evaluation, or NULL (with *exception set) when the context does not
    support module loading. */
