+/* The referrer of the module fetch whose fetch callback is running (patch 0039): the key of the
+   module whose static import requested it (an inline module script's registered identity included),
+   or the source URL of the script whose import() did. NULL outside a fetch callback and for a fetch
+   without a referring script (JSLoadModuleGraph, JSLoadAndEvaluateModule, import() from a script
+   without a URL). The caller releases the string. */
+JS_EXPORT JSStringRef JSGlobalContextCopyModuleFetchReferrer(JSContextRef ctx);
