@@ -379,6 +380,8 @@ JSPromise* JSAPIGlobalObject::moduleLoaderFetch(JSGlobalObject* globalObject, JS
     }, promise);
 
     auto identifier = OpaqueJSString::tryCreate(moduleKey.string());
+    // The callback may ask for the fetch's referrer (JSGlobalContextCopyModuleFetchReferrer).
+    SetForScope fetchReferrer { thisObject->m_moduleFetchReferrer, referrer };
     if (thisObject->m_moduleLoaderTyped) {
         auto callback = reinterpret_cast<JSModuleLoaderTypedFetchCallback>(thisObject->m_moduleLoaderCallback);
         callback(toGlobalRef(globalObject), identifier.get(), type, toRef(resolve), toRef(reject), thisObject->m_moduleLoaderInfo);
@@ -592,6 +595,19 @@ bool JSGlobalContextSetInlineModuleBase(JSGlobalContextRef ctx, JSStringRef iden
     return true;
 }
 
+JSStringRef JSGlobalContextCopyModuleFetchReferrer(JSContextRef ctx)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject)
+        return nullptr;
+    const String& referrer = apiGlobalObject->moduleFetchReferrer();
+    if (referrer.isNull())
+        return nullptr;
+    return OpaqueJSString::tryCreate(referrer).leakRef();
+}
