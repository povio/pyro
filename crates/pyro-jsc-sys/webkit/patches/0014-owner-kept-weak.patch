+namespace {
+
+// Pyro: the owner of JSWeakCreateKeptWhile handles. The collector asks it, for an
+// object nothing else reaches, whether the host still wants the object: the host's byte.
+class KeptWhileOwner final : public WeakHandleOwner {
+public:
+    bool isReachableFromOpaqueRoots(JSC::Handle<JSC::Unknown>, void* context, AbstractSlotVisitor&, ASCIILiteral* reason) final
+    {
+        if (reason) [[unlikely]]
+            *reason = "Kept alive by its host owner"_s;
+        // Read during marking, possibly on a collector thread, while the VM's thread may write it.
+        return __atomic_load_n(static_cast<const unsigned char*>(context), __ATOMIC_RELAXED);
+    }
+};
+
+KeptWhileOwner& keptWhileOwner()
+{
+    static NeverDestroyed<KeptWhileOwner> owner;
+    return owner;
+}
