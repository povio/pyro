@@ -36,6 +36,16 @@ typedef const struct OpaqueJSWeak* JSWeakRef;
 
 JS_EXPORT JSWeakRef JSWeakCreate(JSContextGroupRef, JSObjectRef);
 
+/* Pyro: a weak handle that also keeps its object alive while `*keepAlive` is
+   nonzero. For a host object whose owner, not JavaScript reachability, decides how long
+   it lives (the wrapper of a DOM node that is in a document): the owner holds this one
+   handle, sets the byte while it wants the object, and needs no table of protected
+   values that every collection walks. The collector reads the byte while marking,
+   possibly from another thread; write it from the VM's thread as a single byte store.
+   The byte must outlive the handle. Once the byte is zero and nothing else reaches the
+   object, a collection ends it and JSWeakGetObject returns NULL. */
+JS_EXPORT JSWeakRef JSWeakCreateKeptWhile(JSContextGroupRef, JSObjectRef, const unsigned char* keepAlive);
+
 JS_EXPORT void JSWeakRetain(JSContextGroupRef, JSWeakRef);
 JS_EXPORT void JSWeakRelease(JSContextGroupRef, JSWeakRef);
 
