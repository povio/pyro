+// Pyro: the value of a name JSClassSetOwnPropertyNames answers as an own property.
+// The class's getValue callback gives it (Chrome's named properties: the value does not depend on
+// the prototype chain); without one, or when it gives none, a [[Get]].
+template <class Parent>
+EncodedJSValue JSCallbackObject<Parent>::ownNameGetterImpl(JSGlobalObject* globalObject, EncodedJSValue thisValue, PropertyName propertyName)
+{
+    VM& vm = getVM(globalObject);
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    JSCallbackObject* thisObj = asCallbackObject(thisValue);
+    if (StringImpl* name = propertyName.uid()) {
+        for (JSClassRef jsClass = thisObj->classRef(); jsClass; jsClass = jsClass->parentClass) {
+            if (!jsClass->answersOwnPropertyName(name))
+                continue;
+            JSObjectGetPropertyCallback getValue = jsClass->ownPropertyValue;
+            if (!getValue)
+                break;
+            RefPtr<OpaqueJSString> propertyNameRef = OpaqueJSString::tryCreate(name);
+            if (!propertyNameRef)
+                break;
+            JSValueRef exception = nullptr;
+            JSValueRef value;
+            {
+                JSLock::APICallbackScope callbackScope(globalObject);
+                value = getValue(toRef(globalObject), toRef(static_cast<JSObject*>(thisObj)), propertyNameRef.get(), &exception);
+            }
+            if (exception) {
+                throwException(globalObject, scope, toJS(globalObject, exception));
+                return JSValue::encode(jsUndefined());
+            }
+            if (value)
+                return JSValue::encode(toJS(globalObject, value));
+            break;
+        }
+    }
+    RELEASE_AND_RETURN(scope, JSValue::encode(thisObj->get(globalObject, propertyName)));
+}
