+/* Names a class's wrappers have as own properties although their values come from accessors
+   of the prototype: CSSOM's computed style, whose properties Chrome has as named properties
+   of the object itself. Per name, `flags` holds:
+   - kJSOwnPropertyNameListed: Object.getOwnPropertyNames, Object.keys, for..in, JSON and the
+     like list it, after what the class's getPropertyNames hook adds;
+   - kJSOwnPropertyNameDontEnum: listed only where non-enumerable names are (getOwnPropertyNames,
+     not Object.keys);
+   - kJSOwnPropertyNameAnswered: an own-property lookup (hasOwnProperty,
+     getOwnPropertyDescriptor, the copies of spread and Object.assign) answers it, when the
+     wrapper has no such property itself, as a writable, enumerable, configurable data property.
+     Its value is computed only when read (a descriptor, spread, Object.entries; not
+     hasOwnProperty, Object.hasOwn or propertyIsEnumerable): `getValue(ctx, object, name)`, or,
+     when that is null or returns null without an exception, a [[Get]] of the name.
+   A [[Get]], `in` and assignment never consult the names: they reach the prototype's accessors
+   as before, through the inline caches. Set right after JSClassCreate, before the first
+   object of the class exists; `names` are UTF-8 (never an array index) and copied. */
+#define kJSOwnPropertyNameListed 1u
+#define kJSOwnPropertyNameDontEnum 2u
+#define kJSOwnPropertyNameAnswered 4u
+JS_EXPORT void JSClassSetOwnPropertyNames(JSClassRef jsClass, const char* const* names, const unsigned char* flags, size_t count, JSObjectGetPropertyCallback getValue);
+
