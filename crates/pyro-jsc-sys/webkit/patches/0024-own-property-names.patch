+const Vector<std::pair<JSC::Identifier, bool>>& OpaqueJSClass::ownListedIdentifiers(JSGlobalObject* globalObject)
+{
+    OpaqueJSClassContextData& data = contextData(globalObject);
+    if (!data.ownListedIdentifiersMade) {
+        VM& vm = globalObject->vm();
+        data.ownListedIdentifiers.reserveInitialCapacity(ownListedNames.size());
+        for (auto& [name, dontEnum] : ownListedNames) {
+            // From the characters: Identifier::fromString(vm, String) would turn the class's
+            // string itself into an atom of this VM's table when the table lacks the name.
+            Identifier identifier = name.is8Bit() ? Identifier::fromString(vm, name.span8()) : Identifier::fromString(vm, name.span16());
+            data.ownListedIdentifiers.append({ WTF::move(identifier), dontEnum });
+        }
+        data.ownListedIdentifiersMade = true;
+    }
+    return data.ownListedIdentifiers;
+}
