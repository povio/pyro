+JSLock::APICallbackScope::APICallbackScope(JSGlobalObject* globalObject)
+{
+    if (Options::dropLocksInAPICallbacks()) {
+        m_dropper.emplace(globalObject);
+        return;
+    }
+    if (!globalObject)
+        return;
+    // A callback must never run from the collector, with or without the lock.
+    VM& vm = globalObject->vm();
+    RELEASE_ASSERT(!vm.currentThreadIsHoldingAPILock() || !vm.isCollectorBusyOnCurrentThread(), vm.currentThreadIsHoldingAPILock(), vm.isCollectorBusyOnCurrentThread());
+}
