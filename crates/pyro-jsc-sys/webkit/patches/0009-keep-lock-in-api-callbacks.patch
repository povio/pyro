+    // the embedder may block or hand the VM to another thread. Pyro's VMs stay on one
+    // thread, so by default the lock stays held, which saves a full lock cycle per callback and per
+    // API call inside it. JSC_dropLocksInAPICallbacks=true restores the stock behavior.
+    class APICallbackScope {
+        WTF_MAKE_NONCOPYABLE(APICallbackScope);
+    public:
+        JS_EXPORT_PRIVATE APICallbackScope(JSGlobalObject*);
+
+    private:
+        std::optional<DropAllLocks> m_dropper;
+    };
