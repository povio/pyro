+// The source of a JSCachedSource. It is a StringSourceProvider that answers cachedBytecode() and
+// knows its text's hash.
+class BytecodeCacheSourceProvider final : public StringSourceProvider {
+public:
+    static Ref<BytecodeCacheSourceProvider> create(const String& source, const SourceOrigin& sourceOrigin, String&& sourceURL, const TextPosition& startPosition, SourceProviderSourceType sourceType, BytecodeCacheSourceData&& data)
+    {
+        return adoptRef(*new BytecodeCacheSourceProvider(source, sourceOrigin, WTF::move(sourceURL), startPosition, sourceType, WTF::move(data)));
+    }
+
+    ~BytecodeCacheSourceProvider() final
+    {
+        if (m_data.moduleRecord.isEmpty())
+            return;
+        Locker locker { s_lock };
+        withModuleRecords().remove(this);
+    }
+
+    unsigned hash() const final
+    {
+        return m_data.sourceHash ? m_data.sourceHash : StringSourceProvider::hash();
+    }
+
+    RefPtr<CachedBytecode> cachedBytecode() const final
+    {
+        return m_data.bytecode;
+    }
+
+    // The record `provider` came with, when it is one of these and came with one. There is no
+    // way to ask a SourceProvider what it is, so those with a record are kept in a set.
+    static std::span<const uint8_t> moduleRecordOf(const SourceProvider& provider)
+    {
+        Locker locker { s_lock };
+        if (!withModuleRecords().contains(&provider))
+            return { };
+        return static_cast<const BytecodeCacheSourceProvider&>(provider).m_data.moduleRecord.span();
+    }
+
+private:
+    BytecodeCacheSourceProvider(const String& source, const SourceOrigin& sourceOrigin, String&& sourceURL, const TextPosition& startPosition, SourceProviderSourceType sourceType, BytecodeCacheSourceData&& data)
+        : StringSourceProvider(source, sourceOrigin, SourceTaintedOrigin::Untainted, WTF::move(sourceURL), startPosition, sourceType)
+        , m_data(WTF::move(data))
+    {
+        if (m_data.moduleRecord.isEmpty())
+            return;
+        Locker locker { s_lock };
+        withModuleRecords().add(this);
+    }
+
+    static UncheckedKeyHashSet<const SourceProvider*>& withModuleRecords() WTF_REQUIRES_LOCK(s_lock)
+    {
+        static NeverDestroyed<UncheckedKeyHashSet<const SourceProvider*>> set;
+        return set;
+    }
+
+    static Lock s_lock;
+
+    const BytecodeCacheSourceData m_data;
+};
+
+Lock BytecodeCacheSourceProvider::s_lock;
+
+} // namespace
+
+SourceCode makeBytecodeCacheSource(const String& source, const SourceOrigin& sourceOrigin, String sourceURL, const TextPosition& startPosition, SourceProviderSourceType sourceType, BytecodeCacheSourceData&& data)
+{
+    return SourceCode(BytecodeCacheSourceProvider::create(source, sourceOrigin, WTF::move(sourceURL), startPosition, sourceType, WTF::move(data)));
+}
