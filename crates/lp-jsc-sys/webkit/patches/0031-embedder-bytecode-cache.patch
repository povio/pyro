+bool JSModuleSourcePrecompileCached(JSContextRef ctx, const JSCachedSource* source, JSStringRef url)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    String text = cachedSourceText(*source);
+    if (text.isNull())
+        return false;
+
+    String urlString = url->string();
+    URL sourceURL { { }, urlString };
+    if (!sourceURL.isValid())
+        return false;
+    auto sourceCode = makeBytecodeCacheSource(text, SourceOrigin { sourceURL }, urlString, TextPosition(), SourceProviderSourceType::Module, cachedSourceData(*source));
+    return vm.codeCache()->precompileModule(globalObject, sourceCode, false);
+}
+
+bool JSBytecodeCacheGenerate(JSContextRef ctx, const JSCachedSource* source, JSStringRef url, bool module, JSBytecodeCacheSink sink, void* info)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    String text = cachedSourceText(*source);
+    if (text.isNull())
+        return false;
+
+    // The sources of the two functions above. A position is not part of what is generated.
+    SourceCode sourceCode;
+    if (module) {
+        if (!url)
+            return false;
+        String urlString = url->string();
+        URL sourceURL { { }, urlString };
+        if (!sourceURL.isValid())
+            return false;
+        sourceCode = makeSource(text, SourceOrigin { sourceURL }, SourceTaintedOrigin::Untainted, urlString, TextPosition(), SourceProviderSourceType::Module);
+    } else {
+        auto sourceURL = url ? URL({ }, url->string()) : URL();
+        sourceCode = makeSource(text, SourceOrigin { sourceURL }, SourceTaintedOrigin::Untainted, sourceURL.string(), TextPosition());
+    }
+
+    BytecodeCacheEntry entry;
+    if (!generateBytecodeCacheEntry(globalObject, sourceCode, entry))
+        return false;
+    auto bytecode = entry.bytecode->span();
+    sink(info, bytecode.data(), bytecode.size(), entry.moduleRecord.isEmpty() ? nullptr : entry.moduleRecord.span().data(), entry.moduleRecord.size(), entry.sourceHash);
+    return true;
+}
+
+void JSContextGroupGetBytecodeCacheStats(JSContextGroupRef group, JSBytecodeCacheStats* stats)
+{
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+
+    const BytecodeCacheStats& counters = vm.codeCache()->bytecodeCacheStats();
+    stats->codeAccepted = counters.codeAccepted;
+    stats->codeRejected = counters.codeRejected;
+    stats->recordAccepted = counters.recordAccepted;
+    stats->recordRejected = counters.recordRejected;
+}
