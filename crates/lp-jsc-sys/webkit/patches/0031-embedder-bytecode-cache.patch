+// lightningpanda: the text of a JSCachedSource. Borrowed text is released by the string, so on
+// every path once this was called.
+static String cachedSourceText(const JSCachedSource& source)
+{
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+    if (!source.release) {
+        if (source.sourceIs8Bit)
+            return String { std::span { static_cast<const Latin1Character*>(source.source), source.sourceLength } };
+        return String { std::span { static_cast<const char16_t*>(source.source), source.sourceLength } };
+    }
+    auto callback = source.release;
+    void* info = source.releaseInfo;
+    if (!source.sourceLength || source.sourceLength > String::MaxLength) {
+        callback(info);
+        return source.sourceLength ? String() : emptyString();
+    }
+    auto free = [callback, info](ExternalStringImpl*, void*, unsigned) {
+        callback(info);
+    };
+    Ref<StringImpl> impl = source.sourceIs8Bit
+        ? ExternalStringImpl::create(std::span { static_cast<const Latin1Character*>(source.source), source.sourceLength }, WTF::move(free))
+        : ExternalStringImpl::create(std::span { static_cast<const char16_t*>(source.source), source.sourceLength }, WTF::move(free));
+    return String { WTF::move(impl) };
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+}
+
+static BytecodeCacheSourceData cachedSourceData(const JSCachedSource& source)
+{
+    BytecodeCacheSourceData data;
+    data.sourceHash = source.sourceHash;
+    if (source.bytecodeFileDescriptor >= 0 && source.bytecodeLength)
+        data.bytecode = mapBytecodeCacheFile(source.bytecodeFileDescriptor, source.bytecodeLength);
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+    if (source.moduleRecord && source.moduleRecordLength)
+        data.moduleRecord = Vector<uint8_t> { std::span { source.moduleRecord, source.moduleRecordLength } };
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+    return data;
+}
+
+uint64_t JSBytecodeCacheVersion(void)
+{
+    return bytecodeCacheVersion();
+}
+
