+/* A bytecode cache, kept by the embedder.
+
+   JSBytecodeCacheGenerate compiles a script or a module with every function in
+   it and hands over the bytecode (and, for a module, its record: what it
+   imports and exports) as bytes. The embedder stores them under the source text
+   and JSBytecodeCacheVersion(), and gives them back with the text in a
+   JSCachedSource: the code is then decoded where it would be parsed and
+   compiled, a function's at its first call, and a module's record is filled
+   without a parse.
+
+   THE BYTES ARE TRUSTED. Bytecode is not verified: bytes that
+   JSBytecodeCacheGenerate did not make, or made in a process with another
+   JSBytecodeCacheVersion(), or made from another text, are memory-unsafe to
+   give back. The embedder keeps them where nothing else can write, checks them
+   (a checksum) and keys them by all of the text. JavaScriptCore itself checks
+   only its build and the text's hash, length and kind, and an entry failing
+   that is ignored (the source is compiled as without one). */
+
+/* Called once the text of a JSCachedSource is no longer referenced. On any
+   thread that releases the last reference, a garbage collector's included. */
+typedef void (*JSCachedSourceReleaseCallback)(void* info);
+
+typedef struct {
+    /* The text: Latin-1 bytes when sourceIs8Bit, else UTF-16 code units.
+       sourceLength counts characters. */
+    const void* source;
+    size_t sourceLength;
+    bool sourceIs8Bit;
+    /* NULL: the text is copied. Otherwise it is borrowed, not copied, and must
+       stay readable and unchanged until release(releaseInfo), which is called
+       exactly once, whatever the function given this struct returns. */
+    JSCachedSourceReleaseCallback release;
+    void* releaseInfo;
+    /* The sourceHash a JSBytecodeCacheSink was given for this text, which
+       spares hashing it. 0: not known. */
+    unsigned sourceHash;
+    /* A file whose first bytecodeLength bytes are the bytecode a
+       JSBytecodeCacheSink was given for this text, or -1. The bytes are mapped
+       read-only and stay mapped while code decoded from them is alive; the
+       descriptor is not kept and stays the caller's. */
+    int bytecodeFileDescriptor;
+    size_t bytecodeLength;
+    /* The module record a JSBytecodeCacheSink was given for this text, or
+       NULL. Copied. */
+    const uint8_t* moduleRecord;
+    size_t moduleRecordLength;
