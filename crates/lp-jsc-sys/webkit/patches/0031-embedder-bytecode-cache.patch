+RefPtr<CachedBytecode> mapBytecodeCacheFile(int fileDescriptor, size_t length)
+{
+#if HAVE(MMAP)
+    if (fileDescriptor < 0 || !length)
+        return nullptr;
+    auto mapping = MmapSpan<uint8_t>::mmap(nullptr, length, PROT_READ, MAP_PRIVATE, fileDescriptor);
+    if (!mapping.span().data())
+        return nullptr;
+    return CachedBytecode::create(FileSystem::MappedFileData { WTF::move(mapping) });
+#else
+    UNUSED_PARAM(fileDescriptor);
+    UNUSED_PARAM(length);
+    return nullptr;
+#endif
+}
+
+std::unique_ptr<PrecompiledModule> CodeCache::cachedModuleRecord(VM& vm, const SourceCode& source)
+{
+    auto bytes = BytecodeCacheSourceProvider::moduleRecordOf(*source.provider());
+    if (bytes.empty())
+        return nullptr;
+    auto module = decodeModuleRecord(vm, bytes);
+    if (module)
+        ++m_bytecodeCacheStats.recordAccepted;
+    else
+        ++m_bytecodeCacheStats.recordRejected;
+    return module;
+}
+
+bool generateBytecodeCacheEntry(JSGlobalObject* globalObject, const SourceCode& source, BytecodeCacheEntry& entry)
+{
+    VM& vm = globalObject->vm();
+    bool isModule = source.provider()->sourceType() == SourceProviderSourceType::Module;
+
+    // The keys CodeCache::getUnlinkedGlobalCodeBlock looks a program and a module up by, in a
+    // realm that generates plain code (no debugger, no profiler). In another, the entry's key
+    // differs, the entry is refused, and the source is compiled as without a cache.
+    ParserError error;
+    UnlinkedCodeBlock* codeBlock = nullptr;
+    if (isModule) {
+        PrecompiledModule module;
+        if (analyzeModule(globalObject, source, module))
+            entry.moduleRecord = encodeModuleRecord(vm, module, *source.provider());
+        codeBlock = recursivelyGenerateUnlinkedCodeBlockForModuleProgram(vm, source, StrictModeLexicallyScopedFeature, JSParserScriptMode::Module, { }, error, EvalContextType::None);
+    } else
+        codeBlock = recursivelyGenerateUnlinkedCodeBlockForProgram(vm, source, NoLexicallyScopedFeatures, JSParserScriptMode::Classic, { }, error, EvalContextType::None);
+    if (!codeBlock)
+        return false;
+
+    SourceCodeKey key = isModule ? sourceCodeKeyForSerializedModule(vm, source) : sourceCodeKeyForSerializedProgram(vm, source);
+    entry.bytecode = encodeCodeBlockWithoutSource(vm, key, codeBlock);
+    entry.sourceHash = source.provider()->hash();
+    return !!entry.bytecode;
+}
+
+uint64_t bytecodeCacheVersion()
+{
+    // FNV-1a over what an entry depends on.
+    uint64_t hash = 0xcbf29ce484222325ULL;
+    auto add = [&](uint64_t value) {
+        for (unsigned i = 0; i < sizeof(value); ++i) {
+            hash ^= (value >> (i * 8)) & 0xff;
+            hash *= 0x100000001b3ULL;
+        }
+    };
+
+    // The form of the module record and of an entry without source text.
+    add(1);
+    add(computeJSCBytecodeCacheVersion());
+    add(sizeof(void*));
+    // The options the parser, the bytecode generator and the decoder read.
+    add(Options::useExplicitResourceManagement());
+    add(Options::useImportDefer());
+    add(Options::useImportText());
+    add(Options::useCSSModuleScripts());
+    add(Options::useTailCalls());
+    add(Options::optimizeRecursiveTailCalls());
+    add(Options::alwaysUseShadowChicken());
+    add(Options::returnEarlyFromInfiniteLoopsForFuzzing());
+    add(Options::exposePrivateIdentifiers());
+    add(Options::useSourceProviderCache());
+    add(Options::useCodeCache());
+    add(!!Options::functionOverrides());
+    add(static_cast<uint64_t>(static_cast<int64_t>(Options::thresholdForJITAfterWarmUp())));
+    add(static_cast<uint64_t>(static_cast<int64_t>(Options::switchJumpTableAmountThreshold())));
+    return hash;
+}
