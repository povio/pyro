+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+
+// A module's record as bytes: what a PrecompiledModule holds but its code. The form belongs to
+// one build (bytecodeCacheVersion), so it is written in the machine's byte order, without
+// alignment. Everything read is checked: bytes that are not a record give no record, never a
+// read outside them. An identifier is a string or one of the VM's private names (a module's
+// default export is bound to one); a record with any other symbol is not written.
+constexpr uint32_t moduleRecordMagic = 0x524d504c; // "LPMR"
+
+class ModuleRecordWriter {
+public:
+    void u8(uint8_t value) { m_bytes.append(value); }
+    void u16(uint16_t value) { raw(&value, sizeof(value)); }
+    void u32(uint32_t value) { raw(&value, sizeof(value)); }
+
+    void string(const String& string)
+    {
+        if (string.isNull()) {
+            u8(0);
+            return;
+        }
+        u8(string.is8Bit() ? 1 : 2);
+        u32(string.length());
+        if (string.is8Bit())
+            raw(string.span8().data(), string.length());
+        else
+            raw(string.span16().data(), string.length() * sizeof(char16_t));
+    }
+
+    void uid(VM& vm, UniquedStringImpl* impl)
+    {
+        if (!impl) {
+            u8(0);
+            return;
+        }
+        if (!impl->isSymbol()) {
+            u8(1);
+            string(String { impl });
+            return;
+        }
+        // As CachedUniquedStringImplBase does: a private name is found again by its description.
+        SymbolImpl& symbol = static_cast<SymbolImpl&>(*impl);
+        String description = symbol.is8Bit() ? String { symbol.span8() } : String { symbol.span16() };
+        if (!symbol.isPrivate() || symbol.isRegistered() || vm.propertyNames->builtinNames().lookUpPrivateName(description) != &symbol) {
+            m_failed = true;
+            return;
+        }
+        u8(2);
+        string(description);
+    }
+
+    void identifier(VM& vm, const Identifier& identifier) { uid(vm, identifier.impl()); }
+
+    void fail() { m_failed = true; }
+    bool failed() const { return m_failed; }
+    Vector<uint8_t> take() { return WTF::move(m_bytes); }
+
+private:
+    void raw(const void* data, size_t size)
+    {
+        m_bytes.append(std::span { static_cast<const uint8_t*>(data), size });
+    }
+
+    Vector<uint8_t> m_bytes;
+    bool m_failed { false };
+};
+
+class ModuleRecordReader {
+public:
+    ModuleRecordReader(std::span<const uint8_t> bytes)
+        : m_bytes(bytes)
+    {
+    }
+
+    uint8_t u8() { return read<uint8_t>(); }
+    uint16_t u16() { return read<uint16_t>(); }
+    uint32_t u32() { return read<uint32_t>(); }
+
+    // An enumerator, which is one of the first `count`.
+    template<typename T> T enumerator(unsigned count)
+    {
+        uint8_t value = u8();
+        if (value >= count) {
+            m_failed = true;
+            return static_cast<T>(0);
+        }
+        return static_cast<T>(value);
+    }
+
+    // A count of things that take a byte or more each.
+    uint32_t count()
+    {
+        uint32_t value = u32();
+        if (value > remaining()) {
+            m_failed = true;
+            return 0;
+        }
+        return value;
+    }
+
+    String string()
+    {
+        uint8_t kind = u8();
+        if (!kind || m_failed)
+            return String();
+        if (kind > 2) {
+            m_failed = true;
+            return String();
+        }
+        size_t length = u32();
+        size_t size = kind == 1 ? length : length * sizeof(char16_t);
+        if (m_failed || size > remaining() || length > String::MaxLength) {
+            m_failed = true;
+            return String();
+        }
+        const uint8_t* data = m_bytes.data() + m_offset;
+        m_offset += size;
+        if (!length)
+            return emptyString();
+        if (kind == 1)
+            return String { std::span { std::bit_cast<const Latin1Character*>(data), length } };
+        std::span<char16_t> characters;
+        String result = String::createUninitialized(length, characters);
+        memcpy(characters.data(), data, size);
+        return result;
+    }
+
+    Identifier identifier(VM& vm)
+    {
+        uint8_t kind = u8();
+        if (!kind || m_failed)
+            return Identifier();
+        String name = string();
+        if (m_failed || name.isNull() || kind > 2) {
+            m_failed = true;
+            return Identifier();
+        }
+        if (kind == 1)
+            return Identifier::fromString(vm, name);
+        SymbolImpl* symbol = vm.propertyNames->builtinNames().lookUpPrivateName(name);
+        if (!symbol) {
+            m_failed = true;
+            return Identifier();
+        }
+        return Identifier::fromUid(vm, symbol);
+    }
+
+    bool failed() const { return m_failed; }
+    bool atEnd() const { return !remaining(); }
+
+private:
+    size_t remaining() const { return m_bytes.size() - m_offset; }
+
+    template<typename T> T read()
+    {
+        T value { };
+        if (m_failed || sizeof(T) > remaining()) {
+            m_failed = true;
+            return value;
+        }
+        memcpy(&value, m_bytes.data() + m_offset, sizeof(T));
+        m_offset += sizeof(T);
+        return value;
+    }
+
+    std::span<const uint8_t> m_bytes;
+    size_t m_offset { 0 };
+    bool m_failed { false };
+};
+
+constexpr unsigned numberOfFetchTypes = ScriptFetchParameters::Type::CSS + 1;
+constexpr unsigned numberOfModulePhases = static_cast<unsigned>(AbstractModuleRecord::ModulePhase::Defer) + 1;
+
+Vector<uint8_t> encodeModuleRecord(VM& vm, const PrecompiledModule& module, const SourceProvider& provider)
+{
+    ModuleRecordWriter writer;
+    writer.u32(moduleRecordMagic);
+    writer.u16(module.features);
+    writer.u8(module.hasTLA);
+    writer.string(provider.sourceURLDirective());
+    writer.string(provider.sourceMappingURLDirective());
+
+    writer.u32(module.requestedModules.size());
+    for (const auto& request : module.requestedModules) {
+        writer.identifier(vm, request.m_specifier);
+        // The parser's attributes are a type and nothing else.
+        if (request.m_attributes && !request.m_attributes->integrity().isNull())
+            writer.fail();
+        writer.u8(!!request.m_attributes);
+        writer.u8(request.m_attributes ? request.m_attributes->type() : 0);
+        writer.u8(static_cast<uint8_t>(request.m_phase));
+    }
+
+    writer.u32(module.importEntries.size());
+    for (const auto& entry : module.importEntries) {
+        writer.u8(static_cast<uint8_t>(entry.type));
+        writer.u8(static_cast<uint8_t>(entry.phase));
+        writer.u8(entry.moduleRequestType);
+        writer.identifier(vm, entry.moduleRequest);
+        writer.identifier(vm, entry.importName);
+        writer.identifier(vm, entry.localName);
+    }
+
+    writer.u32(module.exportEntries.size());
+    for (const auto& entry : module.exportEntries) {
+        writer.u8(static_cast<uint8_t>(entry.type));
+        writer.u8(entry.moduleRequestType);
+        writer.identifier(vm, entry.exportName);
+        writer.identifier(vm, entry.moduleName);
+        writer.identifier(vm, entry.importName);
+        writer.identifier(vm, entry.localName);
+    }
+
+    writer.u32(module.starExportEntries.size());
+    for (const auto& entry : module.starExportEntries) {
+        writer.uid(vm, entry.first.get());
+        writer.u8(entry.second);
+    }
+
+    if (writer.failed())
+        return { };
+    return writer.take();
+}
+
+std::unique_ptr<PrecompiledModule> decodeModuleRecord(VM& vm, std::span<const uint8_t> bytes)
+{
+    using ModulePhase = AbstractModuleRecord::ModulePhase;
+    using FetchType = ScriptFetchParameters::Type;
+
+    ModuleRecordReader reader(bytes);
+    if (reader.u32() != moduleRecordMagic)
+        return nullptr;
+
+    auto module = makeUnique<PrecompiledModule>();
+    module->features = reader.u16();
+    module->hasTLA = reader.enumerator<uint8_t>(2);
+    module->sourceURLDirective = reader.string();
+    module->sourceMappingURLDirective = reader.string();
+
+    for (uint32_t count = reader.count(); count && !reader.failed(); --count) {
+        AbstractModuleRecord::ModuleRequest request;
+        request.m_specifier = reader.identifier(vm);
+        bool hasAttributes = reader.enumerator<uint8_t>(2);
+        auto type = reader.enumerator<FetchType>(numberOfFetchTypes);
+        request.m_phase = reader.enumerator<ModulePhase>(numberOfModulePhases);
+        if (hasAttributes)
+            request.m_attributes = ScriptFetchParameters::create(type);
+        if (request.m_specifier.isNull())
+            return nullptr;
+        module->requestedModules.append(WTF::move(request));
+    }
+
+    for (uint32_t count = reader.count(); count && !reader.failed(); --count) {
+        AbstractModuleRecord::ImportEntry entry;
+        entry.type = reader.enumerator<AbstractModuleRecord::ImportEntryType>(2);
+        entry.phase = reader.enumerator<ModulePhase>(numberOfModulePhases);
+        entry.moduleRequestType = reader.enumerator<FetchType>(numberOfFetchTypes);
+        entry.moduleRequest = reader.identifier(vm);
+        entry.importName = reader.identifier(vm);
+        entry.localName = reader.identifier(vm);
+        // The record's map of imports is keyed by the local name.
+        if (entry.localName.isNull())
+            return nullptr;
+        module->importEntries.append(WTF::move(entry));
+    }
+
+    for (uint32_t count = reader.count(); count && !reader.failed(); --count) {
+        AbstractModuleRecord::ExportEntry entry;
+        entry.type = reader.enumerator<AbstractModuleRecord::ExportEntry::Type>(3);
+        entry.moduleRequestType = reader.enumerator<FetchType>(numberOfFetchTypes);
+        entry.exportName = reader.identifier(vm);
+        entry.moduleName = reader.identifier(vm);
+        entry.importName = reader.identifier(vm);
+        entry.localName = reader.identifier(vm);
+        // And its map of exports by the export name.
+        if (entry.exportName.isNull())
+            return nullptr;
+        module->exportEntries.append(WTF::move(entry));
+    }
+
+    for (uint32_t count = reader.count(); count && !reader.failed(); --count) {
+        Identifier name = reader.identifier(vm);
+        auto type = reader.enumerator<FetchType>(numberOfFetchTypes);
+        if (name.isNull())
+            return nullptr;
+        module->starExportEntries.append({ name.impl(), type });
+    }
+
+    if (reader.failed() || !reader.atEnd())
+        return nullptr;
+    return module;
+}
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
