@@ -0,0 +1,52 @@
+/*
+ * Lightningpanda: see JSForkPrivate.h.
+ */
+
+#include "config.h"
+#include "JSForkPrivate.h"
+
+#include "APICast.h"
+#include "Heap.h"
+#include "JITWorklist.h"
+#include "JSLock.h"
+#include "VM.h"
+#include <bmalloc/BPlatform.h>
+#include <wtf/AutomaticThread.h>
+#include <wtf/Threading.h>
+
+WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
+#if BUSE(LIBPAS)
+#include <bmalloc/bmalloc_prefault_supply.h>
+#include <bmalloc/pas_scavenger.h>
+#endif
+WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
+
+using namespace JSC;
+
+bool JSPrepareForFork(JSContextGroupRef group, double timeoutSeconds)
+{
+    VM& vm = *toJS(group);
+    {
+        JSLockHolder locker(vm);
+#if ENABLE(JIT)
+        if (auto* worklist = JITWorklist::existingGlobalWorklistOrNull())
+            worklist->completeAllPlansForVM(vm);
+#endif
+        vm.heap.collectNow(Sync, CollectionScope::Full);
+    }
+#if BUSE(LIBPAS)
+    bmalloc_prefault_supply_suspend();
+    pas_scavenger_suspend();
+#endif
+    return AutomaticThread::sleepAllForFork(Seconds(timeoutSeconds));
+}
+
+void JSDidFork(bool isChild)
+{
+    if (isChild)
+        Thread::currentSingleton().didForkInChild();
+#if BUSE(LIBPAS)
+    pas_scavenger_resume();
+    bmalloc_prefault_supply_resume();
+#endif
+}
diff --git a/Source/JavaScriptCore/API/JSForkPrivate.h b/Source/JavaScriptCore/API/JSForkPrivate.h
new file mode 100644
index 00000000..141ba555
--- /dev/null
+++ b/Source/JavaScriptCore/API/JSForkPrivate.h
@@ -0,0 +1,38 @@
+/*
+ * Lightningpanda: fork() support. A process that has run JavaScript (for example
+ * booted a web app) can fork() and keep using the same VM in the child, which
+ * then starts from that state with its memory shared copy-on-write.
+ *
+ * fork() keeps only the calling thread, so JavaScriptCore's helper threads (GC
+ * collector and markers, JIT compilers, the libpas scavenger) must not exist at
+ * that moment: they would be missing in the child while their owners still
+ * expect them, and could hold locks the child needs.
+ */
+
+#ifndef JSForkPrivate_h
+#define JSForkPrivate_h
+
+#include <JavaScriptCore/JSBase.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Finishes garbage collection and JIT compilation for `group`, then parks every
+   JavaScriptCore helper thread in the process. Call on the thread that uses
+   `group`, with no other thread running JavaScript, right before fork().
+   Returns false (with threads possibly still running) when they did not stop
+   within `timeoutSeconds`; JSDidFork must still be called. */
+JS_EXPORT bool JSPrepareForFork(JSContextGroupRef group, double timeoutSeconds);
+
+/* Call right after fork(): JSDidFork(false) in the parent, JSDidFork(true) in the
+   child, before anything else uses JavaScriptCore. Helper threads restart on
+   demand. */
+JS_EXPORT void JSDidFork(bool isChild);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* JSForkPrivate_h */
