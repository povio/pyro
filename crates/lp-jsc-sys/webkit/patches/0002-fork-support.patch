+bool AutomaticThread::sleepAllForFork(Seconds timeout)
+{
+    auto deadline = MonotonicTime::now() + timeout;
+    Vector<Ref<Thread>> exited;
+    for (;;) {
+        bool pending = false;
+        {
+            Locker allLocker { allThreadsLock };
+            for (auto* thread : allThreads()) {
+                // A constructor holds its thread's lock while it takes allThreadsLock, so never block here.
+                if (!thread->m_lock->tryLock()) {
+                    pending = true;
+                    continue;
+                }
+                Locker locker { AdoptLock, *thread->m_lock };
+                if (!thread->m_hasUnderlyingThread) {
+                    if (RefPtr last = std::exchange(thread->m_lastThread, nullptr))
+                        exited.append(last.releaseNonNull());
+                    continue;
+                }
+                pending = true;
+                if (thread->m_isWaiting) {
+                    thread->m_sleepRequested = true;
+                    thread->m_waitCondition.notifyAll();
+                }
+            }
+        }
+        if (!pending) {
+            // They have announced their exit; wait until it is complete (thread-local destructors
+            // included), so that nothing of theirs is left half torn down in a forked child.
+            for (auto& thread : exited)
+                thread->waitForCompletion();
+            return true;
+        }
+        if (MonotonicTime::now() > deadline) {
+            for (auto& thread : exited)
+                thread->detach();
+            return false;
+        }
+        Thread::yield();
+    }
+}
