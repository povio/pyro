 #include "APICast.h"
 #include "Heap.h"
+#include "IntlObject.h"
 #include "JITWorklist.h"
 #include "JSGlobalObject.h"
 #include "JSLock.h"
@@ -87,4 +88,19 @@
     UNUSED_PARAM(group);
     UNUSED_PARAM(wait);
 #endif
+}
+
+bool JSContextGroupSetTimeZone(JSContextGroupRef group, const char* timeZoneID)
+{
+    VM& vm = *toJS(group);
+    JSLockHolder locker(vm);
+    if (!timeZoneID || !*timeZoneID) {
+        vm.dateCache.setTimeZoneOverride(std::nullopt);
+        return true;
+    }
+    auto resolved = intlAvailableNamedTimeZone(StringView::fromLatin1(timeZoneID));
+    if (!resolved)
+        return false;
+    vm.dateCache.setTimeZoneOverride(TimeZone::fromID(resolved->id));
+    return true;
 }
