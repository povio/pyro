+   alone, from its next outermost entry on; other VMs in the process keep theirs.
+   NULL or "" returns to the host's zone. Returns false, changing nothing, for an ID
+   that Intl.DateTimeFormat's timeZone option would reject. Costs nothing unless
+   used: the check is on the path that rebuilds the zone cache. */
+JS_EXPORT bool JSContextGroupSetTimeZone(JSContextGroupRef group, const char* timeZoneID);
+
 #ifdef __cplusplus
 }
