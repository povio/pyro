Lightningpanda patch 0023: intern fast getters by a hash map.

JSObjectSetFastGetter (patch 0013) shares one immortal APIFastGetter (the DOMJIT::GetterSetter
compiled code points at) per distinct (getter, fast callback, context, result type, readsOnly).
It found the existing one by a linear search of every fast getter the process had made, under
a lock. A realm defines each class's attributes on first use, hundreds per class, so the search
was quadratic in the number of attributes: populating CSSStyleDeclaration's ~1,600 attributes
as fast getters cost each realm about 1.5 ms. Now a HashMap keyed by that tuple.

diff --git a/Source/JavaScriptCore/API/JSFork.cpp b/Source/JavaScriptCore/API/JSFork.cpp
index 54fe7f2def..16ccb2765e 100644
--- a/Source/JavaScriptCore/API/JSFork.cpp
+++ b/Source/JavaScriptCore/API/JSFork.cpp
@@ -21,6 +21,7 @@
 #include "Snippet.h"
 #include "SnippetParams.h"
 #include "TopExceptionScope.h"
+#include <wtf/HashMap.h>
 #include <wtf/Lock.h>
 #include <wtf/NeverDestroyed.h>
 #include "DeleteAllCodeEffort.h"
@@ -384,23 +385,31 @@ public:
     bool readsOnly;
 };
 
+// What identifies a fast getter: its custom getter, fast callback, context, result type
+// and whether it only reads. Pointers as integers (WTF hashes those; it has no hash for
+// function pointers).
+using APIFastGetterKey = std::tuple<uintptr_t, uintptr_t, uintptr_t, uint64_t, unsigned>;
+
 static Lock apiFastGettersLock;
-static Vector<std::unique_ptr<APIFastGetter>>& apiFastGetters() WTF_REQUIRES_LOCK(apiFastGettersLock)
+// Every fast getter the process made, by its key. A realm defines hundreds of them on a
+// class's first use (one per attribute), so finding the existing one must not scan the
+// others: a hash lookup instead of the linear search this was.
+static HashMap<APIFastGetterKey, std::unique_ptr<APIFastGetter>>& apiFastGetters() WTF_REQUIRES_LOCK(apiFastGettersLock)
 {
-    static NeverDestroyed<Vector<std::unique_ptr<APIFastGetter>>> getters;
+    static NeverDestroyed<HashMap<APIFastGetterKey, std::unique_ptr<APIFastGetter>>> getters;
     return getters.get();
 }
 
 static const APIFastGetter* internAPIFastGetter(DOMJIT::GetterSetter::CustomGetter getter, JSFastGetterCallback fast, void* context, SpeculatedType resultType, bool readsOnly)
 {
+    // The getter is never null (JSObjectSetFastGetter checks), so no key is the map's empty
+    // value, and nothing is ever removed.
+    APIFastGetterKey key { reinterpret_cast<uintptr_t>(getter), reinterpret_cast<uintptr_t>(fast), reinterpret_cast<uintptr_t>(context), static_cast<uint64_t>(resultType), readsOnly ? 1u : 0u };
     Locker locker { apiFastGettersLock };
-    auto& getters = apiFastGetters();
-    for (auto& g : getters) {
-        if (g->getter() == getter && g->fast == fast && g->fastContext == context && g->resultType() == resultType && g->readsOnly == readsOnly)
-            return g.get();
-    }
-    getters.append(makeUnique<APIFastGetter>(getter, fast, context, resultType, readsOnly));
-    return getters.last().get();
+    auto result = apiFastGetters().ensure(key, [&] {
+        return makeUnique<APIFastGetter>(getter, fast, context, resultType, readsOnly);
+    });
+    return result.iterator->value.get();
 }
 
 JSC_DECLARE_JIT_OPERATION(operationAPIFastGetter, EncodedJSValue, (JSGlobalObject*, void*, void*));
