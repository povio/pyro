+// Lightningpanda: the hold the forking thread asked for (0: none), and the one the
+// queue's thread is in.
+static std::atomic<uint64_t> vmTrapsQueueHoldRequested;
+static std::atomic<uint64_t> vmTrapsQueueHoldReached;
+static std::atomic<uint64_t> vmTrapsQueueHolds;
+
+bool VMTraps::holdQueueForFork(Seconds timeout)
+{
+    // fork() does not stop the queue's thread, and a lock it holds at that instant
+    // stays locked in the child for good: a watchdog's (its timers then never
+    // notify the VM), a VM's trap lock (the VM hangs handling its next trap), a
+    // ParkingLot bucket (whoever parks there next hangs) or one of the allocator's
+    // (the child aborts on it). Between two functions the thread holds none, so it
+    // waits there, and must take none to wait: no WTF::sleep, no Condition.
+    WorkQueue* queue = vmTrapsQueue.load();
+    if (!queue)
+        return true;
+    uint64_t hold = ++vmTrapsQueueHolds;
+    vmTrapsQueueHoldRequested.store(hold);
+    queue->dispatch([hold] {
+        vmTrapsQueueHoldReached.store(hold);
+        while (vmTrapsQueueHoldRequested.load() == hold)
+            std::this_thread::sleep_for(std::chrono::microseconds(50));
+    });
+    MonotonicTime deadline = MonotonicTime::now() + timeout;
+    while (vmTrapsQueueHoldReached.load() != hold) {
+        if (MonotonicTime::now() > deadline) {
+            vmTrapsQueueHoldRequested.store(0);
+            return false;
+        }
+        // Not Thread::yield(): on Darwin that depresses this thread for a millisecond,
+        // which is how long each call takes while other threads want the processor.
+        std::this_thread::sleep_for(std::chrono::microseconds(10));
+    }
+    return true;
+}
+
+void VMTraps::releaseQueueAfterFork()
+{
+    vmTrapsQueueHoldRequested.store(0);
+}
