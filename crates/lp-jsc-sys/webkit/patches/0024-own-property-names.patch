diff --git a/Source/JavaScriptCore/API/JSFork.cpp b/Source/JavaScriptCore/API/JSFork.cpp
index 16ccb2765e..5452d2031a 100644
--- a/Source/JavaScriptCore/API/JSFork.cpp
+++ b/Source/JavaScriptCore/API/JSFork.cpp
@@ -494,6 +494,23 @@ void JSContextThrowException(JSContextRef ctx, JSValueRef exception)
     throwException(globalObject, scope, toJS(globalObject, exception));
 }
 
+void JSClassSetOwnPropertyNames(JSClassRef jsClass, const char* const* names, const unsigned char* flags, size_t count)
+{
+    if (!jsClass || (count && (!names || !flags)))
+        return;
+    jsClass->ownListedNames.clear();
+    jsClass->ownAnsweredNames.clear();
+    for (size_t i = 0; i < count; ++i) {
+        String name = String::fromUTF8(names[i]);
+        if (name.isEmpty())
+            continue;
+        if (flags[i] & kJSOwnPropertyNameListed)
+            jsClass->ownListedNames.append({ name, !!(flags[i] & kJSOwnPropertyNameDontEnum) });
+        if (flags[i] & kJSOwnPropertyNameAnswered)
+            jsClass->ownAnsweredNames.add(name.impl());
+    }
+}
