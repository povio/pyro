+std::expected<String, String> JSAPIGlobalObject::resolveModuleSpecifier(const String& specifier, const String& referrer)
+{
+    URL base;
+    if (!referrer.isNull())
+        base = URL { { }, referrer };
+    auto resolveWithoutMap = [&] () -> std::expected<String, String> {
+        auto result = computeValidImportSpecifier(base, specifier);
+        if (!result)
+            return makeUnexpected(result.error());
+        return result.value().string();
+    };
+    // Without a referrer an absolute URL is an entry point, which import maps
+    // do not apply to.
+    if (!m_hasImportMap || (referrer.isEmpty() && URL(specifier).isValid()))
+        return resolveWithoutMap();
+    // An inline module's referrer is `<document URL>#inline-module-N`; scopes
+    // match the document URL.
+    if (base.string().contains("#inline-module-"_s))
+        base.removeFragmentIdentifier();
+    URL resolved = importMap().resolve(specifier, base);
+    if (resolved.isValid())
+        return resolved.string();
+    if (!base.isValid())
+        return resolveWithoutMap();
+    return makeUnexpected(makeString("Failed to resolve module specifier \""_s, specifier, "\": the import map blocks or does not map it, and it is not a URL or a path starting with \"/\", \"./\", or \"../\". Referenced from: "_s, base.string()));
+}
