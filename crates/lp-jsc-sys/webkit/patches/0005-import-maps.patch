+bool JSGlobalContextAddImportMap(JSGlobalContextRef ctx, JSStringRef source, JSStringRef baseURL, JSStringRef* messages)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* apiGlobalObject = dynamicDowncast<JSAPIGlobalObject>(globalObject);
+    if (!apiGlobalObject)
+        return false;
+
+    ImportMapMessages reporter;
+    URL base { { }, baseURL->string() };
+    auto sourceCode = makeSource(source->string(), SourceOrigin { base }, SourceTaintedOrigin::Untainted);
+    auto parsed = ImportMap::parseImportMapString(sourceCode, base, reporter);
+    if (parsed) {
+        apiGlobalObject->importMap().mergeExistingAndNewImportMaps(WTF::move(*parsed), reporter);
+        apiGlobalObject->didAddImportMap();
+    }
+    if (messages) {
+        String joined = reporter.joined();
+        *messages = joined.isEmpty() ? nullptr : OpaqueJSString::tryCreate(joined).leakRef();
+    }
+    return !!parsed;
 }
 
