+class ImportMapMessages final : public ImportMap::Reporter {
+public:
+    void reportWarning(const String& message) const final { add(message); }
+    void reportError(const String& message) const final { add(message); }
+    String joined() const { return m_messages.toString(); }
+
+private:
+    void add(const String& message) const
+    {
+        if (!m_messages.isEmpty())
+            m_messages.append('\n');
+        m_messages.append(message);
+    }
+    mutable StringBuilder m_messages;
+};
+
+}
