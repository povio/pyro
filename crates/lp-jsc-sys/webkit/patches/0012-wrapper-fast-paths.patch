+/*
+ * Lightningpanda: fast paths for host-object members. The C API reaches a wrapper's
+ * accessors and operations through JSCallbackObject, whose property lookups and calls
+ * cannot be inline-cached or call-linked: every DOM getter costs a C++ slow path. These
+ * entry points give an embedder what WebCore's bindings have.
+ */
+
+/* A custom accessor on `object` (normally a prototype): the property is a
+   CustomGetterSetter with the CustomAccessor attribute, so inline caches call `getter`
+   directly with the receiver as `thisValue` (a JSValueRef holding any value, also
+   primitives, proxies and objects of other classes: the callback must check it), and
+   Object.getOwnPropertyDescriptor reifies it as a real getter/setter function pair.
+   `propertyNameUID` is the name's unique string pointer. Without `setter` the property
+   is read-only (strict-mode assignment throws). `attributes` honours DontEnum and
+   DontDelete. A callback that throws calls JSContextThrowException and returns
+   undefined (the getter) or false (the setter). Index-like names are refused. The
+   callbacks are called through the same pointer each time, so each (object, name)
+   pair should get its own, or the reified functions of same-named properties are
+   indistinguishable. */
+typedef JSValueRef (*JSCustomGetterCallback)(JSContextRef ctx, JSValueRef thisValue, const void* propertyNameUID);
+typedef bool (*JSCustomSetterCallback)(JSContextRef ctx, JSValueRef thisValue, JSValueRef value, const void* propertyNameUID);
+JS_EXPORT bool JSObjectSetCustomAccessor(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSCustomGetterCallback getter, JSCustomSetterCallback setter, JSPropertyAttributes attributes);
+
