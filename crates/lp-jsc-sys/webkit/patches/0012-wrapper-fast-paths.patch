+
+/* Indexed properties of a class's objects (`list[3]`): consulted for integer-index
+   reads and writes, and for names that parse as an index, before and instead of the
+   getProperty/setProperty hooks, which never see such names. `getPropertyByIndex`
+   returns NULL for no such property. A class whose only hooks are these two and
+   getPropertyNames keeps cacheable wrappers (its named lookups are ordinary). Set
+   right after JSClassCreate, before the first object of the class exists. */
+typedef JSValueRef (*JSObjectGetPropertyByIndexCallback)(JSContextRef ctx, JSObjectRef object, unsigned index, JSValueRef* exception);
+typedef bool (*JSObjectSetPropertyByIndexCallback)(JSContextRef ctx, JSObjectRef object, unsigned index, JSValueRef value, JSValueRef* exception);
+JS_EXPORT void JSClassSetIndexedCallbacks(JSClassRef jsClass, JSObjectGetPropertyByIndexCallback getPropertyByIndex, JSObjectSetPropertyByIndexCallback setPropertyByIndex);
+
