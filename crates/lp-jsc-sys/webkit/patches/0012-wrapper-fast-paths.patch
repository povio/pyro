+bool JSObjectSetCustomAccessor(JSContextRef ctx, JSObjectRef object, JSStringRef propertyName, JSCustomGetterCallback getter, JSCustomSetterCallback setter, JSPropertyAttributes attributes)
+{
+    if (!ctx || !object || !propertyName || !getter)
+        return false;
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    JSObject* jsObject = toJS(object);
+    Identifier name = propertyName->identifier(&vm);
+    if (parseIndex(name))
+        return false;
+    unsigned attrs = static_cast<unsigned>(PropertyAttribute::CustomAccessor);
+    if (attributes & kJSPropertyAttributeDontEnum)
+        attrs |= static_cast<unsigned>(PropertyAttribute::DontEnum);
+    if (attributes & kJSPropertyAttributeDontDelete)
+        attrs |= static_cast<unsigned>(PropertyAttribute::DontDelete);
+    // Like an accessor without a setter: strict-mode assignment throws, sloppy is ignored.
+    if (!setter)
+        attrs |= static_cast<unsigned>(PropertyAttribute::ReadOnly);
+    // The C signatures are the custom accessor ABI: JSContextRef is the JSGlobalObject*, a
+    // JSValueRef its encoded value (64-bit), the uid the PropertyName's pointer.
+    static_assert(sizeof(JSValueRef) == sizeof(EncodedJSValue), "custom accessor callbacks pass encoded values");
+    static_assert(sizeof(PropertyName) == sizeof(void*), "custom accessor callbacks pass the uid pointer");
+    GetValueFunc getValue(reinterpret_cast<EncodedJSValue (*)(JSGlobalObject*, EncodedJSValue, PropertyName)>(getter));
+    PutValueFunc putValue = setter ? PutValueFunc(reinterpret_cast<bool (*)(JSGlobalObject*, EncodedJSValue, EncodedJSValue, PropertyName)>(setter)) : PutValueFunc(nullptr);
+    CustomGetterSetter* accessor = CustomGetterSetter::create(vm, getValue, putValue);
+    return jsObject->putDirectCustomAccessor(vm, name, accessor, attrs);
+}
