+const void* JSValueGetStringCharacters(JSContextRef ctx, JSValueRef value, size_t* length, bool* is8Bit)
+{
+    if (!ctx || !value)
+        return nullptr;
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSValue v = toJS(globalObject, value);
+    if (!v.isString())
+        return nullptr;
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    // Resolves a rope once; the flat string stays cached in the cell.
+    const String& string = asString(v)->value(globalObject);
+    RETURN_IF_EXCEPTION(scope, nullptr);
+    if (string.isNull())
+        return nullptr;
+    StringImpl* impl = string.impl();
+    if (length)
+        *length = impl->length();
+    if (is8Bit)
+        *is8Bit = impl->is8Bit();
+    if (impl->is8Bit())
+        return impl->span8().data();
+    return impl->span16().data();
+}
