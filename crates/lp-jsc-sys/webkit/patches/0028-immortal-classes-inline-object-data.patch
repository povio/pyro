 namespace JSC {
 
+// Lightningpanda: a member of the object's cell (it was a heap allocation of its own, made and
+// freed with every object), and it counts no reference to a class that is never released
+// (kJSClassAttributeImmortal): the count is one atomic word that every thread making or
+// sweeping wrappers of a class shared by the process would write.
 struct JSCallbackObjectData {
-    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(JSCallbackObjectData);
+    WTF_MAKE_NONCOPYABLE(JSCallbackObjectData);
 public:
     JSCallbackObjectData(void* privateData, JSClassRef jsClass)
         : privateData(privateData)
         , jsClass(jsClass)
     {
-        JSClassRetain(jsClass);
+        if (!jsClass->immortal)
+            JSClassRetain(jsClass);
     }
     
     ~JSCallbackObjectData()
     {
-        JSClassRelease(jsClass);
+        if (!jsClass->immortal)
+            JSClassRelease(jsClass);
     }
     
     JSValue getPrivateProperty(const Identifier& propertyName) const
@@ -173,7 +180,7 @@ public:
 
