diff --git a/Source/JavaScriptCore/API/JSForkPrivate.h b/Source/JavaScriptCore/API/JSForkPrivate.h
index 27c078107a..526e01ca49 100644
--- a/Source/JavaScriptCore/API/JSForkPrivate.h
+++ b/Source/JavaScriptCore/API/JSForkPrivate.h
@@ -237,6 +237,12 @@ JS_EXPORT const void* JSValueGetStringCharacters(JSContextRef ctx, JSValueRef va
    watches the name, and announcing the name drops the caches. */
 #define kJSClassAttributeImpureNamedProperties (1u << 30)
 
+/* A JSClassDefinition attribute: the embedder never releases the class (one made once per
+   process and shared by its context groups), so its objects count no reference to it: each
+   would write the class's reference count when made and when swept, from whichever thread
+   runs its context group. Releasing such a class while an object of it lives is an error. */
+#define kJSClassAttributeImmortal (1u << 29)
+
 /* Announces that a wrapper of a kJSClassAttributeImpureNamedProperties class may now answer
    `propertyName`: inline caches and compiled code that assumed otherwise are dropped. Cheap
    when nothing watches the name. May not run JavaScript; callable with the DOM borrowed. */
