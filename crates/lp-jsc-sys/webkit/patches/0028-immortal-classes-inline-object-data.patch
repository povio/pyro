@@ -264,7 +271,7 @@ private:
  
     JSValue getStaticValue(JSGlobalObject*, PropertyName);
 
-    std::unique_ptr<JSCallbackObjectData> m_callbackObjectData;
+    JSCallbackObjectData m_callbackObjectData;
     const ClassInfo* m_classInfo { nullptr };
 };
 
