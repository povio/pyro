+/* A copy of `string` for a property name used again and again: the property-name APIs
+   (JSObjectGetProperty, JSObjectSetPrivateProperty and the rest) keep the identifier they
+   make for it and reuse it, instead of hashing the characters and probing the atom table on
+   every call. For names an embedder keeps for the life of the thread; use it on one thread.
+   It keeps the atom of the first VM it is used with (others take the usual path) until that
+   VM's atom table is destroyed. */
+JS_EXPORT JSStringRef JSStringCreateAtom(JSStringRef string);
+
 /* A function object (an ordinary internal function, which call inline caches link to
    directly) that calls `callback` with `data`. `name` and `length` are its own
    properties. The function has no finalizer: `data` must outlive it. */
diff --git a/Source/JavaScriptCore/API/JSLockIfNeeded.h b/Source/JavaScriptCore/API/JSLockIfNeeded.h
new file mode 100644
index 0000000000..ceaf29def2
--- /dev/null
+++ b/Source/JavaScriptCore/API/JSLockIfNeeded.h
@@ -0,0 +1,31 @@
+/*
+ * Lightningpanda: the C API's lock for calls made from inside a callback.
+ */
+
+#pragma once
+
+#include "JSLock.h"
+#include "VM.h"
+#include <optional>
+
+namespace JSC {
+
+// What JSLockHolder does for an API entry, minus its cost when the thread already holds the
+// VM's lock (every call an embedder makes from inside a callback, as patch 0009 keeps the lock
+// there): JSLockHolder then only bumps the lock count, but pays a VM ref and an apiLock ref
+// and their releases (atomic operations) and a failed tryLock. The VM stays alive meanwhile:
+// whoever took the lock further up the stack keeps it.
+class JSLockIfNeeded {
+    WTF_MAKE_NONCOPYABLE(JSLockIfNeeded);
+public:
+    ALWAYS_INLINE explicit JSLockIfNeeded(VM& vm)
+    {
+        if (!vm.apiLock().currentThreadIsHoldingLock()) [[unlikely]]
+            m_holder.emplace(vm);
+    }
+
+private:
+    std::optional<JSLockHolder> m_holder;
+};
+
+} // namespace JSC
