+    // the atom stops being one (AtomStringTable's destructor clears the flag), which
+    // identifier() checks. At most one such leaked string per name per atom table.
+    bool m_remembersIdentifier { false };
+    mutable AtomStringImpl* m_identifier { nullptr };
+    mutable const void* m_identifierTable { nullptr };
+
     // This will be initialized on demand when characters() is called if the string needs up-conversion.
