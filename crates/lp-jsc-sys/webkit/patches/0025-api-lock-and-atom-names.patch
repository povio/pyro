diff --git a/Source/JavaScriptCore/API/OpaqueJSString.cpp b/Source/JavaScriptCore/API/OpaqueJSString.cpp
index d807e952f7..250d5ea203 100644
--- a/Source/JavaScriptCore/API/OpaqueJSString.cpp
+++ b/Source/JavaScriptCore/API/OpaqueJSString.cpp
@@ -28,6 +28,7 @@
 
 #include "Identifier.h"
 #include "IdentifierInlines.h"
+#include "VM.h"
 #include <wtf/MallocSpan.h>
 #include <wtf/text/StringView.h>
 
@@ -74,6 +75,22 @@ Identifier OpaqueJSString::identifier(VM* vm) const
         return Identifier();
     if (m_string.isEmpty())
         return Identifier(Identifier::EmptyIdentifierFlag::EmptyIdentifier);
+    // Lightningpanda (JSStringCreateAtom): the identifier made last time, if it is still an
+    // atom of this VM's table (the current one: callers hold the VM's lock), so no hashing and
+    // no atom-table probe.
+    if (m_remembersIdentifier) {
+        const void* table = vm->atomStringTable();
+        if (m_identifier && m_identifierTable == table && m_identifier->isAtom()) [[likely]]
+            return Identifier::fromString(*vm, m_identifier);
+        Identifier identifier = m_string.is8Bit() ? Identifier::fromString(*vm, m_string.span8()) : Identifier::fromString(*vm, m_string.span16());
+        // Remember the first table's atom; replace it only once that table is gone.
+        if (!m_identifier || !m_identifier->isAtom()) {
+            m_identifier = static_cast<AtomStringImpl*>(identifier.impl());
+            m_identifier->ref();
+            m_identifierTable = table;
+        }
+        return identifier;
+    }
     if (m_string.is8Bit())
         return Identifier::fromString(*vm, m_string.span8());
     return Identifier::fromString(*vm, m_string.span16());
