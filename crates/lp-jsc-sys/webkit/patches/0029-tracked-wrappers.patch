+JSObjectRef JSObjectMakeTrackedWrapper(JSContextRef ctx, JSWrapperShapeRef shape, JSClassRef jsClass, JSValueRef prototypeRef, void* data, unsigned char* flags)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockIfNeeded locker(vm);
+    if (!jsClass->immortal) [[unlikely]]
+        return nullptr;
+    JSCallbackObject<JSNonFinalObject>* object;
+    if (shape) [[likely]] {
+        // A shape serves the global object that made it only, as in JSObjectMakeWrapper.
+        if (shape->structure->realm() != globalObject || shape->jsClass.get() != jsClass) [[unlikely]]
+            return nullptr;
+        object = JSCallbackObject<JSNonFinalObject>::createTracked(globalObject, shape->structure.get(), jsClass, data);
+    } else {
+        Structure* structure = globalObject->callbackObjectStructure();
+        if (Options::cacheCallbackObjectLookups()) {
+            if (jsClass->wrappersAreCacheable)
+                structure = globalObject->cacheableCallbackObjectStructure();
+            else if (jsClass->impureNamedProperties)
+                structure = globalObject->impureNamedCallbackObjectStructure();
+        }
+        object = JSCallbackObject<JSNonFinalObject>::createTracked(globalObject, structure, jsClass, data);
+        JSValue prototype = prototypeRef ? toJS(globalObject, prototypeRef) : JSValue();
+        if (prototype && (prototype.isObject() || prototype.isNull()))
+            object->setPrototypeDirect(vm, prototype);
+        else if (JSObject* classPrototype = jsClass->prototype(globalObject))
+            object->setPrototypeDirect(vm, classPrototype);
+    }
+    vm.heap.addTrackedWrapper(object, data, flags);
+    return toRef(object);
+}
