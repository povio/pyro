+template<typename Visitor>
+void Heap::visitKeptTrackedWrappers(Visitor& visitor)
+{
+    // An old object stays marked through an eden collection.
+    size_t begin = m_collectionScope && *m_collectionScope == CollectionScope::Eden ? m_oldTrackedWrappers : 0;
+    size_t end = m_trackedWrappers.size();
+    for (size_t i = begin; i < end; ++i) {
+        auto& entry = m_trackedWrappers[i];
+        // Written by the host's thread as a single byte store.
+        if (__atomic_load_n(entry.flags, __ATOMIC_RELAXED))
+            visitor.appendUnbarriered(entry.cell);
+    }
+}
+
+void Heap::reapTrackedWrappers()
+{
+    size_t size = m_trackedWrappers.size();
+    size_t begin = m_collectionScope && *m_collectionScope == CollectionScope::Eden ? m_oldTrackedWrappers : 0;
+    HeapVersion markingVersion = m_objectSpace.markingVersion();
+    size_t out = begin;
+    size_t dead = 0;
+    for (size_t i = begin; i < size; ++i) {
+        auto entry = m_trackedWrappers[i];
+        if (isMarked(markingVersion, entry.cell)) {
+            m_trackedWrappers[out++] = entry;
+            continue;
+        }
+        // Nothing reaches the object and its cell is swept without a call: all that it owns
+        // outside the heap is taken here.
+        __atomic_store_n(entry.flags + 1, static_cast<unsigned char>(1), __ATOMIC_RELAXED);
+        m_deadTrackedWrappers.append(entry.data);
+        if (void* properties = static_cast<JSCallbackObject<JSNonFinalObject>*>(entry.cell)->takePrivateProperties())
+            m_deadTrackedWrapperProperties.append(properties);
+        ++dead;
+    }
+    m_trackedWrappers.shrink(out);
+    m_oldTrackedWrappers = out;
+    if (dead)
+        m_deadTrackedWrapperCount.fetch_add(dead, std::memory_order_relaxed);
+}
+
+void Heap::destroyDeadTrackedWrapperProperties()
+{
+    for (void* properties : std::exchange(m_deadTrackedWrapperProperties, { }))
+        JSCallbackObject<JSNonFinalObject>::destroyPrivateProperties(properties);
+}
+
+size_t Heap::takeDeadTrackedWrappers(void** buffer, size_t capacity)
+{
+    destroyDeadTrackedWrapperProperties();
+    size_t available = m_deadTrackedWrappers.size() - m_deadTrackedWrappersTaken;
+    size_t count = std::min(available, capacity);
+    for (size_t i = 0; i < count; ++i)
+        buffer[i] = m_deadTrackedWrappers[m_deadTrackedWrappersTaken + i];
+    m_deadTrackedWrappersTaken += count;
+    if (m_deadTrackedWrappersTaken == m_deadTrackedWrappers.size()) {
+        m_deadTrackedWrappers.shrink(0);
+        m_deadTrackedWrappersTaken = 0;
+    }
+    m_deadTrackedWrapperCount.fetch_sub(count, std::memory_order_relaxed);
+    return count;
+}
+
+void Heap::releaseTrackedWrappers(JSGlobalObject* globalObject)
+{
+    for (auto& entry : m_trackedWrappers) {
+        if (entry.cell->structure()->realm() == globalObject)
+            __atomic_store_n(entry.flags, static_cast<unsigned char>(0), __ATOMIC_RELAXED);
+    }
+}
+
+size_t Heap::takeAllTrackedWrappers(void** buffer, size_t capacity)
+{
+    destroyDeadTrackedWrapperProperties();
+    size_t count = 0;
+    while (count < capacity && !m_trackedWrappers.isEmpty()) {
+        auto entry = m_trackedWrappers.takeLast();
+        auto* object = static_cast<JSCallbackObject<JSNonFinalObject>*>(entry.cell);
+        // The object may live on (nothing collected it): it is a wrapper of nothing from now.
+        object->clearPrivateData();
+        if (void* properties = object->takePrivateProperties())
+            JSCallbackObject<JSNonFinalObject>::destroyPrivateProperties(properties);
+        __atomic_store_n(entry.flags, static_cast<unsigned char>(0), __ATOMIC_RELAXED);
+        __atomic_store_n(entry.flags + 1, static_cast<unsigned char>(1), __ATOMIC_RELAXED);
+        buffer[count++] = entry.data;
+    }
+    m_oldTrackedWrappers = std::min(m_oldTrackedWrappers, m_trackedWrappers.size());
+    return count;
+}
