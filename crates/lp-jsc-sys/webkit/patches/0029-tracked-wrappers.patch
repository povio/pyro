+template <>
+JSCallbackObject<JSNonFinalObject>* JSCallbackObject<JSNonFinalObject>::createTracked(JSGlobalObject* globalObject, Structure* structure, JSClassRef classRef, void* data)
+{
+    VM& vm = getVM(globalObject);
+    ASSERT(classRef->immortal);
+    JSCell* cell = static_cast<JSCell*>(vm.trackedCallbackObjectSpace<SubspaceAccess::OnMainThread>()->allocate(vm, WTF::roundUpToMultipleOf<atomSize>(sizeof(JSCallbackObject)), nullptr, AllocationFailureMode::Assert));
+    cell->clearStructure();
+    JSCallbackObject* callbackObject = new (NotNull, cell) JSCallbackObject(globalObject, structure, classRef, data);
+    if (classRef->objectsNeedInit) [[unlikely]]
+        callbackObject->finishCreation(globalObject);
+    else {
+        // finishCreation less the walk of the class chain that finds nothing to do.
+        callbackObject->Base::finishCreation(vm);
+        callbackObject->m_classInfo = callbackObject->classInfo();
+    }
+    return callbackObject;
+}
