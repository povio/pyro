+/* Lightningpanda: a tracked wrapper. A new object of `jsClass` with private data `data` in the
+   global object of `ctx`, with the structure of `shape` (JSWrapperShapeCreate, of the same
+   class and global object) or, when `shape` is NULL, of JSObjectMake followed by
+   JSObjectSetPrototype(`prototype`). The class must have kJSClassAttributeImmortal. The
+   object's cell has no destructor: the class's finalize callback is not called for it and the
+   host never hears of one object ending. Instead the host gives two bytes that must outlive
+   the object's entry (below):
+     flags[0], written by the host from the VM's thread: while nonzero the object is kept
+       alive, as with JSWeakCreateKeptWhile.
+     flags[1], written by the collector, zero at the call: nonzero once a collection found
+       the object dead. From then the host must not use the JSObjectRef. A host that reads
+       this byte before every use of an object it did not get from JavaScript holds, in
+       effect, a weak reference that costs nothing to make or drop.
+   A dead object's `data` is handed back, once, by JSContextGroupTakeDeadTrackedWrappers: that
+   ends its entry. Returns NULL, making nothing, when the class is not immortal or `shape` is
+   of another class or global object. */
+JS_EXPORT JSObjectRef JSObjectMakeTrackedWrapper(JSContextRef ctx, JSWrapperShapeRef shape, JSClassRef jsClass, JSValueRef prototype, void* data, unsigned char* flags);
+/* Where the group keeps the number of dead tracked wrappers not taken yet: valid while the
+   group lives, read (never written) by the host from any thread as one relaxed load. A host
+   that asks after every callback whether it has payloads to free asks without a call. */
+JS_EXPORT const size_t* JSContextGroupDeadTrackedWrapperCounter(JSContextGroupRef);
+/* Writes the `data` of up to `capacity` dead tracked wrappers to `buffer` and returns how many. */
+JS_EXPORT size_t JSContextGroupTakeDeadTrackedWrappers(JSContextGroupRef, void** buffer, size_t capacity);
+/* Clears flags[0] of every live tracked wrapper made in the global object of `ctx`. */
+JS_EXPORT void JSContextReleaseTrackedWrappers(JSContextRef ctx);
+/* For a host about to drop everything: ends the entry of every live tracked wrapper, as if
+   dead (flags[1] set, `data` written to `buffer`), and clears the objects' private data, so a
+   callback reached through one that is still alive sees an object of no host data. Returns how
+   many were written; call until it returns less than `capacity`. */
+JS_EXPORT size_t JSContextGroupTakeAllTrackedWrappers(JSContextGroupRef, void** buffer, size_t capacity);
