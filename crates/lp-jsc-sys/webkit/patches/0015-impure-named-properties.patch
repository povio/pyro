+/* A JSClassDefinition attribute: the class's property hooks answer only names the embedder
+   announces with JSAddImpureProperty before they can first be answered (a document's named
+   elements), they never answer a name its prototype chain has, and the class (with its
+   parents) has no call, construct, static value or static function. Its wrappers' lookups
+   are then cacheable, as WebCore's for HTMLDocument: an inline cache that remembers a lookup
+   watches the name, and announcing the name drops the caches. */
+#define kJSClassAttributeImpureNamedProperties (1u << 30)
+
+/* Announces that a wrapper of a kJSClassAttributeImpureNamedProperties class may now answer
+   `propertyName`: inline caches and compiled code that assumed otherwise are dropped. Cheap
+   when nothing watches the name. May not run JavaScript; callable with the DOM borrowed. */
+JS_EXPORT void JSAddImpureProperty(JSContextRef ctx, JSStringRef propertyName);
+
 #ifdef __cplusplus
 }
 #endif
