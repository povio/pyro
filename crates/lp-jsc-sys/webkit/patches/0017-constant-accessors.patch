+template<typename Visitor>
+void CustomGetterSetter::visitChildrenImpl(JSCell* cell, Visitor& visitor)
+{
+    CustomGetterSetter* thisObject = uncheckedDowncast<CustomGetterSetter>(cell);
+    ASSERT_GC_OBJECT_INHERITS(thisObject, info());
+    Base::visitChildren(thisObject, visitor);
+    visitor.append(thisObject->m_constant);
+}
+
+DEFINE_VISIT_CHILDREN(CustomGetterSetter);
+
+CustomGetterSetter* CustomGetterSetter::createConstant(VM& vm, CustomGetter customGetter, CustomSetter customSetter, JSValue constant)
+{
+    CustomGetterSetter* customGetterSetter = create(vm, customGetter, customSetter);
+    customGetterSetter->m_constant.set(vm, customGetterSetter, constant);
+    return customGetterSetter;
+}
+
 } // namespace JSC
