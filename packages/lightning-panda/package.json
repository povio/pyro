{
  "name": "@povio/lightning-panda",
  "version": "0.0.17",
  "description": "Lightningpanda headless browser and typed E2E testing API",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/povio/lightningpanda.git",
    "directory": "packages/lightning-panda"
  },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "bin": { "lightningpanda": "./dist/cli.js" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/playwright/test.d.ts",
      "bun": "./src/playwright/test.ts",
      "default": "./dist/playwright/test.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "bun": "./src/playwright/index.ts",
      "default": "./dist/playwright/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LLM.md",
    "native",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts src/playwright/test.ts src/playwright/index.ts --root src --outdir dist --target node --format esm --external bun:test --splitting && tsc -p tsconfig.json",
    "prepack": "bun run build && node ../../scripts/npm/prepare-package.mjs",
    "test:package": "bun test test/binary.test.ts && node --test ../../scripts/npm/release.test.mjs",
    "test": "bun test ./test",
    "test:playwright": "LP_CONFIG=test/playwright/playwright.config.ts bun test ./test/playwright/*.pw.ts",
    "test:parity": "PW_ENGINE=chromium-cdp playwright test -c test/playwright"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.59.1",
    "typescript": "^5.6.0"
  }
}
