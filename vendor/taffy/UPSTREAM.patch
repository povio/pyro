+                            inline_measures += 1;
+                        }
+                        let width = match leaf {
+                            Leaf::Text => match available.width {
+                                AvailableSpace::MinContent => 100.0,
+                                AvailableSpace::MaxContent => 300.0,
+                                AvailableSpace::Definite(width) => width.clamp(100.0, 300.0),
