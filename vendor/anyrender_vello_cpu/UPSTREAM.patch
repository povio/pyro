+        let (Ok(width), Ok(height)) = (u16::try_from(region.width()), u16::try_from(region.height())) else {
+            self.replay(inner, transform);
+            return;
+        };
+        let to_pixels = Affine::translate((-f64::from(region.x0), -f64::from(region.y0)));
