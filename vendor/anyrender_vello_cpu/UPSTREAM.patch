+        self.render_ctx.set_fill_rule(Fill::NonZero);
+        self.render_ctx.set_paint(PaintType::Image(ImageBrush {
+            image: ImageSource::Pixmap(Arc::new(pixels)),
+            sampler: ImageSampler::new().with_quality(ImageQuality::Medium),
+        }));
