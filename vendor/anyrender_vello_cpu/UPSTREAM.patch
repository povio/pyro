+                        layer.fill,
+                        layer.blend,
+                        layer.alpha * plan.alpha(),
+                        transform * layer.transform,
+                        &layer.clip,
+                        None,
+                        None,
+                    );
+                    match recolor {
+                        Some(_) => inner.iter().for_each(|command| self.replay_command(command, transform, recolor)),
+                        None => self.replay(inner, transform),
