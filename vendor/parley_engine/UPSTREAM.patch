+    let LineBreakContext {
+        before_before,
+        before,
+        after,
+        ..
+    } = cx;
+    (before == '-' && after.is_ascii_digit() && before_before.is_some_and(|c| c.is_ascii_alphanumeric()))
+        .then_some(true)
+}
