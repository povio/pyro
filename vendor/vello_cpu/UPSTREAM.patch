+    /// pyro: 16 pixels of `bg` with `layers` (premultiplied) composited over them in turn, unmasked
+    /// and through a mask of full coverage (an antialiased edge strip's covered pixels).
+    fn composite(bg: [u8; 4], layers: &[[u8; 4]]) -> ([u8; 4], [u8; 4]) {
+        let mut plain = [bg; 16].concat();
+        let mut masked = plain.clone();
+        dispatch!(Level::try_detect().unwrap_or(Level::baseline()), simd => {
+            for &layer in layers {
+                fill::alpha_composite_solid(simd, &mut plain, layer);
