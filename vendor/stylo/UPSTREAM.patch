+            Self::FitContentFunction(value) => {
+                dest.write_str("fit-content(")?;
+                value.to_css(dest)?;
+                return dest.write_char(')');
+            },
+        };
+        write!(dest, "calc-size({basis}, ")?;
+        calculation.calculation_css::<true, _>(dest)?;
