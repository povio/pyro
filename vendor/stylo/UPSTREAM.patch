+    /// lightningpanda: reset properties the style inherits explicitly, with
+    /// the parent's values: `*, ::before, ::after { box-sizing: inherit }`
+    /// (MUI's and many resets' pattern, on every element) and the UA's
+    /// `td, th, tr { vertical-align: inherit }`. A cached style serves an
+    /// element whose parent has the same values.
+    inherited_resets: SmallVec<[InheritedReset; 1]>,
 }
 
+macro_rules! inherited_resets {
+    ($($variant:ident, $clone:ident, $ty:ty;)*) => {
+        /// lightningpanda: a reset property inherited explicitly, with the parent's value.
+        #[derive(Clone, Debug, PartialEq)]
+        pub enum InheritedReset {
+            $(
+                #[allow(missing_docs)]
+                $variant($ty),
+            )*
+        }
+
+        impl InheritedReset {
+            /// Whether `parent` has the same value.
+            fn matches(&self, parent: &ComputedValues) -> bool {
+                match self {
+                    $(Self::$variant(v) => parent.$clone() == *v,)*
+                }
+            }
+        }
+    };
+}
+
+inherited_resets! {
+    BoxSizing, slow_clone_box_sizing, crate::computed_values::box_sizing::T;
+    BaselineShift, slow_clone_baseline_shift, crate::computed_values::baseline_shift::T;
+    BaselineSource, slow_clone_baseline_source, crate::computed_values::baseline_source::T;
+    AlignmentBaseline, slow_clone_alignment_baseline, crate::computed_values::alignment_baseline::T;
+}
