+    impl WhiteSpaceTrim: u8 {
+        /// Nothing is discarded.
+        const NONE = 0;
+        /// The collapsible white space immediately before the box's start.
+        const DISCARD_BEFORE = 1 << 0;
+        /// The collapsible white space immediately after the box's end.
