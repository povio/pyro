+pub(crate) fn serialize_for_reparse<T>(f: impl FnOnce() -> T) -> (T, bool) {
+    struct Restore<'a>(&'a std::cell::Cell<Option<bool>>, Option<bool>);
+    impl Drop for Restore<'_> {
