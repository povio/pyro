+#[derive(Debug, Clone, Default)]
+struct EdgeLine {
+    /// Sorted, disjoint `(start, end, edge)`, no edge `CollapsedEdge::NONE`.
+    runs: Vec<(u32, u32, CollapsedEdge)>,
