+    for at in (g0..g0 + prefix).chain(g1 - suffix..g1) {
+        if !single(at, changes) {
+            return false;
+        }
+    }
+    if prefix + suffix < old.len().max(rows.len()) {
+        changes.push(RowChange {
+            old: g0 + prefix..g1 - suffix,
+            rows: rows[prefix..rows.len() - suffix].to_vec(),
+            group: Some(group),
+        });
+    }
+    true
