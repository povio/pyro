+        let guess_percent: f32 = (0..n).map(|c| share(c).unwrap_or(min[c])).sum();
+        let guess_fixed: f32 = (0..n).map(|c| share(c).unwrap_or(if fixed[c] { max[c] } else { min[c] })).sum();
+        let guess_max: f32 = (0..n).map(|c| share(c).unwrap_or(max[c])).sum();
