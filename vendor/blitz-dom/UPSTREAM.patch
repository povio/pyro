+            },
+            ImageData::None => None,
+        },
+        _ if element.name.local == local_name!("canvas") => {
+            let attr = |name| element.attr(name).and_then(|value| value.trim().parse::<f32>().ok());
+            usable(attr(local_name!("width")).unwrap_or(300.0) / attr(local_name!("height")).unwrap_or(150.0))
+        }
+        _ => None,
+    }
