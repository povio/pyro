+        assert_eq!(columns.strip_to_columns(Point { x: 10.0, y: 150.0 }), Point { x: 130.0, y: 50.0 });
+        assert_eq!(columns.columns_to_strip(Point { x: 130.0, y: 50.0 }), Point { x: 10.0, y: 150.0 });
+        // In the gap's second half: the second column.
