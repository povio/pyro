+/// components are scaled, linear components are not.
+fn to_device_px(t: Affine, scale: f32) -> Affine {
+    let scale = scale as f64;
+    let [m11, m12, m21, m22, m41, m42] = t.as_coeffs();
+    Affine::new([m11, m12, m21, m22, m41 * scale, m42 * scale])
+}
