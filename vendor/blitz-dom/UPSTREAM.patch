+        use style::values::computed::text::TextEmphasisStyle;
+        if !matches!(style.get_inherited_text().text_emphasis_style, TextEmphasisStyle::None) {
+            self.found.push((node_id, TextAnnotationKind::Emphasis, node_id));
+        }
+    }
