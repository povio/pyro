+/// pyro: whether table part `node_id` (a row group, row or cell) is relatively positioned or
+/// sticky: it paints as a positioned box, with its cells (a row group and a row have no boxes of
+/// their own), and is the containing block of the absolutely positioned boxes in it.
+pub(crate) fn is_positioned_table_part(doc: &BaseDocument, node_id: NodeId) -> bool {
+    use style::computed_values::position::T as Position;
+    doc.nodes
+        .get(node_id)
+        .and_then(|node| node.primary_styles())
+        .is_some_and(|style| matches!(style.clone_position(), Position::Relative | Position::Sticky))
+}
+
+/// pyro: whether some row or row group of `table` is positioned ([`is_positioned_table_part`]).
+pub(crate) fn table_has_positioned_parts(doc: &BaseDocument, table: &TableContext) -> bool {
+    table.rows.iter().any(|row| {
+        is_positioned_table_part(doc, row.node_id) || row.group.is_some_and(|group| is_positioned_table_part(doc, group))
+    })
+}
+
+/// pyro: the offset relative positioning (CSS 2.1 § 9.4.3) gives table part `node_id` (a cell,
+/// row or row group) by its own insets, `None` when it is not relatively positioned. A percentage
+/// `top` or `bottom` resolves against the height `parent` (the row for a cell, the row group for a
+/// row, the table for a row group) is given as a length, else it is `auto`, as in Chromium (WPT
+/// `position-relative-010` to `-013`); a percentage `left` or `right` is `auto` (the width it would
+/// resolve against is not known yet).
+pub(crate) fn table_part_relative_offset(
+    doc: &BaseDocument,
+    node_id: NodeId,
+    parent: Option<NodeId>,
+) -> Option<taffy::Point<f32>> {
+    use style::computed_values::direction::T as Direction;
+    use style::computed_values::position::T as Position;
+    use style::values::computed::Inset;
+    use style::values::generics::length::GenericSize;
+    let style = doc.nodes.get(node_id)?.primary_styles()?;
+    if style.clone_position() != Position::Relative {
+        return None;
+    }
+    let parent_height = parent
+        .and_then(|parent| doc.nodes.get(parent))
+        .and_then(|parent| parent.primary_styles())
+        .and_then(|parent| match parent.get_position().height {
+            GenericSize::LengthPercentage(ref height) => height.0.to_length().map(|length| length.px()),
+            _ => None,
+        });
+    let resolve = |inset: &Inset, basis: Option<f32>| match inset {
+        Inset::LengthPercentage(value) => match value.to_length() {
+            Some(length) => Some(length.px()),
+            None => basis.map(|basis| value.resolve(Length::new(basis)).px()),
+        },
+        _ => None,
+    };
+    let position = style.get_position();
+    let (left, right) = (resolve(&position.left, None), resolve(&position.right, None));
+    let (top, bottom) = (resolve(&position.top, parent_height), resolve(&position.bottom, parent_height));
+    let x = match style.clone_direction() {
+        Direction::Rtl => right.map(|right| -right).or(left),
+        Direction::Ltr => left.or(right.map(|right| -right)),
+    };
+    Some(taffy::Point { x: x.unwrap_or(0.0), y: top.or(bottom.map(|bottom| -bottom)).unwrap_or(0.0) })
+}
+
+/// pyro: the row group row `row_id` is in (its parent, when that is one): known before
+/// `collect_table_cells` sets `TableRow::group`, after the group's rows.
+fn row_group_of(doc: &BaseDocument, row_id: NodeId) -> Option<NodeId> {
+    let parent = doc.nodes.get(row_id)?.parent?;
+    let display = doc.nodes.get(parent)?.display_style()?;
+    matches!(
+        display.inside(),
+        DisplayInside::TableRowGroup | DisplayInside::TableHeaderGroup | DisplayInside::TableFooterGroup
+    )
+    .then_some(parent)
+}
+
+/// pyro: the table `node_id` is in: its nearest ancestor that is a table (or itself).
+fn table_of(doc: &BaseDocument, node_id: NodeId) -> Option<NodeId> {
+    let mut current = Some(node_id);
+    while let Some(id) = current {
+        let node = doc.nodes.get(id)?;
+        if node.display_style().is_some_and(|display| display.inside() == DisplayInside::Table) {
+            return Some(id);
+        }
+        current = node.parent;
+    }
+    None
+}
+
+/// pyro: how far relative positioning moves table cell `cell_id`: its own offset and those of
+/// its row and row group (`row`: the row and its group), which have no boxes of their own and move
+/// their cells ([`table_part_relative_offset`]). `None` when none of them is relatively positioned.
+fn table_cell_relative_offset(
+    doc: &BaseDocument,
+    cell_id: NodeId,
+    row: Option<(NodeId, Option<NodeId>)>,
+) -> Option<taffy::Point<f32>> {
+    let (row, group) = row.map_or((None, None), |(row, group)| (Some(row), group));
+    let table = table_of(doc, cell_id);
+    let parts = [(Some(cell_id), row), (row, group.or(table)), (group, table)];
+    let mut offset: Option<taffy::Point<f32>> = None;
+    for (part, parent) in parts {
+        let Some(own) = part.and_then(|part| table_part_relative_offset(doc, part, parent)) else { continue };
+        let sum = offset.get_or_insert(taffy::Point::ZERO);
+        sum.x += own.x;
+        sum.y += own.y;
+    }
+    offset
+}
+
+impl BaseDocument {
+    /// pyro: the row group and row (`[group, row]`) of table cell `cell_id`, from its table's
+    /// context; `None` for a node that is no cell of a table laid out.
+    pub fn table_cell_parts(&self, cell_id: NodeId) -> Option<[Option<NodeId>; 2]> {
+        let node = self.nodes.get(cell_id)?;
+        let index = node.layout_data().table_cell_index;
+        if index == u32::MAX {
+            return None;
+        }
+        let table = node.layout_parent.get().and_then(|id| self.nodes.get(id))?;
+        let SpecialElementData::TableRoot(ctx) = &table.element_data()?.special_data else { return None };
+        let cell = ctx.cells.get(index as usize).filter(|cell| cell.node_id == cell_id)?;
+        let row = ctx.rows.get(cell.row as usize)?;
+        Some([row.group, Some(row.node_id)])
+    }
+
+    /// pyro: the containing block of the out-of-flow box `box_id` (`position` absolute or fixed)
+    /// below table `table_id`: the nearest ancestor of the box below the table that makes one for
+    /// it (positioned, transformed, ...). When that is a row or row group, which have no boxes of
+    /// their own, the table lays the box out against the part's area, and it paints in the part's
+    /// transform.
+    pub fn containing_block_below_table(
+        &self,
+        table_id: NodeId,
+        box_id: NodeId,
+        position: taffy::Position,
+    ) -> Option<NodeId> {
+        let mut current = self.nodes.get(box_id)?.parent;
+        loop {
+            let id = current?;
+            if id == table_id {
+                return None;
+            }
+            let node = self.nodes.get(id)?;
+            if node
+                .primary_styles()
+                .is_some_and(|style| stylo_taffy::convert::containing_block_claims(&style).for_position(position))
+            {
+                return Some(id);
+            }
+            current = node.parent;
+        }
+    }
+
+    /// pyro: the row group and row of table cell `cell_id` that are positioned (relative or
+    /// sticky): the cell paints with them, as positioned boxes paint, over their backgrounds.
+    pub fn table_cell_positioned_parts(&self, cell_id: NodeId) -> [Option<NodeId>; 2] {
+        self.table_cell_parts(cell_id)
+            .map_or([None, None], |parts| parts.map(|part| part.filter(|&part| is_positioned_table_part(self, part))))
+    }
+}
+
+/// pyro: nor does a table's `max-width` make it narrower than its columns' min-content widths (`content`,
+/// spacing included; `extra` its padding and borders): a width its flex or grid parent gives it beyond the
+/// maximum still stands up to them (CSS 2.1 §17.5.2, as in Blink; WPT `css/css-flexbox/table-as-item-*`).
+fn raise_max_width_to_columns(style: &mut taffy::Style<Atom>, content: f32, extra: f32, parent: Option<f32>) {
+    let grown = match style.box_sizing {
+        taffy::BoxSizing::ContentBox => content,
+        taffy::BoxSizing::BorderBox => content + extra,
+    };
+    use taffy::MaybeResolve;
+    if style.max_size.width.maybe_resolve(parent, resolve_calc_value).is_some_and(|max: f32| max < grown) {
+        style.max_size.width = style_helpers::length(grown);
+    }
+}
+
+/// pyro: a cell's own `min-width` as the width of its border box.
+fn cell_own_min_width(style: &taffy::Style<Atom>, parent: Option<f32>) -> Option<f32> {
+    use taffy::MaybeResolve as _;
+    style.min_size.width.maybe_resolve(parent, resolve_calc_value).map(|w| {
+        let padding = style.padding.resolve_or_zero(parent, resolve_calc_value);
+        let border = style.border.resolve_or_zero(parent, resolve_calc_value);
+        let extra = padding.left + padding.right + border.left + border.right;
+        match style.box_sizing {
+            taffy::BoxSizing::ContentBox => w + extra,
+            taffy::BoxSizing::BorderBox => w.max(extra),
+        }
+    })
+}
diff --git a/packages/blitz-dom/src/layout/table_fixup.rs b/packages/blitz-dom/src/layout/table_fixup.rs
new file mode 100644
--- /dev/null
+++ b/packages/blitz-dom/src/layout/table_fixup.rs
@@ -0,0 +1,490 @@
+//! pyro: the anonymous table objects of CSS 2.1 §17.2.1 (css-tables-3 §3.3, "fixup").
+//!
+//! - Consecutive table parts whose parent box is not a table (cells, rows, row groups, columns,
+//!   column groups and captions in a block container) are wrapped in an anonymous table
+//!   ([`wrap_misparented_table_parts`]).
+//! - The children of a table, row group or row that are not its proper children are wrapped in an
+//!   anonymous row (in a table or row group) or cell (in a row) ([`fixup_children`]).
+//!
+//! The anonymous boxes are nodes of the slab (`NodeData::AnonymousBlock`) styled as the UA sheet's
+//! `::-servo-anonymous-table`, `::-servo-anonymous-table-row` and `::-servo-anonymous-table-cell`
+//! boxes, with the box they are in as their parent style. Each is owned (`Node::anonymous_blocks`) by
+//! the box whose children it wraps, which frees it when it is built again; its `children` are the
+//! DOM nodes it wraps, whose `parent` stays their DOM parent (as with anonymous blocks).
+
+use blitz_traits::node_id::NodeId;
+use markup5ever::{local_name, ns, QualName};
+use style::{
+    data::ElementData as StyloElementData,
+    properties::ComputedValues,
+    selector_parser::PseudoElement,
+    shared_lock::StylesheetGuards,
+    values::specified::box_::{DisplayInside, DisplayOutside},
+};
+use thin_vec::ThinVec;
+
+use stylo_taffy::CopyStyleGetters;
+
+use crate::{node::NodeFlags, node::NodeKind, BaseDocument, ElementData, Node, NodeData};
+
+use super::damage::ALL_DAMAGE;
+
+/// A tabular container whose children are fixed up.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Level {
+    Table,
+    RowGroup,
+    Row,
+}
+
+/// What a child is to the table fixup.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Kind {
+    /// Generates no box (a comment, `display: none`).
+    Hidden,
+    /// White space that collapses away: dropped between table parts.
+    Space,
+    /// Absolutely positioned: laid out by the table (its `oof_children`), never wrapped.
+    OutOfFlow,
+    Caption,
+    /// A column or a column group.
+    Column,
+    RowGroup,
+    Row,
+    Cell,
+    /// A `display: contents` element: its children are in its place (`box_children`).
+    Contents,
+    /// Anything else: text, inline and block boxes, tables.
+    Other,
+}
+
+impl Kind {
+    /// A table-non-root box (css-tables-3): a proper table child or a cell.
+    fn is_table_non_root(self) -> bool {
+        matches!(self, Kind::Caption | Kind::Column | Kind::RowGroup | Kind::Row | Kind::Cell)
+    }
+
+    fn is_proper_child_of(self, level: Level) -> bool {
+        match level {
+            Level::Table => matches!(self, Kind::Caption | Kind::Column | Kind::RowGroup | Kind::Row),
+            Level::RowGroup => self == Kind::Row,
+            Level::Row => self == Kind::Cell,
+        }
+    }
+}
+
+/// What the node is to the table fixup.
+pub(crate) fn kind(doc: &BaseDocument, id: NodeId) -> Kind {
+    let node = &doc.nodes[id];
+    match node.data.kind() {
+        NodeKind::Comment => return Kind::Hidden,
+        // White space between table parts goes whatever `white-space` says (CSS 2.1 §17.2.1:
+        // "anonymous inline boxes that contain only white space"), as in Chromium.
+        NodeKind::Text => {
+            return if node.is_whitespace_node() { Kind::Space } else { Kind::Other };
+        }
+        NodeKind::Element | NodeKind::AnonymousBlock => {}
+        _ => return Kind::Hidden,
+    }
+    if node.is_line_break() {
+        return Kind::Other;
+    }
+    let Some(styles) = node.primary_styles() else { return Kind::Hidden };
+    let display = styles.clone_display();
+    if display.outside() == DisplayOutside::None {
+        return if display.inside() == DisplayInside::Contents { Kind::Contents } else { Kind::Hidden };
+    }
+    if styles.clone_position().is_absolutely_positioned() {
+        return Kind::OutOfFlow;
+    }
+    drop(styles);
+    let kind = match display.inside() {
+        DisplayInside::TableRowGroup | DisplayInside::TableHeaderGroup | DisplayInside::TableFooterGroup => {
+            Kind::RowGroup
+        }
+        DisplayInside::TableRow => Kind::Row,
+        DisplayInside::TableCell => Kind::Cell,
+        DisplayInside::TableColumn | DisplayInside::TableColumnGroup => Kind::Column,
+        _ if display.outside() == DisplayOutside::TableCaption => Kind::Caption,
+        _ => return Kind::Other,
+    };
+    // A replaced element with a table display is inline content (CSS Display 3 §2.7).
+    if is_replaced(node) {
+        Kind::Other
+    } else {
+        kind
+    }
+}
+
+/// Whether the node is a replaced element (`img`, `canvas`, ...).
+fn is_replaced(node: &Node) -> bool {
+    node.data.downcast_element().is_some_and(super::replaced::is_replaced)
+}
+
+/// Whether the node is an element (or pseudo-element) with `display: contents`.
+fn is_contents(node: &Node) -> bool {
+    !node.is_text_node() && node.display_style().is_some_and(|display| display.inside() == DisplayInside::Contents)
+}
+
+/// The children of `parent` that generate boxes in its box, in order: its `::before`, its children
+/// and its `::after`, with each `display: contents` element replaced by its own.
+fn box_children(doc: &mut BaseDocument, parent: NodeId, out: &mut Vec<NodeId>) {
+    // A table part's pseudo-elements are made here: no other construction reaches its box (one that
+    // has none and is styled to have none has nothing to make).
+    if has_pseudo_boxes(&doc.nodes[parent]) {
+        super::construct::flush_pseudo_elements(doc, parent);
+    }
+    let node = &doc.nodes[parent];
+    let (before, after) = (node.before(), node.after());
+    let ids: Vec<NodeId> = before.into_iter().chain(node.children.iter().copied()).chain(after).collect();
+    for id in ids {
+        if is_contents(&doc.nodes[id]) {
+            crate::util::ensure_stack(|| box_children(doc, id, out));
+        } else {
+            out.push(id);
+        }
+    }
+}
+
+/// Whether `parent`'s children are not all what its box lays out as they are: it has pseudo-element
+/// boxes, or a child that is not a proper child of `level` (nor hidden, white space or out of flow).
+fn needs_fixup(doc: &BaseDocument, parent: NodeId, level: Level) -> bool {
+    let node = &doc.nodes[parent];
+    has_pseudo_boxes(node)
+        || node.children.iter().any(|&id| match kind(doc, id) {
+            Kind::Hidden | Kind::Space | Kind::OutOfFlow => false,
+            kind => !kind.is_proper_child_of(level),
+        })
+}
+
+/// The children `parent` (a table, row group or row) lays out, with those that are not its proper
+/// children wrapped in anonymous rows (a table, a row group) or cells (a row), which `parent` owns
+/// (they are added to `anonymous`). White space between table parts, and before or after one at the
+/// start or end, is dropped; out-of-flow boxes are kept as they are.
+///
+/// `None` in the common case, when `parent` lays out its own children (every one a proper child or
+/// generating no box, which the table build passes over).
+///
+/// (`_vertical`: the table's writing mode is vertical; the fixup is the same. Its bare
+/// `text-combine-upright` text is boxed by `layout::combined_text`.)
+pub(crate) fn fixup_children(
+    doc: &mut BaseDocument,
+    parent: NodeId,
+    level: Level,
+    _vertical: bool,
+    anonymous: &mut Vec<NodeId>,
+) -> Option<Vec<NodeId>> {
+    if !needs_fixup(doc, parent, level) {
+        return None;
+    }
+    let mut items = Vec::new();
+    box_children(doc, parent, &mut items);
+    let kinds: Vec<Kind> = items.iter().map(|&id| kind(doc, id)).collect();
+    // The kind of the nearest box-generating sibling (not hidden, not white space) on each side.
+    let neighbour = |from: usize, step: isize| -> Option<Kind> {
+        let mut at = from as isize + step;
+        while at >= 0 && (at as usize) < kinds.len() {
+            match kinds[at as usize] {
+                Kind::Hidden | Kind::Space => at += step,
+                kind => return Some(kind),
+            }
+        }
+        None
+    };
+    let mut out = Vec::with_capacity(items.len());
+    let mut run: Vec<NodeId> = Vec::new();
+    let flush = |doc: &mut BaseDocument, run: &mut Vec<NodeId>, out: &mut Vec<NodeId>, anonymous: &mut Vec<NodeId>| {
+        if run.is_empty() {
+            return;
+        }
+        let pseudo = match level {
+            Level::Table | Level::RowGroup => PseudoElement::ServoAnonymousTableRow,
+            Level::Row => PseudoElement::ServoAnonymousTableCell,
+        };
+        let id = create_anonymous_table_box(doc, parent, &pseudo, std::mem::take(run));
+        anonymous.push(id);
+        out.push(id);
+    };
+    for (at, (&id, &kind)) in items.iter().zip(&kinds).enumerate() {
+        match kind {
+            Kind::Hidden => {}
+            Kind::Space => {
+                let before = neighbour(at, -1);
+                let after = neighbour(at, 1);
+                let dropped = before.is_none_or(Kind::is_table_non_root) && after.is_none_or(Kind::is_table_non_root);
+                if !dropped {
+                    run.push(id);
+                }
+            }
+            Kind::OutOfFlow => {
+                flush(doc, &mut run, &mut out, anonymous);
+                out.push(id);
+            }
+            kind if kind.is_proper_child_of(level) => {
+                flush(doc, &mut run, &mut out, anonymous);
+                out.push(id);
+            }
+            _ => run.push(id),
+        }
+    }
+    flush(doc, &mut run, &mut out, anonymous);
+    Some(out)
+}
+
+/// Whether the box is a table part that is misparented outside a table (a cell, row, row group,
+/// column, column group or caption), as a layout child of a block container.
+fn is_table_part(node: &Node) -> bool {
+    !node.is_text_node()
+        && !is_replaced(node)
+        && node.display_style().is_some_and(|display| {
+            matches!(display.outside(), DisplayOutside::InternalTable | DisplayOutside::TableCaption)
+        })
+}
+
+/// Wraps each run of consecutive table parts among a block container's layout children in an
+/// anonymous table, which the container owns. `display: none` boxes between two parts of a run
+/// stay in it.
+pub(crate) fn wrap_misparented_table_parts(
+    doc: &mut BaseDocument,
+    container: NodeId,
+    children: &mut ThinVec<NodeId>,
+    anonymous: &mut ThinVec<NodeId>,
+) {
+    if !children.iter().any(|&id| doc.nodes.get(id).is_some_and(is_table_part)) {
+        return;
+    }
+    if doc.nodes[container].primary_styles().is_none() {
+        return;
+    }
+    let mut out = ThinVec::with_capacity(children.len());
+    let mut run: Vec<NodeId> = Vec::new();
+    let mut hidden: Vec<NodeId> = Vec::new();
+    let flush =
+        |doc: &mut BaseDocument, run: &mut Vec<NodeId>, out: &mut ThinVec<NodeId>, anonymous: &mut ThinVec<NodeId>| {
+            if run.is_empty() {
+                return;
+            }
+            let id =
+                create_anonymous_table_box(doc, container, &PseudoElement::ServoAnonymousTable, std::mem::take(run));
+            anonymous.push(id);
+            out.push(id);
+        };
+    for &id in children.iter() {
+        let node = &doc.nodes[id];
+        if is_table_part(node) {
+            run.append(&mut hidden);
+            run.push(id);
+        } else if !run.is_empty() && node.display_style().is_some_and(|d| d.inside() == DisplayInside::None) {
+            hidden.push(id);
+        } else {
+            flush(doc, &mut run, &mut out, anonymous);
+            out.append(&mut ThinVec::from(std::mem::take(&mut hidden)));
+            out.push(id);
+        }
+    }
+    flush(doc, &mut run, &mut out, anonymous);
+    out.extend(hidden);
+    *children = out;
+}
+
+/// pyro: whether `node` is an anonymous inline table made by [`wrap_inline_table_parts`].
+pub(crate) fn is_anonymous_inline_table(node: &Node) -> bool {
+    node.is_anonymous()
+        && node.display_style().is_some_and(|display| {
+            display.outside() == DisplayOutside::Inline && display.inside() == DisplayInside::Table
+        })
+}
+
+/// pyro: the anonymous inline table a table part of an inline box is in
+/// ([`wrap_inline_table_parts`]), and whether the part is its first.
+pub(crate) fn inline_table_of(nodes: &crate::NodeTree, part: NodeId) -> Option<(NodeId, bool)> {
+    let table = nodes[part].inline_table.get()?;
+    let table_node = nodes.get(table)?;
+    (is_anonymous_inline_table(table_node) && table_node.children.contains(&part))
+        .then(|| (table, table_node.children.first() == Some(&part)))
+}
+
+/// pyro: wraps each run of table parts among the children of an inline box in the inline content
+/// of the inline root `root` in an anonymous inline table (CSS 2.1 § 17.2.1: "if a child C of a
+/// table-row-group (etc.) parent ... the parent is an inline box, an anonymous inline-table box
+/// is generated"; WPT css-tables `fixup-dynamic-anonymous-inline-table-001/002`). White space,
+/// comments and `display: none` boxes between two parts stay in the run (the white space
+/// generates no box: [`mark_space_between_inline_table_parts`]). The tables are owned by `root`
+/// (`anonymous`). Whether it made any.
+pub(crate) fn wrap_inline_table_parts(doc: &mut BaseDocument, root: NodeId, anonymous: &mut ThinVec<NodeId>) -> bool {
+    fn visit(doc: &mut BaseDocument, parent: NodeId, anonymous: &mut ThinVec<NodeId>, made: &mut bool) {
+        let children = doc.nodes[parent].children.clone();
+        for child in children {
+            let node = &doc.nodes[child];
+            let Some(element) = node.element_data() else { continue };
+            let Some(display) = node.display_style() else { continue };
+            if display.outside() == DisplayOutside::Inline
+                && display.inside() == DisplayInside::Flow
+                && !super::replaced::is_inline_box(element)
+            {
+                wrap_runs(doc, child, anonymous, made);
+                crate::util::ensure_stack(|| visit(doc, child, anonymous, made));
+            } else if display.outside() == DisplayOutside::None && display.inside() == DisplayInside::Contents {
+                crate::util::ensure_stack(|| visit(doc, child, anonymous, made));
+            }
+        }
+    }
+    fn wrap_runs(doc: &mut BaseDocument, inline: NodeId, anonymous: &mut ThinVec<NodeId>, made: &mut bool) {
+        if !doc.nodes[inline].children.iter().any(|&id| doc.nodes.get(id).is_some_and(is_table_part)) {
+            return;
+        }
+        let children = doc.nodes[inline].children.clone();
+        let mut run: Vec<NodeId> = Vec::new();
+        let mut flush = |doc: &mut BaseDocument, run: &mut Vec<NodeId>| {
+            if run.is_empty() {
+                return;
+            }
+            let parts = std::mem::take(run);
+            let id = create_anonymous_table_box(doc, inline, &PseudoElement::ServoAnonymousTable, parts.clone());
+            // An inline-level table.
+            if let Some(style) = doc.nodes[id].primary_styles().map(|style| style.clone()) {
+                let mut builder = style::properties::StyleBuilder::for_derived_style(
+                    doc.stylist.device(),
+                    Some(&doc.stylist),
+                    &style,
+                    None,
+                );
+                builder.set_display(style::values::specified::box_::Display::InlineTable);
+                let inline_table = builder.build();
+                if let Some(mut data) = doc.nodes[id].try_stylo_element_data_mut().and_then(|s| s.get_mut()) {
+                    data.styles.primary = Some(inline_table);
+                }
+                doc.nodes[id].update_layout_styles();
+            }
+            for part in parts {
+                doc.nodes[part].inline_table.set(Some(id));
+            }
+            anonymous.push(id);
+            *made = true;
+        };
+        for child in children {
+            let node = &doc.nodes[child];
+            if is_table_part(node) {
+                run.push(child);
+            } else if node.is_whitespace_node()
+                || node.data.kind() == NodeKind::Comment
+                || node.display_style().is_some_and(|display| {
+                    display.outside() == DisplayOutside::None && display.inside() == DisplayInside::None
+                })
+            {
+                // (In the run, generating no box.)
+            } else {
+                flush(doc, &mut run);
+            }
+        }
+        flush(doc, &mut run);
+    }
+    let mut made = false;
+    visit(doc, root, anonymous, &mut made);
+    made
+}
+
+/// White space between two table parts of an inline box generates no box, as if the parts were in
+/// one anonymous inline table (CSS 2.1 §17.2.1 removes white space between two internal table
+/// boxes; an inline box lays out its table parts as atomic inlines). Called once the construction of
+/// an inline formatting context has visited the children of `inline` (an inline box with table
+/// parts among them, `NodeFlags::ENCLOSES_TABLE_PARTS`), which cleared their flags: flags the
+/// white-space text children between two of its table parts
+/// (`NodeFlags::IS_SPACE_BETWEEN_TABLE_PARTS`). Boxes that generate nothing (comments,
+/// `display: none`) are passed over; anything else between two parts keeps the white space.
+pub(crate) fn mark_space_between_inline_table_parts(nodes: &mut crate::NodeTree, inline: NodeId) {
+    let mut spaces: Vec<NodeId> = Vec::new();
+    let mut between: Vec<NodeId> = Vec::new();
+    // Whether the last box-generating child was a table part.
+    let mut after_part = false;
+    for &id in nodes[inline].children.iter() {
+        let node = &nodes[id];
+        if node.is_text_node() {
+            if after_part && node.is_whitespace_node() {
+                between.push(id);
+            } else {
+                after_part = false;
+                between.clear();
+            }
+        } else if node.data.kind() == NodeKind::Comment
+            || node.display_style().is_some_and(|display| {
+                display.outside() == DisplayOutside::None && display.inside() == DisplayInside::None
+            })
+        {
+            continue;
+        } else if is_table_part(node) {
+            spaces.append(&mut between);
+            after_part = true;
+        } else {
+            after_part = false;
+            between.clear();
+        }
+    }
+    for id in spaces {
+        nodes[id].flags.insert(NodeFlags::IS_SPACE_BETWEEN_TABLE_PARTS);
+    }
+}
+
+/// The pseudo-element an anonymous box is styled as, by the `display` it was given: a table, row
+/// or cell of the fixup, else an anonymous block.
+pub(crate) fn anonymous_box_pseudo(style: &ComputedValues) -> PseudoElement {
+    match style.clone_display().inside() {
+        DisplayInside::Table => PseudoElement::ServoAnonymousTable,
+        DisplayInside::TableRow => PseudoElement::ServoAnonymousTableRow,
+        DisplayInside::TableCell => PseudoElement::ServoAnonymousTableCell,
+        _ => PseudoElement::ServoAnonymousBox,
+    }
+}
+
+/// A new anonymous table box (`pseudo`) in `parent`'s box, wrapping `children`.
+fn create_anonymous_table_box(
+    doc: &mut BaseDocument,
+    parent: NodeId,
+    pseudo: &PseudoElement,
+    children: Vec<NodeId>,
+) -> NodeId {
+    const NAME: QualName = QualName { prefix: None, ns: ns!(html), local: local_name!("div") };
+    let node_id = doc.create_node(NodeData::AnonymousBlock(Box::new(ElementData::new(NAME, Vec::new()))));
+    let style = {
+        let parent_style = doc.nodes[parent].primary_styles().expect("a table box's parent is styled");
+        let read_guard = doc.guard.read();
+        let guards = StylesheetGuards::same(&read_guard);
+        doc.stylist.style_for_anonymous::<&Node>(&guards, pseudo, &parent_style)
+    };
+    let mut data = StyloElementData { damage: ALL_DAMAGE, ..Default::default() };
+    data.styles.primary = Some(style);
+    data.set_restyled();
+    *doc.nodes[node_id].stylo_element_data_mut().ensure_init_mut() = data;
+    doc.nodes[node_id].update_layout_styles();
+    doc.nodes[node_id].mark_damaged();
+    if doc.nodes[parent].flags.contains(NodeFlags::IS_IN_DOCUMENT) {
+        doc.nodes[node_id].flags.insert(NodeFlags::IS_IN_DOCUMENT);
+    }
+    doc.nodes[node_id].parent = Some(parent);
+    doc.nodes[node_id].layout_parent.set(Some(parent));
+    doc.nodes[node_id].children = children.into();
+    node_id
+}
+
+/// Whether the node has, or is styled to have, a `::before` or `::after` that generates a box:
+/// part of its box's children (`box_children`).
+pub(crate) fn has_pseudo_boxes(node: &Node) -> bool {
+    use style::values::computed::Content;
+    if node.before().is_some() || node.after().is_some() {
+        return true;
+    }
+    node.try_stylo_element_data().and_then(|data| data.get()).is_some_and(|data| {
+        data.styles.pseudos.as_array()[..2]
+            .iter()
+            .flatten()
+            .any(|style| !matches!(style.get_counters().content, Content::Normal | Content::None))
+    })
+}
+
+/// Whether the node is an anonymous table, row or cell made by the fixup.
+pub(crate) fn is_anonymous_table_box(node: &Node) -> bool {
+    node.is_anonymous()
+        && node.display_style().is_some_and(|display| {
+            matches!(display.inside(), DisplayInside::Table | DisplayInside::TableRow | DisplayInside::TableCell)
+        })
+}
diff --git a/packages/blitz-dom/src/layout/text_box.rs b/packages/blitz-dom/src/layout/text_box.rs
new file mode 100644
--- /dev/null
+++ b/packages/blitz-dom/src/layout/text_box.rs
@@ -0,0 +1,224 @@
+//! pyro: `text-box-trim` and `text-box-edge` (CSS Inline 3 § 5).
+//!
+//! On a block container, `text-box-trim` trims the block-start side of its first formatted line
+//! and the block-end side of its last formatted line to a metric of the root inline box
+//! (`text-box-edge`): the half-leading and what else the line box holds beyond that metric no
+//! longer takes room in the block. The inline layout of the root that holds that line shifts its
+//! lines up and gives its content that much less height ([`block_trim`]). On an inline box, it
+//! moves the edges of the box's content area, which its backgrounds, borders and padding go by
+//! ([`span_trim`], `parley::TextStyle::text_box_trim`).
+
+use blitz_traits::node_id::NodeId;
+use style::properties::ComputedValues;
+use style::values::computed::{TextBoxEdge, TextBoxTrim};
+use style::values::specified::text::TextEdgeKeyword;
+use style::values::specified::box_::{DisplayInside, DisplayOutside};
+
+use super::first_letter::is_out_of_flow;
+use crate::BaseDocument;
+
+fn edge(keyword: TextEdgeKeyword) -> parley::TextEdge {
+    match keyword {
+        TextEdgeKeyword::Text => parley::TextEdge::Text,
+        TextEdgeKeyword::Ideographic => parley::TextEdge::Ideographic,
+        TextEdgeKeyword::IdeographicInk => parley::TextEdge::IdeographicInk,
+        TextEdgeKeyword::Cap => parley::TextEdge::Cap,
+        TextEdgeKeyword::Ex => parley::TextEdge::Ex,
+        TextEdgeKeyword::Alphabetic => parley::TextEdge::Alphabetic,
+    }
+}
+
+/// The over and under edges of `text-box-edge` (`auto` is `text`).
+fn edges(style: &ComputedValues) -> (parley::TextEdge, parley::TextEdge) {
+    match style.slow_clone_text_box_edge() {
+        TextBoxEdge::Auto => (parley::TextEdge::Text, parley::TextEdge::Text),
+        TextBoxEdge::TextEdge(text_edge) => (edge(text_edge.over), edge(text_edge.under)),
+    }
+}
+
+/// Whether the line-over side is at the block end (`vertical-lr` with upright or turned glyphs).
+fn line_inverted(style: &ComputedValues) -> bool {
+    style.writing_mode.intersects(style::logical_geometry::WritingMode::LINE_INVERTED)
+}
+
+/// The trimmed content area edges of an inline box with style `style`, by line side.
+pub(crate) fn span_trim(style: &ComputedValues) -> parley::TextBoxTrim {
+    let trim = style.slow_clone_text_box_trim();
+    if trim.is_empty() {
+        return parley::TextBoxTrim::default();
+    }
+    let (over, under) = edges(style);
+    let (start, end) = (trim.contains(TextBoxTrim::TRIM_START), trim.contains(TextBoxTrim::TRIM_END));
+    let (trim_over, trim_under) = if line_inverted(style) { (end, start) } else { (start, end) };
+    parley::TextBoxTrim { over: trim_over.then_some(over), under: trim_under.then_some(under) }
+}
+
+/// pyro: the sides (block-start, block-end) a multi-column container's columns trim at its column
+/// breaks (horizontal writing modes only): its own (Blink: the column boxes inherit
+/// `text-box-trim`).
+pub(crate) fn fragment_trims(style: &ComputedValues) -> (bool, bool) {
+    let trim = style.slow_clone_text_box_trim();
+    (trim.contains(TextBoxTrim::TRIM_START), trim.contains(TextBoxTrim::TRIM_END))
+}
+
+/// pyro: the sides a block with style `style`, inside a multi-column container, trims at column
+/// breaks, from those of its container (`outer`): on a side of its own `text-box-trim` only with
+/// `box-decoration-break: clone`, on others as its container (Blink: WPT css-inline
+/// `text-box-trim-multicol-004`/`005`).
+pub(crate) fn fragment_trims_within(style: &ComputedValues, outer: (bool, bool)) -> (bool, bool) {
+    let trim = style.slow_clone_text_box_trim();
+    let clone = style.get_border().box_decoration_break == style::values::computed::BoxDecorationBreak::Clone;
+    let side = |flag: TextBoxTrim, outer: bool| if trim.contains(flag) { clone } else { outer };
+    (side(TextBoxTrim::TRIM_START, outer.0), side(TextBoxTrim::TRIM_END, outer.1))
+}
+
+/// pyro: what a horizontal line of an inline root with style `root_style` loses over (`start`) or
+/// under its root inline box's `text-box-edge` metric when it starts or ends a column fragment
+/// (layout units, from the line's block-start or block-end side).
+pub(crate) fn fragment_line_trim(line: &parley::Line<'_, crate::node::TextBrush>, root_style: &ComputedValues, start: bool) -> f32 {
+    let (over, under) = edges(root_style);
+    let m = line.metrics();
+    if start {
+        (line.span_text_edge(line.root_style(), over, true) - m.block_min_coord).max(0.0)
+    } else {
+        (m.block_max_coord - line.span_text_edge(line.root_style(), under, false)).max(0.0)
+    }
+}
+
+/// A side of a line trimmed for a block: the metric the line ends at, and whether that is its
+/// line-over side.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct LineTrim {
+    pub edge: parley::TextEdge,
+    pub over: bool,
+}
+
+/// The trims of the first line (block-start side) and of the last line (block-end side) of the
+/// inline root `root`: those of the nearest block container with `text-box-trim` whose first or
+/// last formatted line that line is.
+pub(crate) fn block_trim(doc: &BaseDocument, root: NodeId) -> (Option<LineTrim>, Option<LineTrim>) {
+    if !doc.text_box_trim_styles {
+        return (None, None);
+    }
+    (side(doc, root, true), side(doc, root, false))
+}
+
+fn side(doc: &BaseDocument, root: NodeId, start: bool) -> Option<LineTrim> {
+    let flag = if start { TextBoxTrim::TRIM_START } else { TextBoxTrim::TRIM_END };
+    // The metric is the `text-box-edge` of the line's own root inline box (an inherited
+    // property), not that of the box that trims.
+    let root_style = doc.nodes[root]
+        .primary_styles()
+        .or_else(|| doc.nodes[root].parent.and_then(|parent| doc.nodes[parent].primary_styles()))?;
+    let mut current = root;
+    loop {
+        let node = &doc.nodes[current];
+        let split = node.is_split_inline();
+        let anonymous = node.is_anonymous();
+        let style = node.primary_styles();
+        if !anonymous && !split
+            && let Some(style) = style.as_deref()
+            && style.slow_clone_text_box_trim().contains(flag)
+        {
+            let (over, under) = edges(&root_style);
+            // The block-start side is the line-over side, unless the lines are inverted.
+            let is_over = start != line_inverted(&root_style);
+            return Some(LineTrim { edge: if is_over { over } else { under }, over: is_over });
+        }
+        // Only an in-flow block box passes its line on to its container.
+        let display = node.display_style()?;
+        let in_flow = style.as_deref().is_some_and(|style| !is_out_of_flow(style));
+        let block = anonymous
+            || (display.outside() == DisplayOutside::Block
+                && matches!(display.inside(), DisplayInside::Flow | DisplayInside::FlowRoot));
+        if !split && (!block || !in_flow) {
+            return None;
+        }
+        // A box with a border or padding on that side keeps its line to itself (Blink).
+        if !anonymous && !split && style.as_deref().is_some_and(|style| has_block_edge(style, start)) {
+            return None;
+        }
+        let parent = node.layout_parent.get()?;
+        if !is_edge_in_flow_child(doc, parent, current, start) {
+            return None;
+        }
+        current = parent;
+    }
+}
+
+/// Whether `style` has a border or padding on its block-start (`start`) or block-end side.
+fn has_block_edge(style: &ComputedValues, start: bool) -> bool {
+    use style::logical_geometry::PhysicalSide;
+    use style::values::computed::Length;
+    let wm = style.writing_mode;
+    let side = if start { wm.block_start_physical_side() } else { wm.block_end_physical_side() };
+    let (b, p) = (style.get_border(), style.get_padding());
+    let (width, border_style, padding) = match side {
+        PhysicalSide::Top => (&b.border_top_width, b.border_top_style, &p.padding_top),
+        PhysicalSide::Right => (&b.border_right_width, b.border_right_style, &p.padding_right),
+        PhysicalSide::Bottom => (&b.border_bottom_width, b.border_bottom_style, &p.padding_bottom),
+        PhysicalSide::Left => (&b.border_left_width, b.border_left_style, &p.padding_left),
+    };
+    (!border_style.none_or_hidden() && width.0.to_f32_px() != 0.0)
+        || padding.0.resolve(Length::new(0.0)).px() != 0.0
+        || padding.0.has_percentage()
+}
+
+/// Whether `child` is the first (`start`) or last in-flow box among the layout children of `parent`.
+fn is_edge_in_flow_child(doc: &BaseDocument, parent: NodeId, child: NodeId, start: bool) -> bool {
+    let children = doc.nodes[parent].layout_children.borrow();
+    let Some(children) = children.as_deref() else { return false };
+    let in_flow = |id: &NodeId| {
+        let node = &doc.nodes[*id];
+        node.display_style().is_none_or(|display| display != style::values::specified::Display::None)
+            && !node.primary_styles().is_some_and(|style| is_out_of_flow(&style))
+            && !is_empty_anonymous_block(doc, *id)
+    };
+    let found = if start { children.iter().find(|id| in_flow(id)) } else { children.iter().rev().find(|id| in_flow(id)) };
+    found == Some(&child)
+}
+
+/// pyro: whether `id` is an anonymous block that makes no line: it holds collapsible white space
+/// and the empty heads or tails of split inlines (no content, no inline-axis edges). The block in
+/// an inline after it holds its container's first formatted line (WPT css-inline
+/// `text-box-trim-block-in-inline-*`).
+fn is_empty_anonymous_block(doc: &BaseDocument, id: NodeId) -> bool {
+    let node = &doc.nodes[id];
+    if !node.is_anonymous() {
+        return false;
+    }
+    let len = node.children.len();
+    node.children.iter().enumerate().all(|(index, &child)| match node.split_ref_at(index, len) {
+        Some(tail) => is_empty_split_part(doc, child, tail),
+        None => doc.nodes[child].is_collapsible_whitespace_node(),
+    })
+}
+
+/// pyro: whether the head (`tail: false`) or the tail of the split inline `id` holds nothing.
+fn is_empty_split_part(doc: &BaseDocument, id: NodeId, tail: bool) -> bool {
+    use style::values::computed::Length;
+    let Some(style) = doc.nodes[id].primary_styles() else { return false };
+    let (b, p, m) = (style.get_border(), style.get_padding(), style.get_margin());
+    let zero = |v: &style::values::computed::LengthPercentage| v.resolve(Length::new(0.0)).px() == 0.0 && !v.has_percentage();
+    let margin = |v: &style::values::computed::Margin| match v {
+        style::values::generics::length::GenericMargin::LengthPercentage(v) => zero(v),
+        _ => true,
+    };
+    let border = |w: &style::values::computed::BorderSideWidth, s: style::values::computed::BorderStyle| {
+        s.none_or_hidden() || w.0.to_f32_px() == 0.0
+    };
+    let edges_empty = if style.writing_mode.is_vertical() {
+        zero(&p.padding_top.0) && zero(&p.padding_bottom.0) && margin(&m.margin_top) && margin(&m.margin_bottom)
+            && border(&b.border_top_width, b.border_top_style) && border(&b.border_bottom_width, b.border_bottom_style)
+    } else {
+        zero(&p.padding_left.0) && zero(&p.padding_right.0) && margin(&m.margin_left) && margin(&m.margin_right)
+            && border(&b.border_left_width, b.border_left_style) && border(&b.border_right_width, b.border_right_style)
+    };
+    drop(style);
+    if !edges_empty {
+        return false;
+    }
+    let (part, nested) = super::construct::split_inline_part(&doc.nodes, id, tail);
+    part.iter().all(|&child| doc.nodes[child].is_collapsible_whitespace_node())
+        && nested.is_none_or(|nested| is_empty_split_part(doc, nested, tail))
+}
