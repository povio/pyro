+        return Flattened::Affine(snap(Affine::new([
+            m.m11 * k,
+            m.m12 * k,
+            m.m21 * k,
+            m.m22 * k,
+            m.m41 * k,
+            m.m42 * k,
+        ])));
+    }
+    let project = |x: f64, y: f64| -> Option<(f64, f64)> {
+        let wv = x * m.m14 + y * m.m24 + m.m44;
+        // A corner at or behind the viewer's plane has no image (Chromium clips the box there).
+        (wv > 1e-6).then(|| {
