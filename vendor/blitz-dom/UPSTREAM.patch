+    fn tables(doc: &BaseDocument) -> Vec<Arc<TableContext>> {
+        doc.nodes
+            .iter()
+            .filter_map(|(_, node)| match &node.element_data()?.special_data {
+                SpecialElementData::TableRoot(ctx) => Some(Arc::clone(ctx)),
+                _ => None,
+            })
+            .collect()
+    }
