+    #[test]
+    fn predefined_styles() {
+        assert_eq!(named(-3, "decimal"), "-3");
+        assert_eq!(named(7, "decimal-leading-zero"), "07");
+        assert_eq!(named(1994, "upper-roman"), "MCMXCIV");
