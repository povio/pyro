+        // when nothing else is before them (a float after text stays on the text's line), and
+        // right after the last.
+        let mut start = first;
+        for index in (0..first).rev() {
+            let id = sequence[index].0;
+            if out_of_flow(id) {
+                start = index;
+            } else if !whitespace(id) {
