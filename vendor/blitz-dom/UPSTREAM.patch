+        let columns = ColumnFragments {
+            fragments: vec![
+                column(f32::NEG_INFINITY, 100.0, 0.0, 0.0, (0.0, 0.0)),
+                column(100.0, 200.0, 120.0, 0.0, (120.0, -100.0)),
+                spanner,
+                column(230.0, 330.0, 0.0, 130.0, (0.0, -100.0)),
+                column(330.0, f32::INFINITY, 120.0, 130.0, (120.0, -200.0)),
