+fn optgroup_label(
+    doc: &BaseDocument,
+    node_id: NodeId,
+) -> Option<(style::servo_arc::Arc<style::properties::ComputedValues>, String)> {
+    use style::selector_parser::PseudoElement;
+    use style::stylist::RuleInclusion;
+    let node = &doc.nodes[node_id];
