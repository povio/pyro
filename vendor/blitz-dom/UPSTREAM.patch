+                let _ = write!(self.out, "<g transform=\"translate({} {})\"", num(shadow.dx), num(shadow.dy));
+                if shadow.deviation > 0.0 {
+                    let _ = write!(self.out, " filter=\"blur({}px)\"", num(shadow.deviation));
+                }
