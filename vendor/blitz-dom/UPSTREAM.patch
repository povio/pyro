+    #[inline]
+    pub(crate) fn contains(&self, id: NodeId) -> bool {
+        self.rank_of.contains_key(&id)
+    }
+
+    /// Takes `id` out of the top layer (if it is in it).
+    pub(crate) fn remove(&mut self, id: NodeId) {
+        if let Some(rank) = self.rank_of.remove(&id) {
