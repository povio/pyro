+            && in_group_container(node)
+            && author.contains(&LonghandId::MixBlendMode)
+            && styles.as_ref().is_some_and(|style| {
+                style.get_effects().mix_blend_mode == style::computed_values::mix_blend_mode::T::PlusLighter
