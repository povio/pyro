+        let mut m = d.mutate();
+        m.remove_node(z);
+        drop(m);
+        d.resolve(0.0);
+        assert_eq!(order(&d, a), 7, ".z removed");
+        // A same-parent move: `.x` leaves its position and comes back last.
+        let mut m = d.mutate();
+        let y = div(&mut m, "y");
+        m.append_children(a, &[y]);
+        drop(m);
+        d.resolve(0.0);
