+        let mut m = d.mutate();
+        m.append_children(a, &[x]);
+        drop(m);
+        d.resolve(0.0);
+        assert_eq!(order(&d, a), 7, ".x moved last");
+    }
+
+    #[test]
+    fn nth_child_argument_follows_a_sibling_inserted_before_it() {
+        let (mut d, body) = make_doc(".a:has(> .x:nth-child(2)) { order: 7 }", "has-nth-child");
+        let mut m = d.mutate();
