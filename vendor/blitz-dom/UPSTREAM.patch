+    let cofactor_33 = m.m11 * (m.m22 * m.m44 - m.m24 * m.m42)
+        - m.m12 * (m.m21 * m.m44 - m.m24 * m.m41)
+        + m.m14 * (m.m21 * m.m42 - m.m22 * m.m41);
+    cofactor_33 * determinant < -f64::EPSILON
+}
