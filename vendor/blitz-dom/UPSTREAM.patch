+        for &id in &doc.nodes[body].children {
+            let node = &doc.nodes[id];
+            if !node.is_element() {
+                continue;
+            }
+            for id in std::iter::once(id).chain(node.children.iter().copied()) {
+                let style = doc.nodes[id].primary_styles().expect("styled");
+                out.push(format!(
