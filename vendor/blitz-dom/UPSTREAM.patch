+/// The side, in pixels, of the stand-in image a `<foreignObject>` is drawn as (see
+/// [`foreign_object_href`]); it is stretched to the element's box (`preserveAspectRatio="none"`).
+pub const FOREIGN_OBJECT_IMAGE_SIZE: u32 = 1024;
+
+/// A `data:` URL of the stand-in image of the `<foreignObject>` `id`: a PNG header (signature
+/// and `IHDR`, all usvg reads of it) of a [`FOREIGN_OBJECT_IMAGE_SIZE`] square, then a `pyFo`
+/// chunk holding the id (8 bytes, big-endian) and `IEND`. anyrender_svg's
+/// `foreign_object_id` reads it back; nothing decodes its pixels.
+pub fn foreign_object_href(id: NodeId) -> String {
+    fn chunk(out: &mut Vec<u8>, kind: &[u8; 4], data: &[u8]) {
+        out.extend_from_slice(&(data.len() as u32).to_be_bytes());
+        out.extend_from_slice(kind);
+        out.extend_from_slice(data);
+        out.extend_from_slice(&[0; 4]);
+    }
+    let mut png = vec![0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];
+    let mut header = Vec::with_capacity(13);
+    header.extend_from_slice(&FOREIGN_OBJECT_IMAGE_SIZE.to_be_bytes());
+    header.extend_from_slice(&FOREIGN_OBJECT_IMAGE_SIZE.to_be_bytes());
+    header.extend_from_slice(&[8, 6, 0, 0, 0]);
+    chunk(&mut png, b"IHDR", &header);
+    chunk(&mut png, b"pyFo", &id.as_u64().to_be_bytes());
+    chunk(&mut png, b"IEND", &[]);
+    const ALPHABET: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::from("data:image/png;base64,");
+    for group in png.chunks(3) {
+        let b = [group[0], *group.get(1).unwrap_or(&0), *group.get(2).unwrap_or(&0)];
+        let n = (u32::from(b[0]) << 16) | (u32::from(b[1]) << 8) | u32::from(b[2]);
+        for i in 0..4 {
+            if i <= group.len() {
+                out.push(ALPHABET[(n >> (18 - 6 * i) & 63) as usize] as char);
+            } else {
+                out.push('=');
+            }
+        }
+    }
+    out
+}
+
+/// The source of the `<svg>` subtree at `root` for usvg (see the module docs).
+thread_local! {
+    /// pyro: set while serializing when a `view-box` reference box was the root's CSS box guessed before
+    /// layout: the source then depends on the root's laid-out size ([`svg_source_for_viewport`]).
+    static VIEWPORT_DEPENDENT: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// pyro: the selected text nodes to write in their `::selection` paint, with the UTF-16 range
+    /// selected and the attributes (`BaseDocument::inline_svg_with_selection`).
+    pub(crate) static SELECTED_SVG_TEXT: std::cell::RefCell<std::collections::HashMap<NodeId, SelectedSvgText>> = std::cell::RefCell::new(std::collections::HashMap::new());
+    /// pyro: the root's laid-out content box size to serialize with ([`svg_source_for_viewport`]).
+    static ROOT_VIEWPORT: std::cell::Cell<Option<(f64, f64)>> = const { std::cell::Cell::new(None) };
+}
+
+/// pyro: [`svg_source`], and whether it depends on the root's laid-out size (a `view-box` reference box,
+/// percentages in `transform` say, of a root sized in percentages or not at all), serialized with the root's
+/// viewport `viewport` when given (WPT css-transforms `transform-percent-010`).
+pub(crate) fn svg_source_for_viewport(root: &Node, viewport: Option<(f64, f64)>) -> (String, bool) {
+    VIEWPORT_DEPENDENT.with(|d| d.set(false));
+    let old = ROOT_VIEWPORT.with(|v| v.replace(viewport));
+    let source = svg_source(root);
+    ROOT_VIEWPORT.with(|v| v.set(old));
+    (source, VIEWPORT_DEPENDENT.with(|d| d.replace(false)))
+}
+
+pub(crate) fn svg_source(root: &Node) -> String {
+    let guard = root.element_data().and_then(|data| data.guard.as_ref()).map(|lock| lock.read());
+    let mut writer = Writer {
+        out: String::new(),
+        guard,
+        root,
+        ids: None,
+        pass: Pass::Boxes,
+        needs_boxes: false,
+        box_ids: HashMap::new(),
+        boxes: HashMap::new(),
+        defs: String::new(),
+        next_id: 0,
+        viewports: Vec::new(),
+        viewport_guessed: Vec::new(),
+        root_perspective: None,
+        shadow_copy: None,
+        imported: Vec::new(),
+        typed_masks: Vec::new(),
+    };
+    writer.write_node(root, 0);
+    if !writer.needs_boxes {
+        return writer.finish();
+    }
+    // The boxes come from usvg's own parse of the first document.
+    let first = writer.finish();
+    if let Ok(svg) = crate::util::parse_svg_image(first.as_bytes()) {
+        writer.boxes = collect_boxes(&svg.tree, &writer.box_ids);
+    }
+    writer.out.clear();
+    writer.defs.clear();
+    writer.imported.clear();
+    writer.typed_masks.clear();
+    writer.next_id = 0;
+    writer.pass = Pass::Final;
+    writer.write_node(root, 0);
+    writer.finish()
+}
+
+/// pyro: a `calc()` of percentages and lengths in a `<filter>` or `<mask>` region attribute
+/// (`width="calc(25% + 0.25px)"`) as the number usvg reads: in `objectBoundingBox` units (the
+/// default) a percentage is a fraction of the box and a length a number of boxes, as Chromium
+/// resolves them; in user space only lengths. `None` for anything else.
+fn region_calc(data: &crate::node::ElementData, tag: &str, value: &str) -> Option<String> {
+    let units = match tag {
+        "filter" => "filterUnits",
+        "mask" => "maskUnits",
+        _ => return None,
+    };
+    let inner = value.trim().strip_prefix("calc(")?.strip_suffix(')')?;
+    let bounding_box = data.attr(markup5ever::LocalName::from(units)).is_none_or(|u| u.trim() != "userSpaceOnUse");
+    let mut total = 0.0f32;
+    let mut sign = 1.0f32;
+    let mut expect_term = true;
+    for token in inner.split_whitespace() {
+        if !expect_term {
+            sign = match token {
+                "+" => 1.0,
+                "-" => -1.0,
+                _ => return None,
+            };
+            expect_term = true;
+            continue;
+        }
+        let (number, scale) = if let Some(n) = token.strip_suffix('%') {
+            if !bounding_box {
+                return None;
+            }
+            (n, 0.01)
+        } else if let Some(n) = token.strip_suffix("px") {
+            (n, 1.0)
+        } else {
+            (token, 1.0)
+        };
+        total += sign * number.parse::<f32>().ok()? * scale;
+        expect_term = false;
+    }
+    (!expect_term).then(|| total.to_string())
+}
+
+/// The boxes of the elements named in `ids`, from a parsed tree.
+fn collect_boxes(tree: &usvg::Tree, ids: &HashMap<String, NodeId>) -> HashMap<NodeId, Boxes> {
+    fn rect(r: usvg::Rect) -> Rect {
+        Rect::new(r.left() as f64, r.top() as f64, r.right() as f64, r.bottom() as f64)
+    }
+    fn walk(group: &usvg::Group, ids: &HashMap<String, NodeId>, out: &mut HashMap<NodeId, Boxes>) {
+        for node in group.children() {
+            if let Some(&id) = ids.get(node.id()) {
+                out.entry(id)
+                    .or_insert(Boxes { fill: rect(node.bounding_box()), stroke: rect(node.stroke_bounding_box()) });
+            }
+            if let usvg::Node::Group(g) = node {
+                walk(g, ids, out);
+                if let Some(clip) = g.clip_path() {
+                    walk(clip.root(), ids, out);
+                }
+                if let Some(mask) = g.mask() {
+                    walk(mask.root(), ids, out);
+                }
+            }
+        }
+    }
+    let mut out = HashMap::new();
+    walk(tree.root(), ids, &mut out);
+    for clip in tree.clip_paths() {
+        walk(clip.root(), ids, &mut out);
+    }
+    for mask in tree.masks() {
+        walk(mask.root(), ids, &mut out);
+    }
+    for pattern in tree.patterns() {
+        walk(pattern.root(), ids, &mut out);
+    }
+    out
+}
+
+/// The longhands that author-level declarations (style sheets, `style`
+/// attributes, animations and SVG presentation attributes) set on the element.
+fn author_longhands(style: &ComputedValues, guard: &SharedRwLockReadGuard) -> Vec<LonghandId> {
+    let mut set = Vec::new();
+    for node in style.rules().self_and_ancestors() {
+        let Some(source) = node.style_source() else {
+            continue;
+        };
+        // Serialize computed presentation values too: usvg cannot resolve their
+        // custom properties, and must see the result of the page's cascade.
+        let hints_only = match node.cascade_level().origin() {
+            CascadeOrigin::UA | CascadeOrigin::User => continue,
+            CascadeOrigin::PresHints => true,
+            _ => false,
+        };
+        for declaration in source.read(guard).declarations() {
+            if let PropertyDeclarationId::Longhand(id) = declaration.id() {
+                if hints_only
+                    && !matches!(id, LonghandId::ClipPath | LonghandId::TransformOrigin)
+                    && !STYLE_PROPERTIES.iter().any(|&(property, _)| property == id)
+                {
+                    continue;
+                }
+                if !set.contains(&id) {
+                    set.push(id);
+                }
+            }
+        }
+    }
+    set
+}
+
+/// A computed value as CSS, with `url(...)` references reduced to their
+/// fragment (`url(#id)`), the only form usvg follows.
+fn computed_value(style: &ComputedValues, id: LonghandId) -> String {
+    let value = style.computed_value_to_string(PropertyDeclarationId::Longhand(id));
+    local_urls(&value)
+}
+
+/// `value` with each `url(...)` written as `url(#fragment)`.
+fn local_urls(value: &str) -> String {
+    if !value.contains("url(") {
+        return value.to_string();
+    }
+    let mut out = String::with_capacity(value.len());
+    let mut rest = value;
+    while let Some(start) = rest.find("url(") {
+        out.push_str(&rest[..start]);
+        let after = &rest[start + 4..];
+        let Some(end) = after.find(')') else {
+            out.push_str(&rest[start..]);
+            return out;
+        };
+        let inner = after[..end].trim().trim_matches(|c| c == '"' || c == '\'');
+        match inner.rfind('#') {
+            Some(hash) => {
+                out.push_str("url(");
+                out.push_str(&inner[hash..]);
+                out.push(')');
+            }
+            None => out.push_str(&rest[start..start + 4 + end + 1]),
+        }
+        rest = &after[end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
+
+/// The byte offset in `content` of the UTF-16 offset `utf16` (the end past its end).
+fn utf16_to_byte(content: &str, utf16: usize) -> usize {
+    let mut units = 0;
+    for (index, c) in content.char_indices() {
+        if units >= utf16 {
+            return index;
+        }
+        units += c.len_utf16();
+    }
+    content.len()
+}
