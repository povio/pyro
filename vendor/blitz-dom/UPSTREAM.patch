+/// A CSS mask layer's image (see [`Writer::css_mask_rewrite`]).
+enum LayerSource {
+    None,
+    /// A `<mask>` of the `<svg>`, by id.
+    Mask(String),
+    /// An SVG image: its document, natural size and ratio.
+    Svg {
+        source: std::sync::Arc<[u8]>,
+        width: Option<f64>,
+        height: Option<f64>,
+        ratio: Option<f64>,
+    },
+    Gradient(LinearGradient),
+}
