+    }
+    let height = if style.writing_mode.is_vertical() { style.slow_clone_width() } else { style.slow_clone_height() };
+    match height {
+        GenericSize::LengthPercentage(height) => match height.0.to_length() {
+            Some(height) => height.px() > line_height,
+            None => true,
+        },
+        _ => false,
