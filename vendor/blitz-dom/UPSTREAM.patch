+                if x_max <= x_min || y_max <= y_min {
+                    continue;
+                }
+                let rect = [glyph.x + x_min, glyph.y - y_max, glyph.x + x_max, glyph.y - y_min];
+                ink = Some(match ink {
+                    None => rect,
+                    Some(i) => [i[0].min(rect[0]), i[1].min(rect[1]), i[2].max(rect[2]), i[3].max(rect[3])],
+                });
+            }
+        }
+    }
