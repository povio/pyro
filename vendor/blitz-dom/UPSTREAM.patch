+            let shift = text_layout.layout.get(index).and_then(|line| {
+                let atomic = line.items().any(|item| {
+                    matches!(item, parley::PositionedLayoutItem::InlineBox(ibox) if ibox.kind == parley::InlineBoxKind::InFlow)
