+        let mut end = last;
+        for index in last + 1..sequence.len() {
+            let id = sequence[index].0;
+            if out_of_flow(id) {
+                end = index;
+            } else if !whitespace(id) {
+                break;
+            }
+        }
+        for entry in &mut sequence[start..=end] {
+            entry.1 = true;
+        }
