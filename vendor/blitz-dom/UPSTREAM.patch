+        return;
+    }
+    for line in ((r0 + 1)..r1).filter(|line| range.lines.contains(line)) {
+        edges.horizontal[line].update(c0..c1, |_| CollapsedEdge::NONE);
+    }
+    let rows = r0.max(range.rows.start)..r1.min(range.rows.end);
+    for line in (c0 + 1)..c1 {
