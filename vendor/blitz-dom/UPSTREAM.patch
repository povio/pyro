+fn leave_layout_children(doc: &mut BaseDocument, node_id: NodeId) {
+    let BaseDocument { nodes, left_layout_lists, .. } = doc;
+    if let Some(children) = nodes[node_id].layout_children.borrow().as_ref() {
+        for &child_id in children.iter() {
