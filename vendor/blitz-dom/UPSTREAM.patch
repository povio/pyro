+fn splice_indices(list: &mut Vec<usize>, removed: Range<usize>, inserted: usize) {
+    list.retain_mut(|index| {
+        if *index < removed.start {
+            true
+        } else if *index < removed.end {
+            false
+        } else {
+            *index = *index + inserted - removed.len();
+            true
+        }
+    });
+}
