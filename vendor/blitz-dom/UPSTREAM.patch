+fn regularize(t: Affine) -> Affine {
+    const THICKNESS: f64 = 1e-6;
+    let [a, b, c, d, e, f] = t.as_coeffs();
+    let (x_len, y_len) = (a.hypot(b), c.hypot(d));
+    if (a * d - b * c).abs() >= THICKNESS * x_len.max(y_len).max(1.0) {
