+        let mut m = d.mutate();
+        let t = m.create_text_node("text");
+        m.append_children(p, &[t]);
+        drop(m);
+        d.resolve(0.0);
+        assert_eq!(order(&d, a), 0, "a text node");
+        let mut m = d.mutate();
+        m.remove_node(t);
+        drop(m);
