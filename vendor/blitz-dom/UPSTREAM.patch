+/// Offers the borders of the box `id` around its grid area to the segments of `range`.
+fn offer_box(
+    edges: &mut CollapsedEdges,
+    doc: &BaseDocument,
+    id: NodeId,
+    (r0, c0, r1, c1): (usize, usize, usize, usize),
+    priority: u8,
+    range: &EdgeRange,
