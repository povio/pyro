+/// `unicode-bidi: bidi-override` holds on the lines after a `<br>` too.
+fn reopen_bidi_controls(builder: &mut TreeBuilder<TextBrush>, bidi_scan: &BidiScan) {
+    for controls in &bidi_scan.open_controls {
