+        // with the ellipsis (Chromium; WPT css-overflow `line-clamp/webkit-line-clamp-051`, `-052`).
+        let alignment = crate::stylo_to_parley::text_align(stylo_taffy::CopyStyleGetters::clone_text_align(&**style));
