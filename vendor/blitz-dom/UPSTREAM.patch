+        let ellipsis_width = ellipsis.full_width().max(0.0);
+        if kept > 0
+            && ellipsis_width > 0.0
+            && !rtl
+            && let Some(text_layout) = doc.nodes[id].data.downcast_element_mut().and_then(|el| el.inline_layout_data.as_mut())
+        {
