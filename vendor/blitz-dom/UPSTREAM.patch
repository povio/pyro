+        d.doc.mutate().remove_node(d.divs[1]);
+        assert_eq!(restyles(&d.doc), Vec::<NodeId>::new(), "a middle element left");
+        d.doc.mutate().remove_node(d.divs[0]);
+        assert_eq!(restyles(&d.doc), vec![d.divs[2]], "the next one became first");
+    }
+}
