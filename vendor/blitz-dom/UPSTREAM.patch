+/// pyro: a selected SVG text node written in its `::selection` paint (`inline_svg_with_selection`):
+/// the UTF-16 range selected, the paint attributes, and the highlight's `text-shadow`s.
+#[derive(Clone, Default)]
+pub(crate) struct SelectedSvgText {
+    pub from: usize,
+    pub to: Option<usize>,
+    pub attrs: String,
+    pub shadows: Vec<TextShadow>,
+}
+
+/// An SVG `<text>`'s `text-shadow`s, each written as a copy of the text before it, the last at
+/// the bottom, moved by the offset and painted in the shadow's colour (blurred by half the blur
+/// radius), as Chromium draws text shadows: what the text paints, its fill and stroke with their
+/// opacities and dashes. `root` is the `<text>` (for a highlight's style, any node).
+pub(crate) fn text_shadows(style: &ComputedValues, root: NodeId) -> Vec<TextShadow> {
+    use crate::util::ToColorColor as _;
+    let text = style.get_inherited_text();
+    // In CSS px without the `zoom` Stylo's computed lengths have (see [`filter_value`]).
+    let zoom = f64::from(style.effective_zoom.value());
+    text.text_shadow
+        .0
+        .iter()
+        .map(|shadow| {
+            let c = shadow.color.resolve_to_absolute(&text.color).as_color_color().to_rgba8();
+            TextShadow {
+                dx: f64::from(shadow.horizontal.px()) / zoom,
+                dy: f64::from(shadow.vertical.px()) / zoom,
+                deviation: f64::from(shadow.blur.px()) / zoom / 2.0,
+                color: [c.r, c.g, c.b, c.a],
+                root,
+                selected_only: false,
+            }
+        })
+        .filter(|shadow| shadow.color[3] > 0)
+        .collect()
+}
+
+/// A `<text>`'s `text-shadow` (see [`text_shadows`]).
+#[derive(Clone, Copy)]
+pub(crate) struct TextShadow {
+    dx: f64,
+    dy: f64,
+    /// Half the blur radius: the standard deviation Chromium blurs text shadows by.
+    deviation: f64,
+    color: [u8; 4],
+    /// The `<text>`.
+    root: NodeId,
+    /// pyro: a `::selection` shadow: cast by the selected text alone (the rest is written
+    /// without paint, where it is).
+    selected_only: bool,
+}
+
+/// Whether a `<g>` written around `node` (or next to it) is drawn as `node` would be: its parent
+/// is a container that draws its children in order. Not in a `<switch>` (which would choose the
+/// `<g>`, without `node`'s conditions, over `node`), a `<clipPath>` (which drops it), a `<text>`
+/// or a gradient.
+fn in_group_container(node: &Node) -> bool {
+    let Some(parent) = node.parent.and_then(|id| node.tree()[id].element_data()) else {
+        return false;
+    };
+    parent.name.ns == ns!(svg)
+        && matches!(&*parent.name.local, "svg" | "g" | "a" | "symbol" | "defs" | "mask" | "pattern" | "marker")
+}
+
+/// An element's own fill (or stroke) as usvg reads it: from author CSS (which is written for it)
+/// or else its attribute; `Some(None)` for `none`, `Some(Some(alpha))` for a paint (its colour's
+/// alpha, 1 for others), `None` when it has none of its own (it inherits).
+fn own_paint(data: &ElementData, style: &ComputedValues, author: &[LonghandId], fill: bool) -> Option<Option<f64>> {
+    use style::values::generics::svg::SVGPaintKind;
+    let (id, name) = if fill { (LonghandId::Fill, "fill") } else { (LonghandId::Stroke, "stroke") };
+    if author.contains(&id) {
+        let svg = style.get_inherited_svg();
+        let paint = if fill { &svg.fill } else { &svg.stroke };
+        return Some(match &paint.kind {
+            SVGPaintKind::None => None,
+            SVGPaintKind::Color(color) => Some(f64::from(color.resolve_to_absolute(&style.clone_color()).alpha)),
+            _ => Some(1.0),
+        });
+    }
+    let value = data.attr(markup5ever::LocalName::from(name))?.trim();
+    match svgtypes::Paint::from_str(value) {
+        Ok(svgtypes::Paint::None) => Some(None),
+        Ok(svgtypes::Paint::Color(color)) => Some(Some(f64::from(color.alpha) / 255.0)),
+        Ok(_) => Some(Some(1.0)),
+        Err(_) => None,
+    }
+}
+
+/// The declarations that paint an element of a text's shadow copy: its fills and strokes that
+/// are not `none` in the shadow's colour, with their colours' alphas times its alpha. The text
+/// itself (`top`) gets the paints it has, inherited ones included (`inherited`); an element in
+/// it only those it has of its own (it inherits the rest from the copy).
+fn shadow_paint_declarations(
+    own: [Option<Option<f64>>; 2],
+    inherited: [Option<f64>; 2],
+    top: bool,
+    [r, g, b, a]: [u8; 4],
+    out: &mut String,
+) {
+    for (i, name) in ["fill", "stroke"].into_iter().enumerate() {
+        let paint = match (own[i], top) {
+            (Some(paint), _) => paint,
+            (None, true) => inherited[i],
+            (None, false) => continue,
+        };
+        if let Some(alpha) = paint {
+            let _ = write!(out, "{name}:rgba({r},{g},{b},{});", num(alpha * f64::from(a) / 255.0));
+        }
+    }
+}
+
+/// A `drop-shadow()` usvg reads: its colour resolved to `#rrggbbaa` (usvg knows neither
+/// `currentcolor` nor `color-mix()`, and a colour function's parentheses would end the value in
+/// a `style` attribute: [`nested_parentheses`]), its third length the standard deviation (as
+/// usvg, and Chromium, take it). The lengths are in CSS px, as SVG user units are.
+fn drop_shadow_function(
+    x: f64,
+    y: f64,
+    deviation: f64,
+    color: &style::values::computed::Color,
+    current_color: &style::color::AbsoluteColor,
+) -> String {
+    use crate::util::ToColorColor as _;
+    let c = color.resolve_to_absolute(current_color).as_color_color().to_rgba8();
+    format!("drop-shadow({}px {}px {}px #{:02x}{:02x}{:02x}{:02x})", num(x), num(y), num(deviation), c.r, c.g, c.b, c.a)
+}
+
+/// An element's computed `filter` for usvg: `url()`s as their fragment, drop shadows with
+/// their colours resolved ([`drop_shadow_function`]), the other functions as CSS writes them.
+/// Lengths in CSS px without the element's `zoom` (Stylo's computed lengths have it; the
+/// resolved value does not): the `<svg>`'s box scales its user units by it.
+/// pyro: the id of the identity filter whose result is tainted (anyrender_svg `TAINT_MARK`), which
+/// [`filter_value`] puts after a `drop-shadow()` coloured from `currentcolor` (Filter Effects:
+/// such a shadow taints the filters after it): usvg resolves the colour, and the filter it makes
+/// of the function says nothing of where its colour came from.
+const TAINT_MARK: &str = "__pyro_taint";
+
+/// pyro: whether a computed colour is `currentcolor` or made from it.
+fn uses_current_color(color: &style::values::computed::Color) -> bool {
+    use style::values::generics::color::GenericColor;
+    match color {
+        GenericColor::Absolute(_) => false,
+        GenericColor::CurrentColor => true,
+        GenericColor::ColorMix(mix) => mix.items.iter().any(|item| uses_current_color(&item.color)),
+        GenericColor::ContrastColor(color) => uses_current_color(color),
+        GenericColor::ColorFunction(function) => function.origin_color().is_some_and(uses_current_color),
+    }
+}
+
+/// pyro: whether `style`'s `filter` has a `drop-shadow()` coloured from `currentcolor`.
+fn taints_filters(style: &ComputedValues) -> bool {
+    use style::computed_values::filter::single_value::T as Filter;
+    style
+        .get_effects()
+        .filter
+        .0
+        .iter()
+        .any(|filter| matches!(filter, Filter::DropShadow(shadow) if uses_current_color(&shadow.color)))
+}
+
+fn filter_value(style: &ComputedValues) -> String {
+    use style::computed_values::filter::single_value::T as Filter;
+    let current_color = style.clone_color();
+    let filters = &style.get_effects().filter.0;
+    if filters.is_empty() {
+        return "none".to_string();
+    }
+    let zoom = f64::from(style.effective_zoom.value());
+    let unzoom = |px: f32| f64::from(px) / zoom;
+    filters
+        .iter()
+        .map(|filter| match filter {
+            Filter::DropShadow(shadow) => {
+                let function = drop_shadow_function(
+                    unzoom(shadow.horizontal.px()),
+                    unzoom(shadow.vertical.px()),
+                    unzoom(shadow.blur.px()),
+                    &shadow.color,
+                    &current_color,
+                );
+                // pyro: its result tainted (`TAINT_MARK`).
+                if uses_current_color(&shadow.color) {
+                    format!("{function} url(#{TAINT_MARK})")
+                } else {
+                    function
+                }
+            }
+            Filter::Blur(length) => format!("blur({}px)", num(unzoom(length.0.px()))),
+            Filter::Url(_) => local_urls(&filter.to_css_string()),
+            filter => filter.to_css_string(),
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// Whether `value` has parentheses in parentheses (`drop-shadow(rgb(0, 0, 0) 1px 1px)`): usvg's
+/// `style` attribute tokenizer ends a function at its first `)`, and drops the declaration.
+fn nested_parentheses(value: &str) -> bool {
+    let mut depth = 0usize;
+    for c in value.chars() {
+        match c {
+            '(' => {
+                depth += 1;
+                if depth > 1 {
+                    return true;
+                }
+            }
+            ')' => depth = depth.saturating_sub(1),
+            _ => {}
+        }
+    }
+    false
+}
+
+/// The fragment of a lone `url(...)` value (`url(#a)`, `url("#a")`, `url(doc.svg#a)`).
+fn url_fragment(value: &str) -> Option<String> {
+    let inner = value.trim().strip_prefix("url(")?.strip_suffix(')')?;
+    let inner = inner.trim().trim_matches(|c| c == '"' || c == '\'');
+    let (_, fragment) = inner.rsplit_once('#')?;
+    (!fragment.is_empty()).then(|| fragment.to_string())
+}
+
+/// pyro: whether the first element with the id `id` (in tree order, as `getElementById` finds it)
+/// of the node tree `node` is in (the document's, or a shadow tree: ids are scoped to their tree)
+/// is an SVG `<mask>`.
+fn is_document_svg_mask(node: &Node, id: &str) -> bool {
+    let tree = node.tree();
+    let scope = node.containing_shadow_host_id();
+    let mut top = node;
+    while let Some(parent) = top.parent {
+        top = &tree[parent];
+    }
+    let mut stack = vec![top];
+    while let Some(node) = stack.pop() {
+        if let Some(data) = node.element_data() {
+            if data.attr(local_name!("id")) == Some(id) && node.containing_shadow_host_id() == scope {
+                return data.name.ns == ns!(svg) && &*data.name.local == "mask";
+            }
+        }
+        stack.extend(node.children.iter().rev().map(|&child| &tree[child]));
+    }
+    false
+}
+
+/// Whether `value` is a transform list as SVG's grammar has it (and Chromium's parser): what
+/// svgtypes reads, without a comma that separates nothing (`rotate(90,)`, `scale(,2)`,
+/// `translate(1,,2)`, a list ending in one), which svgtypes lets through.
+fn is_transform_list(value: &str) -> bool {
+    if value.parse::<svgtypes::Transform>().is_err() {
+        return false;
+    }
+    // The previous character that is not white space.
+    let mut previous = None;
+    for c in value.chars() {
+        if c.is_ascii_whitespace() {
+            continue;
+        }
+        let separates_nothing = match (previous, c) {
+            (Some('(' | ','), ',') | (Some(','), ')') => true,
+            _ => false,
+        };
+        if separates_nothing {
+            return false;
+        }
+        previous = Some(c);
+    }
+    previous != Some(',')
+}
+
+/// The property names this module writes itself (from computed values), as
+/// usvg reads them from a `style` attribute.
+fn is_handled_property(name: &str) -> bool {
+    STYLE_PROPERTIES.iter().any(|&(_, n)| n == name)
+        || matches!(
+            name,
+            "transform" | "translate" | "rotate" | "scale" | "transform-origin" | "transform-box"
+                | "clip-path" | "mask" | "mask-image" | "x" | "y" | "width" | "height" | "cx" | "cy"
+                | "r" | "rx" | "ry" | "d"
+                // Its longhands are written instead (usvg reads no line height in it).
+                | "font"
+        )
+}
+
+/// An element's `style` attribute without the declarations of the properties
+/// this module writes itself: Stylo parsed those, and those it rejected
+/// (`transform: scale(invalid)`) must not reach usvg either (which would read
+/// `transform` in CSS syntax as an invalid transform attribute). The others
+/// (`stop-color`, `marker-end`, ... which Stylo does not parse for servo) stay.
+fn without_handled_declarations(style: &str) -> String {
+    let mut out = String::with_capacity(style.len());
+    let (mut depth, mut quote, mut start) = (0usize, None, 0usize);
+    let mut declarations = Vec::new();
+    for (i, c) in style.char_indices() {
+        match (quote, c) {
+            (Some(q), c) if c == q => quote = None,
+            (Some(_), _) => {}
+            (None, '"' | '\'') => quote = Some(c),
+            (None, '(') => depth += 1,
+            (None, ')') => depth = depth.saturating_sub(1),
+            (None, ';') if depth == 0 => {
+                declarations.push(&style[start..i]);
+                start = i + 1;
+            }
+            _ => {}
+        }
+    }
+    declarations.push(&style[start..]);
+    for declaration in declarations {
+        let name = declaration.split(':').next().unwrap_or("").trim().to_ascii_lowercase();
+        if declaration.trim().is_empty() || is_handled_property(&name) {
+            continue;
+        }
+        out.push_str(declaration.trim());
+        out.push(';');
+    }
+    out
+}
+
+/// A number for SVG source: no exponent, and short.
+fn num(v: f64) -> String {
+    if !v.is_finite() {
+        return "0".to_string();
+    }
+    let rounded = (v * 1e6).round() / 1e6;
+    let s = format!("{rounded:.6}");
+    let s = s.trim_end_matches('0').trim_end_matches('.');
+    if s == "-0" { "0".to_string() } else { s.to_string() }
+}
+
+/// An element's property written from CSS in place of its own attribute of
+/// that name: as that attribute, or (for presentation attributes, which a
+/// declaration of the element's own `style` attribute would override) as a
+/// declaration after the `style` attribute's own.
+struct Rewrite {
+    name: &'static str,
+    value: Option<String>,
+    in_style: bool,
+}
+
+/// pyro: whether `node` is inside an SVG `<text>`.
+fn in_text(node: &Node) -> bool {
+    let mut parent = node.parent;
+    while let Some(id) = parent {
+        let p = &node.tree()[id];
+        match p.element_data() {
+            Some(data) if data.name.ns == ns!(svg) && &*data.name.local == "text" => return true,
+            Some(data) if data.name.ns == ns!(svg) => parent = p.parent,
+            _ => return false,
+        }
+    }
+    false
+}
+
+impl Writer<'_> {
+    fn finish(&mut self) -> String {
+        let mut out = std::mem::take(&mut self.out);
+        if !self.defs.is_empty() {
+            // Before the root's end tag (or as its children when it had none).
+            if let Some(end) = out.rfind("</svg>") {
+                out.insert_str(end, &format!("<defs>{}</defs>", self.defs));
+            } else if let Some(end) = out.rfind("/>") {
+                out.replace_range(end..end + 2, &format!("><defs>{}</defs></svg>", self.defs));
+            }
+        }
+        out
+    }
+
+    fn new_id(&mut self, kind: &str) -> String {
+        self.next_id += 1;
+        format!("__pyro_{kind}_{}", self.next_id)
+    }
+
+    fn write_node(&mut self, node: &Node, nesting: usize) {
+        match &node.data {
+            NodeData::Text(data) => {
+                // pyro: selected text in its `::selection` paint (`inline_svg_with_selection`).
+                let selected = SELECTED_SVG_TEXT.with(|cell| cell.borrow().get(&node.id).cloned());
+                // pyro: a `::selection` shadow's copy: the text outside the selection unpainted.
+                if self.shadow_copy.is_some_and(|shadow| shadow.selected_only) {
+                    let content = data.content.as_str();
+                    let (from, to) = match &selected {
+                        Some(selected) => {
+                            let byte = |utf16: usize| utf16_to_byte(content, utf16);
+                            let from = byte(selected.from);
+                            (from, selected.to.map_or(content.len(), byte).max(from))
+                        }
+                        None => (content.len(), content.len()),
+                    };
+                    for (part, painted) in [(&content[..from], false), (&content[from..to], true), (&content[to..], false)] {
+                        if part.is_empty() {
+                            continue;
+                        }
+                        if painted {
+                            encode_text_to_string(part, &mut self.out);
+                        } else {
+                            self.out.push_str("<tspan fill=\"none\" stroke=\"none\">");
+                            encode_text_to_string(part, &mut self.out);
+                            self.out.push_str("</tspan>");
+                        }
+                    }
+                    return;
+                }
+                match selected.filter(|_| in_text(node) && self.shadow_copy.is_none()) {
+                    Some(SelectedSvgText { from, to, attrs, .. }) => {
+                        let content = data.content.as_str();
+                        let byte = |utf16: usize| utf16_to_byte(content, utf16);
+                        let (from, to) = (byte(from), to.map_or(content.len(), byte));
+                        encode_text_to_string(&content[..from], &mut self.out);
+                        let _ = write!(self.out, "<tspan{attrs}>");
+                        encode_text_to_string(&content[from..to.max(from)], &mut self.out);
+                        self.out.push_str("</tspan>");
+                        let _ = encode_text_to_string(&content[to.max(from)..], &mut self.out);
+                    }
+                    None => {
+                        let _ = encode_text_to_string(data.content.as_str(), &mut self.out);
+                    }
+                }
+            }
+            NodeData::Element(data) => self.write_element(node, data, nesting),
+            _ => {}
+        }
+    }
+
+    fn write_element(&mut self, node: &Node, data: &ElementData, nesting: usize) {
+        // pyro: `display: contents` on an SVG element (CSS Display 3, appendix B): a `<g>`,
+        // `<tspan>`, `<a>` or nested `<svg>` is unboxed (its children render in its place, without
+        // its own attributes or effects); a `<use>` renders its reference without its own
+        // effects; any other element renders nothing (WPT css-display
+        // `display-contents-svg-elements`).
+        if nesting > 0
+            && data.name.ns == ns!(svg)
+            && node.primary_styles().is_some_and(|style| style.clone_display().is_contents())
+        {
+            match data.name.local.as_ref() {
+                "g" | "tspan" | "a" | "svg" => {
+                    // Its children still inherit from it: a bare wrapper (a `<tspan>` in text, else
+                    // a `<g>`) carries the inherited properties declared on it, nothing else
+                    // (WPT css-display `display-contents-svg-tspan-text-fill`).
+                    let wrapper = if matches!(data.name.local.as_ref(), "tspan" | "a") && in_text(node) { "tspan" } else { "g" };
+                    let mut declarations = String::new();
+                    if let (Some(style), Some(guard)) = (node.primary_styles(), &self.guard) {
+                        let author = author_longhands(&style, guard);
+                        for &(id, name) in STYLE_PROPERTIES {
+                            if id.inherited() && author.contains(&id) {
+                                let _ = write!(declarations, "{name}:{};", computed_value(&style, id));
+                            }
+                        }
+                    }
+                    let _ = write!(self.out, "<{wrapper}");
+                    if !declarations.is_empty() {
+                        self.out.push_str(" style=\"");
+                        encode_quoted_attribute_to_string(&declarations, &mut self.out);
+                        self.out.push('"');
+                    }
+                    self.out.push('>');
+                    for &child_id in &node.children {
+                        self.write_node(&node.tree()[child_id], nesting + 1);
+                    }
+                    let _ = write!(self.out, "</{wrapper}>");
+                }
+                "use" => {
+                    self.out.push_str("<use");
+                    for attr in data.attrs() {
+                        let name = attr.name.local.as_ref();
+                        if matches!(name, "href" | "x" | "y" | "width" | "height") {
+                            let _ = write!(self.out, " {}=\"", if name == "href" { "href" } else { name });
+                            encode_quoted_attribute_to_string(&attr.value, &mut self.out);
+                            self.out.push('"');
+                        }
+                    }
+                    self.out.push_str(" />");
+                }
+                _ => {}
+            }
+            return;
+        }
+        // A `<text>`'s `text-shadow`: a copy of it before it, moved by the offset and painted
+        // in the shadow's colour ([`text_shadow`]).
+        if nesting > 0
+            && self.shadow_copy.is_none()
+            && data.name.ns == ns!(svg)
+            && &*data.name.local == "text"
+            && in_group_container(node)
+        {
+            let mut shadows = node.primary_styles().map(|style| text_shadows(&style, node.id)).unwrap_or_default();
+            // pyro: the shadows of its selected text's `::selection` style, under its own (as
+            // Chromium paints them; WPT css-pseudo `svg-text-selection-shadow`).
+            let selection_shadows = SELECTED_SVG_TEXT.with(|cell| {
+                let selected = cell.borrow();
+                if selected.is_empty() {
+                    return Vec::new();
+                }
+                let mut stack = vec![node.id];
+                while let Some(id) = stack.pop() {
+                    if let Some(found) = selected.get(&id).filter(|found| !found.shadows.is_empty()) {
+                        return found.shadows.clone();
+                    }
+                    stack.extend(node.tree()[id].children.iter().copied());
+                }
+                Vec::new()
+            });
+            shadows.extend(selection_shadows.into_iter().map(|shadow| TextShadow { root: node.id, selected_only: true, ..shadow }));
