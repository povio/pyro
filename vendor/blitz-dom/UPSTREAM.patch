+    style: &style::properties::ComputedValues,
+) -> Option<Vec<Piece>> {
+    match doc.generated_text.get(&owner).and_then(|texts| texts[idx].as_ref()) {
+        Some(pieces) => Some(pieces.clone()),
+        None => super::counters::plain_content(style, owner),
