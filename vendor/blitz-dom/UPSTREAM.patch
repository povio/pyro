+        let b = breaks(vec![(0.0, 300.0)], vec![(0.0, 300.0)], 300.0);
+        let run = b.fill(100.0, MAX_COLUMNS);
+        assert_eq!(run.columns, vec![(0.0, 100.0), (100.0, 200.0), (200.0, 300.0)]);
+    }
+
+    #[test]
