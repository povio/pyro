+        FontVariantEmoji::Emoji if is_emoji_char => Some(true),
+        FontVariantEmoji::Text if is_emoji_char => Some(false),
+        // The Unicode default presentation (`Emoji_Presentation`).
+        FontVariantEmoji::Unicode if is_emoji_char => {
