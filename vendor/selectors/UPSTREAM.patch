+/// pyro: `:host-context(<compound>)`: the shadow host of the rules' tree, when it or one of its
+/// shadow-including ancestors (a shadow tree's first level steps to its host) matches the compound.
+fn matches_host_context<E>(
+    element: E,
+    selector: &Selector<E::Impl>,
+    context: &mut MatchingContext<E::Impl>,
+    rightmost: SubjectOrPseudoElement,
+) -> KleeneValue
+where
+    E: Element,
+{
+    if context.shadow_host() != Some(element.opaque()) {
+        return KleeneValue::False;
+    }
+    context.nest(|context| {
+        context.with_featureless(false, |context| {
+            let mut current = Some(element);
+            while let Some(candidate) = current {
+                let matched = matches_complex_selector(selector.iter(), candidate, context, rightmost);
+                if matched != KleeneValue::False {
+                    return matched;
+                }
+                current = candidate.parent_element().or_else(|| {
+                    if candidate.parent_node_is_shadow_root() {
+                        candidate.containing_shadow_host()
+                    } else {
+                        None
+                    }
+                });
+            }
+            KleeneValue::False
+        })
+    })
+}
