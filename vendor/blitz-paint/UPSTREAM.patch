+//! pyro: the document selection painted as Chromium paints it (CSS Pseudo-Elements 4 § 3,
+//! highlight painting).
+//!
+//! Behind the selected text goes the highlight's background over each selected stretch of a line,
+//! from the line box's top to its bottom, or to the text's content area where that reaches
+//! further (Blink's `ExpandSelectionRectToLineHeight`), its edges on whole CSS px as an inline
+//! box's are. The selected glyphs are drawn in the highlight's colour, and so are the decorations
+//! whose colour is the text's (`currentcolor`); decorations of another colour keep it, and the
+//! line stays one line across the selection's edges. A `::selection` style's own text decoration
+//! is drawn over the selected text, as a decoration of the element whose style it is. The highlight is the `::selection` style of
+//! the nearest element that has one (the text's element, its parent, ...), else the system's:
+//! `HighlightText` on `Highlight`, also for a `::selection` style that declares neither `color` nor
+//! `background-color`. Text that `user-select: none` keeps from being selected is not
+//! highlighted.
+//!
+//! Each line holding selected text is drawn twice, clipped: everything but the selected
+//! stretches as usual, then the stretches in the highlight's colours (without text shadows).
+//! Screenshots only: a recording paint (the PDF's) draws no selection, as Chromium prints none.
+
+use anyrender::PaintScene;
+use blitz_dom::CopyStyleGetters;
+use blitz_dom::{BaseDocument, NodeId, node::TextBrush};
+use kurbo::{Affine, BezPath, Rect, Shape};
+use parley::{Layout, Line, PositionedLayoutItem};
+use peniko::Fill;
+use smallvec::SmallVec;
+use style::selector_parser::PseudoElement;
+
+use crate::color::{Color, ToColorColor as _};
+use std::rc::Rc;
+
+use crate::text::{DrawTextContext, LineTops, ResolvedDecoration, TextPaintOptions, own_decoration, stroke_text};
+
+/// The system highlight colours, CSS Color 4 `Highlight` and `HighlightText` as Stylo's servo
+/// device computes them (light colour scheme), so that text selected without a `::selection`
+/// style looks like text styled with them (WPT `system-color-hightlights-vs-getSelection-*`).
+const HIGHLIGHT: Color = Color::from_rgb8(0, 65, 198);
+const HIGHLIGHT_TEXT: Color = Color::from_rgb8(0, 0, 0);
+/// CSS Color 4 `Mark` and `MarkText`, the target text's UA colours.
+const MARK: Color = Color::from_rgb8(255, 255, 0);
+const MARK_TEXT: Color = Color::from_rgb8(0, 0, 0);
+
+/// What highlighted text is drawn with.
+#[derive(Clone)]
+pub(crate) struct Highlight {
+    /// `None`: the text keeps its own colour (a `::selection` style that declares a
+    /// `background-color` but no `color`), or the colour of the highlight below.
+    pub color: Option<Color>,
+    /// The element whose highlight style this is (`None`: the system's highlight), and the
+    /// text decoration of that style: lines drawn over the highlighted text, as an element's own
+    /// are over its content.
+    pub owner: Option<NodeId>,
+    pub decoration: Option<Rc<ResolvedDecoration>>,
+    /// The top highlight's `text-shadow` (`None`: none).
+    pub shadows: Option<Rc<Vec<crate::text::TextShadow>>>,
+}
+
+/// pyro: a highlight overlay (CSS Pseudo-Elements 4 § 3.5): custom highlights and the target
+/// text under the selection.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum Layer {
+    Named(blitz_dom::HighlightName),
+    Selection,
+    /// pyro: a block caret over the character after it: its colour and the colour of the text
+    /// under it (`None`: the text's own; `caret.rs`).
+    Caret(Color, Option<Color>),
+}
+
+/// A highlight's background: none, a colour, or the highlight's own text colour.
+#[derive(Clone, Copy, PartialEq)]
+enum Background {
+    Color(Color),
+    Current,
+}
+
+/// One highlight's style for the text of one element.
+#[derive(Clone)]
+struct LayerStyle {
+    /// `None`: the colour of the highlight below (or the text's own).
+    color: Option<Color>,
+    background: Background,
+    owner: Option<NodeId>,
+    decoration: Option<Rc<ResolvedDecoration>>,
+    /// The nearest style of the highlight (for its `text-shadow`).
+    style: Option<Style>,
+}
+
+/// The highlights an inline root is painted with, bottom first, the set drawn now (`mask`, bits
+/// of `layers`), and the styles found so far.
+#[derive(Default)]
+pub(crate) struct HighlightCache {
+    pub(crate) layers: Vec<Layer>,
+    pub(crate) mask: u32,
+    styles: Vec<((NodeId, usize), Option<LayerStyle>)>,
+    effective: Vec<((NodeId, u32), Option<Highlight>)>,
+}
+
+impl HighlightCache {
+    fn clear(&mut self) {
+        self.styles.clear();
+        self.effective.clear();
+    }
+
+    fn layer_style(&mut self, doc: &BaseDocument, node_id: NodeId, layer: usize) -> Option<LayerStyle> {
+        if let Some((_, style)) = self.styles.iter().find(|(key, _)| *key == (node_id, layer)) {
+            return style.clone();
+        }
+        let style = match &self.layers[layer] {
+            Layer::Selection => selection_style(doc, node_id),
+            Layer::Named(name) => named_style(doc, node_id, name),
+            &Layer::Caret(color, text) => Some(LayerStyle {
+                color: text,
+                background: Background::Color(color),
+                owner: None,
+                decoration: None,
+                style: None,
+            }),
+        };
+        self.styles.push(((node_id, layer), style.clone()));
+        style
+    }
+
+    /// The colours of the highlights of `mask` over the text of `node_id`, bottom first: each
+    /// layer's background, and the text colour at the top (`None`: its own).
+    fn stack(&mut self, doc: &BaseDocument, node_id: NodeId, mask: u32) -> (SmallVec<[Color; 2]>, Option<Highlight>) {
+        let mut backgrounds = SmallVec::new();
+        let mut color: Option<Color> = None;
+        let mut top: Option<LayerStyle> = None;
+        // pyro: each layer's shadows, the bottom layer's first (on top, as Chromium stacks them:
+        // the reference lists the target text's shadow before the selection's; WPT css-pseudo
+        // `highlight-painting-shadows-horizontal`).
+        let mut shadows: Vec<crate::text::TextShadow> = Vec::new();
+        for layer in 0..self.layers.len() {
+            if mask & (1 << layer) == 0 {
+                continue;
+            }
+            let Some(style) = self.layer_style(doc, node_id, layer) else { continue };
+            if let Some(c) = style.color {
+                color = Some(c);
+            }
+            if let Some(layer_style) = &style.style {
+                shadows.extend(crate::text::highlight_shadows(
+                    layer_style,
+                    color.unwrap_or_else(|| own_color(doc, node_id)),
+                ));
+            }
+            backgrounds.push(match style.background {
+                Background::Color(c) => c,
+                Background::Current => color.unwrap_or_else(|| own_color(doc, node_id)),
+            });
+            if style.decoration.is_some() || top.as_ref().is_none_or(|t| t.decoration.is_none()) {
+                top = Some(style);
+            }
+        }
+        // A highlight's `currentcolor` decoration takes the colour its text is drawn in.
+        let highlight = top.map(|top| Highlight {
+            color,
+            owner: top.owner,
+            decoration: top
+                .decoration
+                .map(|decoration| Rc::new((*decoration).clone().with_current_color(color.unwrap_or_else(|| own_color(doc, node_id))))),
+            shadows: (!shadows.is_empty()).then(|| Rc::new(shadows)),
+        });
+        (backgrounds, highlight)
+    }
+}
+
+/// The colour of the text of `node_id` (its element's).
+fn own_color(doc: &BaseDocument, node_id: NodeId) -> Color {
+    let mut current = Some(node_id);
+    while let Some(id) = current {
+        let Some(node) = doc.get_node(id) else { break };
+        if let Some(style) = node.primary_styles() {
+            return style.clone_color().as_srgb_color();
+        }
+        current = node.parent;
+    }
+    Color::BLACK
+}
+
+/// The highlight of text whose innermost element is `node_id` with the highlights `cache.mask`
+/// (`None`: none applies), found once per paint of an inline root (`cache`).
+pub(crate) fn highlight_of(doc: &BaseDocument, node_id: NodeId, cache: &mut HighlightCache) -> Option<Highlight> {
+    let mask = cache.mask;
+    if let Some((_, highlight)) = cache.effective.iter().find(|(key, _)| *key == (node_id, mask)) {
+        return highlight.clone();
+    }
+    let (_, highlight) = cache.stack(doc, node_id, mask);
+    cache.effective.push(((node_id, mask), highlight.clone()));
+    highlight
+}
+
+type Style = style::servo_arc::Arc<style::properties::ComputedValues>;
+
+/// A highlight's colours from the nearest styles (the element's, its parent's, ...) that declare
+/// them, each property on its own (WPT `cascade-highlight-005`); `defaults` when none declares
+/// either (a UA's colours).
+fn resolve_layer(
+    doc: &BaseDocument,
+    node_id: NodeId,
+    style_of: impl Fn(NodeId) -> Option<Style>,
+    defaults: Option<(Color, Color)>,
+) -> LayerStyle {
+    use style::properties::LonghandId;
+    let mut nearest: Option<(NodeId, Style)> = None;
+    let mut color: Option<Style> = None;
+    let mut background: Option<Style> = None;
+    let mut current = Some(node_id);
+    while let Some(id) = current {
+        let Some(node) = doc.get_node(id) else { break };
+        if node.is_element()
+            && let Some(style) = style_of(id)
+        {
+            if color.is_none() && doc.style_declares(&style, &[LonghandId::Color]) {
+                color = Some(style.clone());
+            }
+            if background.is_none() && doc.style_declares(&style, &[LonghandId::BackgroundColor]) {
+                background = Some(style.clone());
+            }
+            nearest.get_or_insert((id, style));
+        }
+        if color.is_some() && background.is_some() {
+            break;
+        }
+        current = node.parent;
+    }
+    let decoration = nearest.as_ref().and_then(|(_, style)| own_decoration(style));
+    let owner = nearest.as_ref().map(|(id, _)| *id);
+    let nearest_style = nearest.map(|(_, style)| style);
+    match (color, background, defaults) {
+        (None, None, Some((background, text))) => LayerStyle {
+            color: Some(text),
+            background: Background::Color(background),
+            owner,
+            decoration: decoration.map(|decoration| Rc::new(decoration.with_current_color(text))),
+            style: nearest_style,
+        },
+        (color, background, _) => {
+            let color = color.and_then(|style| {
+                (!doc.style_declares_current_color(&style, LonghandId::Color)).then(|| style.clone_color().as_srgb_color())
+            });
+            let background = match background {
+                Some(style) => {
+                    let value = &style.get_background().background_color;
+                    if value.is_currentcolor() {
+                        Background::Current
+                    } else {
+                        Background::Color(value.resolve_to_absolute(&style.clone_color()).as_srgb_color())
+                    }
+                }
+                None => Background::Color(Color::TRANSPARENT),
+            };
+            LayerStyle { color, background, owner, decoration: decoration.map(Rc::new), style: nearest_style }
+        }
+    }
+}
+
+/// The `::selection` highlight of text whose innermost element is `node_id` (`None`: the text is
+/// not selectable). With no `::selection` style that declares `color` or `background-color`,
+/// the system's colours (CSS Pseudo-Elements 4 § 3.4, as Chromium).
+fn selection_style(doc: &BaseDocument, node_id: NodeId) -> Option<LayerStyle> {
+    use style::values::computed::UserSelect;
+    let mut current = Some(node_id);
+    while let Some(id) = current {
+        let Some(node) = doc.get_node(id) else { break };
+        // `auto` is what the parent's is (`none` stays `none` in the content of an element).
+        match node.primary_styles().map(|style| style.clone_user_select()) {
+            Some(UserSelect::None) => return None,
+            Some(UserSelect::Auto) | None => {}
+            Some(_) => break,
+        }
+        current = node.parent;
+    }
+    let style_of = |id: NodeId| {
+        let node = doc.get_node(id)?;
+        // pyro: a visited link's is computed with it taken as visited (`selection_pseudo_style`):
+        // its eager style, matched as unvisited, is missing when only `:visited` rules apply.
+        if doc.is_visited_link(id) {
+            return doc.selection_pseudo_style(id);
+        }
+        let eager = node.try_stylo_element_data().and_then(|data| {
+            data.get().and_then(|data| data.styles.pseudos.get(&PseudoElement::Selection).cloned())
+        })?;
+        // pyro: container units (`cqh`, ...) in an eager style resolve before layout gives the
+        // containers sizes: computed again now (WPT css-conditional
+        // `container-units-selection-pseudo`).
+        // pyro: and a visited link's, whose eager style matched `:link` (`selection_pseudo_style`
+        // takes it as visited).
+        use style::computed_value_flags::ComputedValueFlags;
+        if doc.is_visited_link(id) {
+            return doc.selection_pseudo_style(id);
+        }
+        if eager.flags.contains(ComputedValueFlags::USES_CONTAINER_UNITS) {
+            if let Some(again) = doc.selection_pseudo_style(id) {
+                return Some(again);
+            }
+        }
+        Some(eager)
+    };
+    Some(resolve_layer(doc, node_id, style_of, Some((HIGHLIGHT, HIGHLIGHT_TEXT))))
+}
+
+/// pyro: the colours a text control's selection is painted in (its `::selection` style, as on
+/// page text): the background, and the selected text's colour (`None`: its own). `text` is the
+/// control's text colour, for a `currentcolor` background.
+pub(crate) fn control_selection_colors(doc: &BaseDocument, node_id: NodeId, text: Color) -> (Color, Option<Color>) {
+    let Some(layer) = selection_style(doc, node_id) else {
+        return (Color::TRANSPARENT, None);
+    };
+    let background = match layer.background {
+        Background::Color(color) => color,
+        Background::Current => layer.color.unwrap_or(text),
+    };
+    (background, layer.color)
+}
+
+/// A custom highlight's or the target text's highlight of the text of `node_id`. The target text
+/// has the UA's `Mark` on `MarkText` unless a style declares its colours; a custom highlight
+/// draws nothing of its own then.
+fn named_style(doc: &BaseDocument, node_id: NodeId, name: &blitz_dom::HighlightName) -> Option<LayerStyle> {
+    let style_of = |id: NodeId| doc.highlight_pseudo_style(id, name);
+    let defaults = match name {
+        blitz_dom::HighlightName::TargetText => Some((MARK, MARK_TEXT)),
+        blitz_dom::HighlightName::Custom(_) => None,
+    };
+    Some(resolve_layer(doc, node_id, style_of, defaults))
+}
+
+/// A highlighted stretch of a line: from `x0` to `x1` (layout x), across `top..bottom` (layout
+/// y: the line box, grown to the content areas of its runs), with the highlights over it
+/// (`mask`) and their backgrounds, bottom first.
+#[derive(Clone, Debug)]
+struct Piece {
+    x0: f32,
+    x1: f32,
+    top: f32,
+    bottom: f32,
+    mask: u32,
+    backgrounds: SmallVec<[Color; 2]>,
+}
+
+/// The highlighted stretches of `line` (`ranges`: each a highlight's index and bytes of the
+/// layout's text), in visual order; atoms of one run next to each other with the same highlights
+/// make one.
+fn line_pieces(
+    doc: &BaseDocument,
+    line: &Line<'_, TextBrush>,
+    ranges: &[(usize, usize, usize)],
+    cache: &mut HighlightCache,
+) -> SmallVec<[Piece; 4]> {
+    let mut pieces: SmallVec<[Piece; 4]> = SmallVec::new();
+    let metrics = line.metrics();
+    let range = line.text_range();
+    if !ranges.iter().any(|&(_, start, end)| range.end > start && range.start < end) {
+        return pieces;
+    }
+    for item in line.items() {
+        let PositionedLayoutItem::GlyphRun(glyph_run) = item else { continue };
+        let run_range = glyph_run.run().text_range();
+        if !ranges.iter().any(|&(_, start, end)| run_range.end > start && run_range.start < end) {
+            continue;
+        }
+        let node_id = glyph_run.style().brush.id;
+        let (content_top, content_bottom) = line.span_content_area(glyph_run.style_index());
+        let top = content_top.min(metrics.block_min_coord);
+        let bottom = content_bottom.max(metrics.block_max_coord);
+        let advances: SmallVec<[f32; 64]> = glyph_run.glyphs().map(|glyph| glyph.advance).collect();
+        let (mut pen, mut index) = (glyph_run.offset(), 0);
+        for (text, count) in glyph_run.atom_texts() {
+            let Some(glyphs) = advances.get(index..index + count) else { break };
+            let advance: f32 = glyphs.iter().sum();
+            let mut mask = 0u32;
+            for &(layer, start, end) in ranges {
+                if text.start < end && text.end > start {
+                    mask |= 1 << layer;
+                }
+            }
+            // Highlights that do not apply to the text (`user-select: none`) leave it.
+            if mask != 0 {
+                for layer in 0..cache.layers.len() {
+                    if mask & (1 << layer) != 0 && cache.layer_style(doc, node_id, layer).is_none() {
+                        mask &= !(1 << layer);
+                    }
+                }
+            }
+            if mask != 0 && advance > 0.0 {
+                let (backgrounds, _) = cache.stack(doc, node_id, mask);
+                match pieces.last_mut() {
+                    Some(last) if (last.x1 - pen).abs() < 0.01 && last.mask == mask && last.backgrounds == backgrounds => {
+                        last.x1 = pen + advance;
+                        last.top = last.top.min(top);
+                        last.bottom = last.bottom.max(bottom);
+                    }
+                    _ => pieces.push(Piece { x0: pen, x1: pen + advance, top, bottom, mask, backgrounds }),
+                }
+            }
+            pen += advance;
+            index += count;
+        }
+    }
+    pieces
+}
+
+/// The alpha of the empty layer that asks the renderer to clip what the clip layer pushed after
+/// it holds as a clip path, each draw on its own, as Skia clips (anyrender_vello_cpu's
+/// `CLIP_PATH_HINT_ALPHA`).
+const CLIP_PATH_HINT_ALPHA: f32 = 1.0 - 2.0 * f32::EPSILON;
+
+/// pyro: pushes a clip of the text of a line around or in its highlighted stretches, which are on
+/// whole pixels where the text is only moved: a clip path, not a clip layer, so the text it
+/// clips is composited once as text drawn without a highlight is (a layer rounds it twice; WPT
+/// css-pseudo `highlight-painting-003`). Popped with `pop_layer`.
+fn push_clip_path<S: PaintScene>(scene: &mut S, transform: Affine, clip: &BezPath) {
+    scene.push_layer(
+        Fill::NonZero,
+        peniko::BlendMode::default(),
+        CLIP_PATH_HINT_ALPHA,
+        Affine::IDENTITY,
+        &Rect::ZERO,
+        None,
+        None,
+    );
+    scene.pop_layer();
+    scene.push_clip_layer(Fill::NonZero, transform, clip);
+}
+
+/// Strokes an inline root's text with its highlights (`ranges`: each a highlight's index in
+/// `layers`, bottom first, and bytes of its text; see the module): line by line, the highlights'
+/// backgrounds, then the text outside the highlighted stretches, then the text in them in the
+/// colours of their highlights. `transform` is the root's text's, `tops` where its lines go;
+/// `context` has the text's shift and line tops set.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn stroke_highlighted_text<S: PaintScene>(
+    scene: &mut S,
+    doc: &BaseDocument,
+    root: NodeId,
+    layout: &Layout<TextBrush>,
+    text: &str,
+    line_transform: impl Fn(usize) -> Affine,
+    tops: Option<LineTops>,
+    options: TextPaintOptions,
+    layers: &[Layer],
+    ranges: &[(usize, usize, usize)],
+    context: &mut DrawTextContext,
+    // pyro: how the runs of a vertical line sit in it (lines turned by `line_transform`).
+    vertical: impl Fn(&parley::Line<'_, TextBrush>) -> Option<crate::text::VerticalLine>,
+) {
+    let scale = options.scale;
+    let shift = context.text_shift;
+    let mut cache = std::mem::take(&mut context.highlights);
+    cache.clear();
+    cache.layers.clear();
+    cache.layers.extend_from_slice(layers);
+    for (index, line) in layout.lines().enumerate() {
+        let transform = line_transform(index);
+        let turned = vertical(&line);
+        let [a, b, c, d, tx, ty] = transform.as_coeffs();
+        let translation_only = (a, b, c, d) == (1.0, 0.0, 0.0, 1.0);
+        let axis_aligned = (a == 0.0 && d == 0.0) || (b == 0.0 && c == 0.0);
+        let pieces = line_pieces(doc, &line, ranges, &mut cache);
+        if pieces.is_empty() {
+            context.highlights = std::mem::take(&mut cache);
+            stroke_text(
+                scene,
+                std::iter::once(line),
+                doc,
+                transform,
+                options,
+                root,
+                Some(text),
+                context,
+                turned,
+                Some(layout),
+            );
+            cache = std::mem::take(&mut context.highlights);
+            continue;
+        }
+        let line_shift = tops.map_or(0.0, |tops| tops.shift(line.metrics()));
+        // A piece's rectangle in the space of `transform`: on whole CSS px where the text is only
+        // moved, as inline boxes are placed (`inline_box_fragments`).
+        let rect = |piece: &Piece| {
+            let rect = Rect::new(
+                f64::from(piece.x0) + shift,
+                f64::from(piece.top) + line_shift,
+                f64::from(piece.x1) + shift,
+                f64::from(piece.bottom) + line_shift,
+            );
+            if translation_only {
+                let snap = |v: f64, t: f64| ((t + v) / scale).round() * scale - t;
+                Rect::new(snap(rect.x0, tx), snap(rect.y0, ty), snap(rect.x1, tx), snap(rect.y1, ty))
+            } else if axis_aligned {
+                // pyro: a vertical line (turned a quarter): on whole CSS px where it lands, as
+                // the inline boxes of vertical text are placed.
+                let snap = |v: f64| (v / scale).round() * scale;
+                let placed = transform.transform_rect_bbox(rect);
+                let snapped = Rect::new(snap(placed.x0), snap(placed.y0), snap(placed.x1), snap(placed.y1));
+                transform.inverse().transform_rect_bbox(snapped)
+            } else {
+                rect
+            }
+        };
+        let rects: SmallVec<[Rect; 4]> = pieces.iter().map(rect).collect();
+        const FAR: f64 = 1e6;
+        // pyro: what the passes in and outside the stretches are clipped to: a stretch over the
+        // line's whole content reaches past its ends, so what its text draws beyond the text
+        // (a wavy line's ends) is drawn in the highlight's colours too, as Chromium does (WPT
+        // css-text-decor `selection-pseudo-with-decoration-invalidation-001`).
+        let metrics = line.metrics();
+        // (Its content: without the white space hanging at its end, the left in a right-to-left
+        // line.)
+        let hang = metrics.hanging_advance;
+        let (line_start, line_end) = match line.is_rtl() {
+            true => (metrics.inline_min_coord + hang, metrics.inline_min_coord + metrics.advance),
+            false => (metrics.inline_min_coord, metrics.inline_min_coord + metrics.advance - hang),
+        };
+        let clips: SmallVec<[Rect; 4]> = pieces
+            .iter()
+            .zip(&rects)
+            .map(|(piece, rect)| {
+                // (Only a stretch over the line's whole content: past a partly highlighted line's
+                // ends a wavy line's tips stay the text's own, as Blink paints them; WPT css-pseudo
+                // `highlight-painting-004`.)
+                let whole = piece.x0 <= line_start + 0.5 && piece.x1 >= line_end - 0.5;
+                let x0 = if whole { -FAR } else { rect.x0 };
+                let x1 = if whole { FAR } else { rect.x1 };
+                Rect::new(x0, rect.y0, x1, rect.y1)
+            })
+            .collect();
+        // The shadows the text casts in the stretches, under their backgrounds (as Chromium:
+        // the highlights paint over the originating text's shadows).
+        if options.shadows {
+            let mut inside = BezPath::new();
+            for rect in &clips {
+                inside.extend(Rect::new(rect.x0, -FAR, rect.x1, FAR).path_elements(0.1));
+            }
+            context.highlights = std::mem::take(&mut cache);
+            context.shadows_only = true;
+            push_clip_path(scene, transform, &inside);
+            stroke_text(
+                scene,
+                std::iter::once(line),
+                doc,
+                transform,
+                options,
+                root,
+                Some(text),
+                context,
+                turned,
+                Some(layout),
+            );
+            scene.pop_layer();
+            context.shadows_only = false;
+            cache = std::mem::take(&mut context.highlights);
+        }
+        // pyro: the glyphs outside the stretches where they reach into one (an italic glyph's
+        // overhang), under its background: Chromium paints the highlight over them (WPT css-pseudo
+        // `selection-background-painting-order`). Not in vertical lines, whose turned runs place
+        // glyphs off their layout positions (`glyph_spans` would take selected ones too).
+        if turned.is_none() {
+            let mut spans: SmallVec<[(f32, f32); 4]> = pieces.iter().map(|p| (p.x0, p.x1)).collect();
+            spans.sort_by(|p, q| p.0.total_cmp(&q.0));
+            let mut gaps: SmallVec<[(f32, f32); 4]> = SmallVec::new();
+            let mut x = f32::NEG_INFINITY;
+            for (x0, x1) in &spans {
+                if *x0 > x {
+                    gaps.push((x, *x0));
+                }
+                x = x.max(*x1);
+            }
+            gaps.push((x, f32::INFINITY));
+            let mut inside = BezPath::new();
+            for rect in &rects {
+                inside.extend(Rect::new(rect.x0, -FAR, rect.x1, FAR).path_elements(0.1));
+            }
+            push_clip_path(scene, transform, &inside);
+            context.highlights = std::mem::take(&mut cache);
+            context.glyph_spans = Some(gaps);
+            context.glyphs_only = true;
+            stroke_text(
+                scene,
+                std::iter::once(line.clone()),
+                doc,
+                transform,
+                TextPaintOptions { shadows: false, ..options },
+                root,
+                Some(text),
+                context,
+                turned,
+                Some(layout),
+            );
+            context.glyph_spans = None;
+            context.glyphs_only = false;
+            cache = std::mem::take(&mut context.highlights);
+            scene.pop_layer();
+        }
+        for (piece, rect) in pieces.iter().zip(&rects) {
+            for background in &piece.backgrounds {
+                if background.components[3] > 0.0 && rect.width() > 0.0 {
+                    scene.fill(Fill::NonZero, transform, *background, None, rect);
+                }
+            }
+        }
+        // The text outside the stretches (across the whole height: glyphs and decorations reach
+        // past the line box), then inside them, a pass per set of highlights.
+        // pyro: the text before the first stretch (in the line's direction) and the rest: as in
+        // Chromium, the highlights' shadows paint over the text after the first stretch and
+        // under the text before it (WPT css-pseudo `highlight-painting-002`,
+        // `highlight-painting-shadows-horizontal`).
+        let mut outside = BezPath::new();
+        let (mut before, mut after) = (BezPath::new(), BezPath::new());
+        let rtl = line.is_rtl();
+        let mut x = -FAR;
+        let mut sorted: SmallVec<[(Rect, u32); 4]> = clips.iter().copied().zip(pieces.iter().map(|p| p.mask)).collect();
+        sorted.sort_by(|p, q| p.0.x0.total_cmp(&q.0.x0));
+        let mut gaps: SmallVec<[Rect; 4]> = SmallVec::new();
+        for (rect, _) in &sorted {
+            if rect.x0 > x {
+                gaps.push(Rect::new(x, -FAR, rect.x0, FAR));
+            }
+            x = x.max(rect.x1);
+        }
+        gaps.push(Rect::new(x, -FAR, FAR, FAR));
+        let first = if rtl { gaps.len() - 1 } else { 0 };
+        for (index, gap) in gaps.iter().enumerate() {
+            outside.extend(gap.path_elements(0.1));
+            let leads = index == first && (if rtl { gap.x0 > -FAR } else { gap.x1 < FAR });
+            if leads { &mut before } else { &mut after }.extend(gap.path_elements(0.1));
+        }
+        context.highlights = std::mem::take(&mut cache);
+        let mut masks: SmallVec<[u32; 4]> = sorted.iter().map(|(_, mask)| *mask).collect();
+        masks.sort_unstable();
+        masks.dedup();
+        // pyro: the shadows first, all text after them (as Chromium: unselected text paints over
+        // the highlights' shadows; WPT css-pseudo `highlight-painting-shadows-horizontal`): the
+        // shadows of the text outside the stretches, then each highlight's, cast by its glyphs
+        // alone (unclipped).
+        if options.shadows {
+            context.shadows_only = true;
+            push_clip_path(scene, transform, &outside);
+            stroke_text(
+                scene,
+                std::iter::once(line),
+                doc,
+                transform,
+                options,
+                root,
+                Some(text),
+                context,
+                turned,
+                Some(layout),
+            );
+            scene.pop_layer();
+            context.shadows_only = false;
+        }
+        let outside_text = |scene: &mut S, context: &mut DrawTextContext, clip: &BezPath| {
+            push_clip_path(scene, transform, clip);
+            stroke_text(
+                scene,
+                std::iter::once(line),
+                doc,
+                transform,
+                TextPaintOptions { shadows: false, ..options },
+                root,
+                Some(text),
+                context,
+                turned,
+                Some(layout),
+            );
+            scene.pop_layer();
+        };
+        outside_text(scene, context, &after);
+        if options.shadows {
+            context.shadows_only = true;
+            for &mask in &masks {
+                context.highlights.mask = mask;
+                context.highlighting = true;
+                context.glyph_spans = Some(
+                    pieces.iter().filter(|piece| piece.mask == mask).map(|piece| (piece.x0, piece.x1)).collect(),
+                );
+                stroke_text(
+                    scene,
+                    std::iter::once(line),
+                    doc,
+                    transform,
+                    options,
+                    root,
+                    Some(text),
+                    context,
+                    turned,
+                    Some(layout),
+                );
+                context.glyph_spans = None;
+                context.highlighting = false;
+            }
+            context.shadows_only = false;
+        }
+        if !before.is_empty() {
+            outside_text(scene, context, &before);
+        }
+        for mask in masks {
+            let mut inside = BezPath::new();
+            for (rect, _) in sorted.iter().filter(|(_, m)| *m == mask) {
+                inside.extend(Rect::new(rect.x0, -FAR, rect.x1, FAR).path_elements(0.1));
+            }
+            context.highlights.mask = mask;
+            context.highlighting = true;
+            push_clip_path(scene, transform, &inside);
+            let selected = TextPaintOptions { shadows: false, ..options };
+            stroke_text(
+                scene,
+                std::iter::once(line),
+                doc,
+                transform,
+                selected,
+                root,
+                Some(text),
+                context,
+                turned,
+                Some(layout),
+            );
+            context.highlighting = false;
+            scene.pop_layer();
+        }
+        cache = std::mem::take(&mut context.highlights);
+    }
+    context.highlights = cache;
+}
diff --git a/packages/blitz-paint/src/kurbo_css/contoured.rs b/packages/blitz-paint/src/kurbo_css/contoured.rs
new file mode 100644
--- /dev/null
+++ b/packages/blitz-paint/src/kurbo_css/contoured.rs
@@ -0,0 +1,1116 @@
+//! pyro: corner shapes (CSS Borders 4 `corner-shape`, `superellipse()`), drawn as Blink draws them
+//! (`ContouredRect` and `ContouredRect::Corner` in `platform/geometry/contoured_rect.cc`,
+//! `PathBuilder::AddContouredRect` and `CornerClipOutPath` in `platform/geometry/path_builder.cc`,
+//! `ComputeContouredBorderFromStyle` in `core/paint/contoured_border_geometry.cc`).
+//!
+//! A corner is the quarter of a superellipse of exponent `2^k` in the box its radii make
+//! (`k` = 1 is round, 0 a bevel, -1 a scoop, ±∞ square and notch). The border box's own contour
+//! follows the corners as given. A box inset or outset from it (the padding box, a shadow, an
+//! outline) keeps its curves aligned with the border box's, so that a border looks as thick along
+//! the curve as along the sides: it is its rectangle less each corner's "clip-out" region, the
+//! area outside a curve moved inwards along its normals by the inset (Blink takes the regions out
+//! with Skia's path ops; [`boolean`] does it on flattened outlines here).
+
+use std::f64::consts::{FRAC_1_SQRT_2, SQRT_2};
+
+use kurbo::{BezPath, PathEl, Point, Rect, Shape as _, Vec2};
+
+use super::NonUniformRoundedRectRadii;
+
+/// The exponents of Blink's `ContouredRect::CornerCurvature`.
+pub const ROUND: f64 = 2.0;
+pub const BEVEL: f64 = 1.0;
+pub const STRAIGHT: f64 = 1000.0;
+pub const NOTCH: f64 = 1.0 / STRAIGHT;
+/// `Superellipse::kHighCurvatureThreshold`: parameters beyond ±16 draw as ±16.
+const HIGH_CURVATURE: f64 = 16.0;
+/// How finely corner curves are flattened (device px). vello_cpu flattens the curves it fills to
+/// within 0.25px (`vello_common::flatten::TOL`), which leaves a curve's antialiased pixels up
+/// to a quarter of their range off where Skia draws them; a corner-shaped edge is drawn as the
+/// polygon flattened here instead, as close to the curve as Chromium draws it.
+const FLATTEN_TOLERANCE: f64 = 0.02;
+
+/// The exponent of a corner whose `superellipse()` parameter is `k` (`Superellipse::Exponent`):
+/// `2^k`, `k` clamped to ±16.
+pub fn exponent(k: f64) -> f64 {
+    if k.is_nan() {
+        return ROUND;
+    }
+    // An interpolated keyword (`round` to `round`) comes back a hair off its value.
+    let k = if (k - k.round()).abs() < 1e-4 { k.round() } else { k };
+    2f64.powf(k.clamp(-HIGH_CURVATURE, HIGH_CURVATURE))
+}
+
+/// Whether a corner of parameter `k` has no radius at all (`Superellipse::IsDegenerate`: square,
+/// or so close to it that nothing would show).
+pub fn is_degenerate(k: f64) -> bool {
+    k >= HIGH_CURVATURE
+}
+
+fn clamp_curvature(curvature: f64) -> f64 {
+    curvature.clamp(NOTCH, STRAIGHT)
+}
+
+/// The exponent of each corner of a box (`ContouredRect::CornerCurvature`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CornerCurvature {
+    pub top_left: f64,
+    pub top_right: f64,
+    pub bottom_right: f64,
+    pub bottom_left: f64,
+}
+
+impl CornerCurvature {
+    pub const ROUND: Self = Self {
+        top_left: ROUND,
+        top_right: ROUND,
+        bottom_right: ROUND,
+        bottom_left: ROUND,
+    };
+
+    pub fn is_round(&self) -> bool {
+        *self == Self::ROUND
+    }
+
+    pub fn is_convex(&self) -> bool {
+        [self.top_left, self.top_right, self.bottom_right, self.bottom_left]
+            .iter()
+            .all(|&c| c >= BEVEL)
+    }
+}
+
+fn normalize(v: Vec2) -> Vec2 {
+    let length = v.hypot();
+    if length == 0.0 || !length.is_finite() {
+        v
+    } else {
+        v / length
+    }
+}
+
+fn cross(a: Vec2, b: Vec2) -> f64 {
+    a.x * b.y - a.y * b.x
+}
+
+/// The intersection of the lines through `a0`, `a1` and through `b0`, `b1`.
+fn line_intersection(a0: Point, a1: Point, b0: Point, b1: Point) -> Option<Point> {
+    let (a, b) = (a1 - a0, b1 - b0);
+    let denominator = cross(a, b);
+    if denominator.abs() < 1e-6 {
+        return None;
+    }
+    Some(a0 + a * (cross(b0 - a0, b) / denominator))
+}
+
+/// The intersection of the segment `a0`-`a1` with the line through `b0`, `b1`, or of the
+/// segment `b0`-`b1` with the line through `a0`, `a1` (Blink's `SegmentLineIntersection`).
+fn segment_line_intersection(a0: Point, a1: Point, b0: Point, b1: Point) -> Option<Point> {
+    let (a, b) = (a1 - a0, b1 - b0);
+    let denominator = cross(a, b);
+    if denominator.abs() < 1e-6 {
+        return None;
+    }
+    let offset = b0 - a0;
+    let a_scale = cross(offset, b) / denominator;
+    if (0.0..=1.0).contains(&a_scale) {
+        return Some(a0 + a * a_scale);
+    }
+    let b_scale = cross(offset, a) / denominator;
+    if (0.0..=1.0).contains(&b_scale) {
+        return Some(b0 + b * b_scale);
+    }
+    None
+}
+
+/// One corner of a contour: an axis-aligned quad whose points are, clockwise, where the curve
+/// starts, the box's corner, where it ends, and the corner's centre (Blink's
+/// `ContouredRect::Corner`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Corner {
+    v: [Point; 4],
+    curvature: f64,
+}
+
+impl Corner {
+    /// The corner of `rect` (a corner's box) turned `rotation` quarters: 0 top right, 1 bottom
+    /// right, 2 bottom left, 3 top left.
+    fn from_rect(rect: Rect, rotation: usize, curvature: f64) -> Self {
+        let mut v = [
+            Point::new(rect.x0, rect.y0),
+            Point::new(rect.x1, rect.y0),
+            Point::new(rect.x1, rect.y1),
+            Point::new(rect.x0, rect.y1),
+        ];
+        v.rotate_left(rotation);
+        Self { v, curvature }
+    }
+
+    fn new(v: [Point; 4], curvature: f64) -> Self {
+        Self {
+            v,
+            curvature: clamp_curvature(curvature),
+        }
+    }
+
+    fn start(&self) -> Point {
+        self.v[0]
+    }
+    fn outer(&self) -> Point {
+        self.v[1]
+    }
+    fn end(&self) -> Point {
+        self.v[2]
+    }
+    fn center(&self) -> Point {
+        self.v[3]
+    }
+    fn v1(&self) -> Vec2 {
+        self.outer() - self.start()
+    }
+    fn v2(&self) -> Vec2 {
+        self.end() - self.outer()
+    }
+    fn v3(&self) -> Vec2 {
+        self.center() - self.end()
+    }
+    fn v4(&self) -> Vec2 {
+        self.start() - self.center()
+    }
+    fn is_straight(&self) -> bool {
+        self.curvature == STRAIGHT
+    }
+    fn is_bevel(&self) -> bool {
+        self.curvature == BEVEL
+    }
+    fn is_round(&self) -> bool {
+        self.curvature == ROUND
+    }
+    fn is_notch(&self) -> bool {
+        self.curvature == NOTCH
+    }
+    fn is_concave(&self) -> bool {
+        self.curvature < 1.0
+    }
+    fn is_empty(&self) -> bool {
+        self.v1().hypot() == 0.0 || self.v2().hypot() == 0.0
+    }
+
+    /// The corner bulging the other way (a scoop for a round corner).
+    fn inverse(&self) -> Self {
+        Self::new(
+            [self.start(), self.center(), self.end(), self.outer()],
+            1.0 / self.curvature,
+        )
+    }
+
+    fn bounding_box(&self) -> Rect {
+        Rect::from_points(self.start(), self.end())
+    }
+
+    /// A point of the unit corner (`(0, 1)` the start, `(1, 0)` the end, `(1, 1)` the outer
+    /// corner) in this corner.
+    fn map_point(&self, x: f64, y: f64) -> Point {
+        self.center() + self.v1() * x + self.v4() * y
+    }
+
+    /// This corner (of an inset or outset box) moved so that its curve stays parallel to
+    /// `origin`'s, the corner it was inset from: `ContouredRect::Corner::AlignedToOrigin`.
+    fn aligned_to_origin(&self, origin: &Corner, edge_inset_start: f64, edge_inset_end: f64) -> Corner {
+        if origin.is_empty() || self == origin {
+            return *self;
+        }
+        let start_radius = origin.v2().hypot();
+        let end_radius = origin.v3().hypot();
+        // Insets beyond the radius are kept (the inset box's radii stopped at zero).
+        let start_inset = if edge_inset_start >= 0.0 && self.v2().hypot() == 0.0 {
+            edge_inset_start
+        } else {
+            start_radius - self.v2().hypot()
+        };
+        let end_inset = if edge_inset_end >= 0.0 && self.v3().hypot() == 0.0 {
+            edge_inset_end
+        } else {
+            end_radius - self.v3().hypot()
+        };
+        let parameter = origin.curvature.log2();
+        let exponent = 2f64.powf(parameter.abs());
+        let convex_half_corner = 0.5f64.powf(1.0 / exponent);
+        let half_corner = if parameter < 0.0 {
+            1.0 - convex_half_corner
+        } else {
+            convex_half_corner
+        };
+        let control_point_x = (half_corner / (SQRT_2 - 1.0) - FRAC_1_SQRT_2).clamp(0.0, 1.0);
+        let inset_difference = (end_inset - start_inset).clamp(-start_radius, end_radius);
+
+        let mut start_control_point_x = control_point_x;
+        let mut end_control_point_x = control_point_x;
+        if inset_difference != 0.0 {
+            let bevel_normal_delta = (start_radius * start_radius + end_radius * end_radius
+                - inset_difference * inset_difference)
+                .max(0.0)
+                .sqrt();
+            let bevel_normal_x = end_radius * inset_difference + start_radius * bevel_normal_delta;
+            let bevel_normal_y = -start_radius * inset_difference + end_radius * bevel_normal_delta;
+            let bevel_control_point_x = start_radius * bevel_normal_y
+                / (start_radius * bevel_normal_y + end_radius * bevel_normal_x);
+            start_control_point_x = if parameter < 0.0 {
+                bevel_control_point_x * (2.0 * control_point_x)
+            } else {
+                1.0 - (1.0 - bevel_control_point_x) * (2.0 * (1.0 - control_point_x))
+            };
+            end_control_point_x = 2.0 * control_point_x - start_control_point_x;
+        }
+
+        let unmapped_start_normal = normalize(Vec2::new(
+            (1.0 - start_control_point_x) * start_radius,
+            start_control_point_x * end_radius,
+        ));
+        let unmapped_end_normal = normalize(Vec2::new(
+            end_control_point_x * start_radius,
+            (1.0 - end_control_point_x) * end_radius,
+        ));
+        let v3 = normalize(origin.v3());
+        let v2 = normalize(origin.v2());
+        let start_normal = v3 * unmapped_start_normal.x + v2 * unmapped_start_normal.y;
+        let end_normal = v3 * unmapped_end_normal.x + v2 * unmapped_end_normal.y;
+
+        let original_outer = self.outer() - v3 * end_inset - v2 * start_inset;
+        let mut adjusted_start = original_outer + v3 * end_radius + start_normal * start_inset;
+        let mut adjusted_end = original_outer + v2 * start_radius + end_normal * end_inset;
+
+        let start_tangent = Vec2::new(-start_normal.y, start_normal.x);
+        let end_tangent = Vec2::new(-end_normal.y, end_normal.x);
+        if parameter >= 0.0 && start_inset < 0.0 {
+            adjusted_start = line_intersection(
+                adjusted_start,
+                adjusted_start - start_tangent,
+                self.outer() + v3,
+                self.outer(),
+            )
+            .unwrap_or(adjusted_start);
+        }
+        if parameter >= 0.0 && end_inset < 0.0 {
+            adjusted_end = line_intersection(
+                adjusted_end,
+                adjusted_end + end_tangent,
+                self.outer() + v2,
+                self.outer(),
+            )
+            .unwrap_or(adjusted_end);
+        }
+
+        let adjusted_height = (adjusted_end - adjusted_start).dot(v2);
+        let adjusted_outer = adjusted_end - v2 * adjusted_height;
+        let adjusted_center = adjusted_start + v2 * adjusted_height;
+        if parameter <= -1.0 || parameter >= 0.0 {
+            return Corner::new(
+                [adjusted_start, adjusted_outer, adjusted_end, adjusted_center],
+                origin.curvature,
+            );
+        }
+
+        // Between a scoop and a bevel the aligned curve is the ellipse arc tangent to the
+        // normals' tangents at both ends.
+        let tangent_intersection = line_intersection(
+            adjusted_start,
+            adjusted_start - start_tangent,
+            adjusted_end,
+            adjusted_end + end_tangent,
+        )
+        .unwrap_or(adjusted_start);
+        Corner::new(
+            [
+                adjusted_start,
+                tangent_intersection,
+                adjusted_end,
+                adjusted_start + (adjusted_end - tangent_intersection),
+            ],
+            ROUND,
+        )
+    }
+}
+
+/// The x (and y) of a unit superellipse corner at its middle (`HalfCornerForCurvature`).
+/// pyro: a concave corner (an exponent below 1) is the convex one of the inverse exponent
+/// mirrored, as CSS Borders 4 § 3.9.6 defines its half corner (`1 - 0.5^(1/n)` of that convex
+/// corner): a scoop's middle is on its circle, not at Blink's `0.5^(1/n)` (WPT css-borders
+/// `corner-shape-opposite-scale-*`, whose hulls touch there).
+fn half_corner_for_curvature(curvature: f64) -> f64 {
+    let curvature = clamp_curvature(curvature);
+    // A notch (the exponent clamped to its least) is `K = -infinity`: its middle at the center.
+    if curvature <= NOTCH {
+        return 0.0;
+    }
+    if curvature < 1.0 {
+        return 1.0 - 0.5f64.powf(curvature);
+    }
+    0.5f64.powf(1.0 / curvature)
+}
+
+/// The cubic Bézier that follows half of a convex superellipse corner of exponent `curvature`,
+/// from its start `(0, 1)` to its middle (`ApproximateSuperellipseHalfCornerAsBezierCurve`):
+/// the two control points and the end.
+fn half_corner_cubic(curvature: f64) -> [Vec2; 3] {
+    const P: [f64; 7] = [
+        1.2430920942724248,
+        2.010479023614843,
+        0.32922901179443753,
+        0.2823023142212073,
+        1.3473704261055421,
+        2.9149468637949814,
+        0.9106507102917086,
+    ];
+    let s = curvature.log2();
+    let slope = P[0] + (P[6] - P[0]) * 0.5 * (1.0 + (P[5] * (s - P[1])).tanh());
+    let base = 1.0 / (1.0 + (-slope * (0.0 - P[1])).exp());
+    let logistic = 1.0 / (1.0 + (-slope * (s - P[1])).exp());
+    let a = (logistic - base) / (1.0 - base);
+    let b = P[2] * (-P[3] * s.powf(P[4])).exp();
+    let half_corner = half_corner_for_curvature(curvature);
+    [
+        Vec2::new(a, 1.0),
+        Vec2::new(half_corner - b, half_corner + b),
+        Vec2::new(half_corner, half_corner),
+    ]
+}
+
+/// The kappa of a cubic Bézier quarter ellipse (the conic Skia draws a round corner with).
+const KAPPA: f64 = 0.552_284_749_830_793_4;
+
+/// Draws `corner`'s curve: a line to its start, then the curve to its end (`AddCurvedCorner`).
+fn add_curved_corner(path: &mut BezPath, corner: &Corner) {
+    if corner.is_concave() {
+        add_curved_corner(path, &corner.inverse());
+        return;
+    }
+    line_or_move_to(path, corner.start());
+    if corner.is_straight() || corner.is_empty() {
+        path.line_to(corner.outer());
+        path.line_to(corner.end());
+    } else if corner.is_bevel() {
+        path.line_to(corner.end());
+    } else if corner.is_round() {
+        let (start, outer, end) = (corner.start(), corner.outer(), corner.end());
+        path.curve_to(
+            start + (outer - start) * KAPPA,
+            end + (outer - end) * KAPPA,
+            end,
+        );
+    } else {
+        let [p1, p2, p3] = half_corner_cubic(corner.curvature);
+        path.curve_to(
+            corner.map_point(p1.x, p1.y),
+            corner.map_point(p2.x, p2.y),
+            corner.map_point(p3.x, p3.y),
+        );
+        path.curve_to(
+            corner.map_point(p2.y, p2.x),
+            corner.map_point(p1.y, p1.x),
+            corner.end(),
+        );
+    }
+}
+
+fn line_or_move_to(path: &mut BezPath, point: Point) {
+    if path.elements().is_empty() || matches!(path.elements().last(), Some(PathEl::ClosePath)) {
+        path.move_to(point);
+    } else {
+        path.line_to(point);
+    }
+}
+
+/// The region outside an inset corner's curve, aligned with its origin (`CornerClipOutPath`):
+/// what is taken out of the inset box's rectangle at that corner. `None` when nothing is.
+fn corner_clip_out_path(
+    origin: &Corner,
+    target: &Corner,
+    edge_inset_start: f64,
+    edge_inset_end: f64,
+) -> Option<BezPath> {
+    let start_radius = origin.v2().hypot();
+    let end_radius = origin.v3().hypot();
+    if start_radius == 0.0 || end_radius == 0.0 || origin.is_straight() {
+        return None;
+    }
+    let start_inset = if edge_inset_start >= 0.0 && target.v2().hypot() == 0.0 {
+        edge_inset_start
+    } else {
+        start_radius - target.v2().hypot()
+    };
+    let end_inset = if edge_inset_end >= 0.0 && target.v3().hypot() == 0.0 {
+        edge_inset_end
+    } else {
+        end_radius - target.v3().hypot()
+    };
+    let parameter = origin.curvature.log2();
+    let inset_difference = (end_inset - start_inset).clamp(-start_radius, end_radius);
+    if parameter <= 0.0 && (inset_difference == -start_radius || inset_difference == end_radius) {
+        return None;
+    }
+
+    let aligned = target.aligned_to_origin(origin, edge_inset_start, edge_inset_end);
+    let v3 = normalize(origin.v3());
+    let v2 = normalize(origin.v2());
+    let original_outer = target.outer() - v3 * end_inset - v2 * start_inset;
+    let original_start = original_outer + v3 * end_radius;
+    let original_end = original_outer + v2 * start_radius;
+
+    let mut miter_start = aligned.start();
+    let mut miter_end = aligned.end();
+    if parameter < 0.0 && start_inset < 0.0 {
+        let start_normal = normalize((aligned.start() - original_start) * (1.0 / start_inset));
+        let start_tangent = Vec2::new(-start_normal.y, start_normal.x);
+        miter_start = line_intersection(
+            aligned.start(),
+            aligned.start() - start_tangent,
+            target.outer() + v3,
+            target.outer(),
+        )
+        .unwrap_or(aligned.start());
+    }
+    if parameter < 0.0 && end_inset < 0.0 {
+        let end_normal = normalize((aligned.end() - original_end) * (1.0 / end_inset));
+        let end_tangent = Vec2::new(-end_normal.y, end_normal.x);
+        miter_end = line_intersection(
+            aligned.end(),
+            aligned.end() + end_tangent,
+            target.outer() + v2,
+            target.outer(),
+        )
+        .unwrap_or(aligned.end());
+    }
+
+    let self_intersection = if parameter < 0.0
+        && start_inset < 0.0
+        && end_inset < 0.0
+        && (-end_inset >= start_radius || -start_inset >= end_radius)
+    {
+        segment_line_intersection(miter_start, aligned.start(), miter_end, aligned.end())
+    } else {
+        None
+    };
+
+    let mut path = BezPath::new();
+    path.move_to(miter_start);
+    if let Some(point) = self_intersection {
+        path.line_to(point);
+    } else if origin.is_notch() {
+        path.line_to(aligned.center());
+    } else {
+        add_curved_corner(&mut path, &aligned);
+    }
+    path.line_to(miter_end);
+    path.line_to(target.outer());
+    path.close_path();
+    Some(path)
+}
+
+/// The box of each corner of a rounded rect, as Blink's `FloatRoundedRect::*Corner()`, in the
+/// order top right, bottom right, bottom left, top left.
+fn corner_rects(rect: Rect, radii: &NonUniformRoundedRectRadii) -> [Rect; 4] {
+    let (tl, tr, br, bl) = (radii.top_left, radii.top_right, radii.bottom_right, radii.bottom_left);
+    [
+        Rect::new(rect.x1 - tr.x, rect.y0, rect.x1, rect.y0 + tr.y),
+        Rect::new(rect.x1 - br.x, rect.y1 - br.y, rect.x1, rect.y1),
+        Rect::new(rect.x0, rect.y1 - bl.y, rect.x0 + bl.x, rect.y1),
+        Rect::new(rect.x0, rect.y0, rect.x0 + tl.x, rect.y0 + tl.y),
+    ]
+}
+
+/// A box with shaped corners, possibly inset or outset from another (`ContouredRect`).
+#[derive(Clone, Debug, PartialEq)]
+pub struct ContouredRect {
+    pub rect: Rect,
+    pub radii: NonUniformRoundedRectRadii,
+    pub curvature: CornerCurvature,
+    /// The box (usually the border box) this one was inset or outset from, with its radii:
+    /// the corners' curves stay parallel to its.
+    pub origin: Option<(Rect, NonUniformRoundedRectRadii)>,
+}
+
+impl ContouredRect {
+    fn curvatures(&self) -> [f64; 4] {
+        let c = &self.curvature;
+        [c.top_right, c.bottom_right, c.bottom_left, c.top_left]
+    }
+
+    fn corners_of(&self, rect: Rect, radii: &NonUniformRoundedRectRadii) -> [Corner; 4] {
+        let rects = corner_rects(rect, radii);
+        let curvatures = self.curvatures();
+        std::array::from_fn(|i| Corner::from_rect(rects[i], i, curvatures[i]))
+    }
+
+    /// The path of the contour.
+    pub fn path(&self) -> BezPath {
+        let rect = Rect::new(
+            self.rect.x0,
+            self.rect.y0,
+            self.rect.x1.max(self.rect.x0),
+            self.rect.y1.max(self.rect.y0),
+        );
+        let identity = match &self.origin {
+            None => true,
+            Some((origin, radii)) => *origin == rect && *radii == self.radii,
+        };
+        let targets = self.corners_of(rect, &self.radii);
+        if identity {
+            let mut path = BezPath::new();
+            path.move_to(targets[0].start());
+            for corner in &targets {
+                add_curved_corner(&mut path, corner);
+            }
+            path.close_path();
+            return polygons_path(&flatten(&path));
+        }
+        let (origin_rect, origin_radii) = self.origin.as_ref().unwrap();
+        let origins = self.corners_of(*origin_rect, origin_radii);
+        let insets = [
+            (rect.y0 - origin_rect.y0, origin_rect.x1 - rect.x1),
+            (origin_rect.x1 - rect.x1, origin_rect.y1 - rect.y1),
+            (origin_rect.y1 - rect.y1, rect.x0 - origin_rect.x0),
+            (rect.x0 - origin_rect.x0, rect.y0 - origin_rect.y0),
+        ];
+        let cuts: Vec<BezPath> = (0..4)
+            .filter_map(|i| corner_clip_out_path(&origins[i], &targets[i], insets[i].0, insets[i].1))
+            .collect();
+        if cuts.is_empty() {
+            return rect.to_path(0.1);
+        }
+        let mut shapes = vec![vec![rect_polygon(rect)]];
+        shapes.extend(cuts.iter().map(flatten));
+        boolean(&shapes, |inside| inside[0] && !inside[1..].iter().any(|&b| b))
+    }
+}
+
+/// `rect`'s corners, clockwise from the top left.
+pub fn rect_polygon(rect: Rect) -> Vec<Point> {
+    vec![
+        Point::new(rect.x0, rect.y0),
+        Point::new(rect.x1, rect.y0),
+        Point::new(rect.x1, rect.y1),
+        Point::new(rect.x0, rect.y1),
+    ]
+}
+
+/// A path of closed `polygons`.
+pub fn polygons_path(polygons: &[Vec<Point>]) -> BezPath {
+    let mut path = BezPath::new();
+    for polygon in polygons {
+        let Some((first, rest)) = polygon.split_first() else {
+            continue;
+        };
+        path.move_to(*first);
+        for p in rest {
+            path.line_to(*p);
+        }
+        path.close_path();
+    }
+    path
+}
+
+/// Every contour of `path` as a polygon, its curves flattened.
+pub fn flatten(path: &BezPath) -> Vec<Vec<Point>> {
+    flatten_with(path, FLATTEN_TOLERANCE)
+}
+
+/// Every contour of `path` as a polygon, its curves flattened to within `tolerance`.
+pub fn flatten_with(path: &BezPath, tolerance: f64) -> Vec<Vec<Point>> {
+    let mut polygons = Vec::new();
+    let mut current: Vec<Point> = Vec::new();
+    kurbo::flatten(path.elements().iter().copied(), tolerance, |el| match el {
+        PathEl::MoveTo(p) => {
+            if current.len() > 2 {
+                polygons.push(std::mem::take(&mut current));
+            }
+            current.clear();
+            current.push(p);
+        }
+        PathEl::LineTo(p) => {
+            if current.last() != Some(&p) {
+                current.push(p);
+            }
+        }
+        PathEl::ClosePath => {
+            if current.len() > 2 {
+                polygons.push(std::mem::take(&mut current));
+            }
+            current.clear();
+        }
+        _ => {}
+    });
+    if current.len() > 2 {
+        polygons.push(current);
+    }
+    polygons
+}
+
+/// The opposite-corner constraint for boxes with concave corners
+/// (`RadiiConstraintFactorForOppositeCorners`): the scale of the radii at which the hulls of two
+/// opposite corners touch without overlapping, 1 when they do not overlap.
+fn opposite_corners_constraint(a: &Corner, b: &Corner) -> f64 {
+    if !rects_intersect(a.bounding_box(), b.bounding_box()) {
+        return 1.0;
+    }
+    let (hull_a, hull_b) = (hull_quad(a), hull_quad(b));
+    if !quads_intersect(&hull_a, &hull_b) {
+        return 1.0;
+    }
+    const NEAR_TOUCHING: f64 = 1.0 - 5.0 * f32::EPSILON as f64;
+    if !quads_intersect(
+        &scale_quad(&hull_a, a.outer(), NEAR_TOUCHING),
+        &scale_quad(&hull_b, b.outer(), NEAR_TOUCHING),
+    ) {
+        return 1.0;
+    }
+    let (mut min, mut max) = (0.0f64, 1.0f64);
+    while max - min > 1e-6 {
+        let scale = (min + max) / 2.0;
+        if quads_intersect(&scale_quad(&hull_a, a.outer(), scale), &scale_quad(&hull_b, b.outer(), scale)) {
+            max = scale;
+        } else {
+            min = scale;
+        }
+    }
+    min
+}
+
+/// Blink's `gfx::RectF::Intersects`: overlapping with a positive area.
+fn rects_intersect(a: Rect, b: Rect) -> bool {
+    a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1
+}
+
+/// pyro: the corner's inner hull (CSS Borders 4 § 3.9.5 "normalized inner corner hull", without
+/// the outer corner, which no opposite hull reaches first): its start and end, and where the
+/// tangent at its half corner meets the lines from its center to them, taken in the unit corner
+/// (`x + y = 2h`) and mapped: Blink's tangent, perpendicular to the diagonal in the box's space,
+/// put them elsewhere in an elliptical corner (WPT css-borders `corner-shape-opposite-scale-elliptical`).
+fn hull_quad(corner: &Corner) -> [Point; 4] {
+    let h = half_corner_for_curvature(corner.curvature);
+    [corner.start(), corner.map_point(0.0, 2.0 * h), corner.map_point(2.0 * h, 0.0), corner.end()]
+}
+
+fn scale_quad(quad: &[Point; 4], origin: Point, scale: f64) -> [Point; 4] {
+    quad.map(|p| origin + (p - origin) * scale)
+}
+
+/// `gfx::QuadF::IntersectsQuad`: neither quad is wholly outside one edge of the other.
+fn quads_intersect(a: &[Point; 4], b: &[Point; 4]) -> bool {
+    !fully_outside_one_edge(a, b) && !fully_outside_one_edge(b, a)
+}
+
+fn fully_outside_one_edge(q: &[Point; 4], other: &[Point; 4]) -> bool {
+    let [p1, p2, p3, p4] = *q;
+    let counter_clockwise = {
+        let p24 = p2.y - p4.y;
+        let p31 = p3.y - p1.y;
+        p1.x * p24 + p2.x * p31 < p3.x * p24 + p4.x * p31
+    };
+    let edges = if counter_clockwise {
+        [(p1, p4 - p1), (p2, p1 - p2), (p3, p2 - p3), (p4, p3 - p4)]
+    } else {
+        [(p1, p2 - p1), (p2, p3 - p2), (p3, p4 - p3), (p4, p1 - p4)]
+    };
+    edges
+        .iter()
+        .any(|&(base, vector)| other.iter().all(|&p| cross(vector, p - base) < 0.0))
+}
+
+/// The radii of a box's corners scaled so that the hulls of opposite concave corners do not
+/// overlap (`ComputeContouredBorderFromStyle`), for a box whose radii already fit it.
+pub fn constrain_opposite_corners(
+    rect: Rect,
+    radii: NonUniformRoundedRectRadii,
+    curvature: &CornerCurvature,
+) -> NonUniformRoundedRectRadii {
+    if curvature.is_convex() {
+        return radii;
+    }
+    let contour = ContouredRect {
+        rect,
+        radii,
+        curvature: *curvature,
+        origin: None,
+    };
+    let [tr, br, bl, tl] = contour.corners_of(rect, &radii);
+    let factor = opposite_corners_constraint(&tl, &br)
+        .min(opposite_corners_constraint(&bl, &tr))
+        .min(1.0);
+    if factor >= 1.0 {
+        return radii;
+    }
+    let scale = |r: Vec2| {
+        let r = r * factor;
+        if r.x == 0.0 || r.y == 0.0 { Vec2::ZERO } else { r }
+    };
+    NonUniformRoundedRectRadii {
+        top_left: scale(radii.top_left),
+        top_right: scale(radii.top_right),
+        bottom_right: scale(radii.bottom_right),
+        bottom_left: scale(radii.bottom_left),
+    }
+}
+
+// ---------- Polygon boolean ----------
+
+/// A point index, snapping points within `SNAP` of each other together.
+struct Points {
+    points: Vec<Point>,
+    cells: std::collections::HashMap<(i64, i64), Vec<usize>>,
+}
+
+const SNAP: f64 = 1e-6;
+
+impl Points {
+    fn new() -> Self {
+        Self {
+            points: Vec::new(),
+            cells: std::collections::HashMap::new(),
+        }
+    }
+
+    fn cell(p: Point) -> (i64, i64) {
+        ((p.x / SNAP).floor() as i64, (p.y / SNAP).floor() as i64)
+    }
+
+    fn id(&mut self, p: Point) -> usize {
+        let (cx, cy) = Self::cell(p);
+        for dx in -1..=1 {
+            for dy in -1..=1 {
+                if let Some(ids) = self.cells.get(&(cx + dx, cy + dy)) {
+                    for &id in ids {
+                        let q = self.points[id];
+                        if (q.x - p.x).abs() <= SNAP && (q.y - p.y).abs() <= SNAP {
+                            return id;
+                        }
+                    }
+                }
+            }
+        }
+        let id = self.points.len();
+        self.points.push(p);
+        self.cells.entry((cx, cy)).or_default().push(id);
+        id
+    }
+}
+
+/// The nonzero winding number of `polygon` around `p`.
+fn winding(polygon: &[Point], p: Point) -> i32 {
+    let mut w = 0;
+    let n = polygon.len();
+    for i in 0..n {
+        let (a, b) = (polygon[i], polygon[(i + 1) % n]);
+        if a.y <= p.y {
+            if b.y > p.y && cross(b - a, p - a) > 0.0 {
+                w += 1;
+            }
+        } else if b.y <= p.y && cross(b - a, p - a) < 0.0 {
+            w -= 1;
+        }
+    }
+    w
+}
+
+/// The region of the plane that `inside` selects, given whether a point is inside each of
+/// `shapes` (each a set of polygons, filled by the nonzero rule), as a path of closed polygons
+/// wound so that it fills with the nonzero rule. Edges are split where they cross, kept where
+/// the selection differs on their two sides, and joined into loops.
+pub fn boolean(shapes: &[Vec<Vec<Point>>], inside: impl Fn(&[bool]) -> bool) -> BezPath {
+    struct Segment {
+        a: Point,
+        b: Point,
+        bounds: Rect,
+        splits: Vec<(f64, Point)>,
+    }
+    let mut segments: Vec<Segment> = Vec::new();
+    for polygon in shapes.iter().flatten() {
+        let n = polygon.len();
+        for i in 0..n {
+            let (a, b) = (polygon[i], polygon[(i + 1) % n]);
+            if (b - a).hypot() <= SNAP {
+                continue;
+            }
+            segments.push(Segment {
+                a,
+                b,
+                bounds: Rect::from_points(a, b).inflate(SNAP, SNAP),
+                splits: Vec::new(),
+            });
+        }
+    }
+    let bounds: Vec<Rect> = shapes
+        .iter()
+        .map(|shape| {
+            shape.iter().flatten().fold(
+                Rect::new(f64::MAX, f64::MAX, f64::MIN, f64::MIN),
+                |r, &q| Rect::new(r.x0.min(q.x), r.y0.min(q.y), r.x1.max(q.x), r.y1.max(q.y)),
+            )
+        })
+        .collect();
+
+    // Split every segment where another crosses or touches it.
+    for i in 0..segments.len() {
+        for j in i + 1..segments.len() {
+            let (s, t) = (&segments[i], &segments[j]);
+            if s.bounds.x1 < t.bounds.x0
+                || t.bounds.x1 < s.bounds.x0
+                || s.bounds.y1 < t.bounds.y0
+                || t.bounds.y1 < s.bounds.y0
+            {
+                continue;
+            }
+            let (a, b, c, d) = (s.a, s.b, t.a, t.b);
+            let (r, q) = (b - a, d - c);
+            let (rl, ql) = (r.hypot(), q.hypot());
+            let denominator = cross(r, q);
+            let mut on_s: Vec<(f64, Point)> = Vec::new();
+            let mut on_t: Vec<(f64, Point)> = Vec::new();
+            if denominator.abs() > 1e-12 * rl * ql {
+                let u = cross(c - a, q) / denominator;
+                let v = cross(c - a, r) / denominator;
+                let (eu, ev) = (SNAP / rl, SNAP / ql);
+                if u >= -eu && u <= 1.0 + eu && v >= -ev && v <= 1.0 + ev {
+                    let p = a + r * u.clamp(0.0, 1.0);
+                    on_s.push((u.clamp(0.0, 1.0), p));
+                    on_t.push((v.clamp(0.0, 1.0), p));
+                }
+            } else if (cross(r, c - a) / rl).abs() <= SNAP {
+                // Collinear: each splits the other at its ends.
+                for p in [c, d] {
+                    let u = (p - a).dot(r) / (rl * rl);
+                    if u > 0.0 && u < 1.0 {
+                        on_s.push((u, p));
+                    }
+                }
+                for p in [a, b] {
+                    let v = (p - c).dot(q) / (ql * ql);
+                    if v > 0.0 && v < 1.0 {
+                        on_t.push((v, p));
+                    }
+                }
+            }
+            segments[i].splits.extend(on_s);
+            segments[j].splits.extend(on_t);
+        }
+    }
+
+    // The pieces, each once.
+    let mut points = Points::new();
+    let mut pieces: Vec<(usize, usize)> = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    for s in &mut segments {
+        s.splits.push((0.0, s.a));
+        s.splits.push((1.0, s.b));
+        s.splits.sort_by(|x, y| x.0.total_cmp(&y.0));
+        let ids: Vec<usize> = s.splits.iter().map(|&(_, p)| points.id(p)).collect();
+        for w in ids.windows(2) {
+            let (x, y) = (w[0], w[1]);
+            if x != y && seen.insert((x.min(y), x.max(y))) {
+                pieces.push((x, y));
+            }
+        }
+    }
+
+    // Keep the pieces with the selection on one side only, the selection on their left.
+    let selected = |p: Point| {
+        let memberships: Vec<bool> = shapes
+            .iter()
+            .zip(&bounds)
+            .map(|(shape, b)| {
+                p.x >= b.x0
+                    && p.x <= b.x1
+                    && p.y >= b.y0
+                    && p.y <= b.y1
+                    && shape.iter().map(|polygon| winding(polygon, p)).sum::<i32>() != 0
+            })
+            .collect();
+        inside(&memberships)
+    };
+    let mut edges: Vec<(usize, usize)> = Vec::new();
+    for &(x, y) in &pieces {
+        let (a, b) = (points.points[x], points.points[y]);
+        let direction = b - a;
+        let length = direction.hypot();
+        let normal = Vec2::new(-direction.y, direction.x) / length * (SNAP * 10.0);
+        let middle = a.midpoint(b);
+        let (left, right) = (selected(middle + normal), selected(middle - normal));
+        if left != right {
+            edges.push(if left { (x, y) } else { (y, x) });
+        }
+    }
+
+    // Join them into loops.
+    let mut from: std::collections::HashMap<usize, Vec<usize>> = std::collections::HashMap::new();
+    for (i, &(x, _)) in edges.iter().enumerate() {
+        from.entry(x).or_default().push(i);
+    }
+    let mut used = vec![false; edges.len()];
+    let mut path = BezPath::new();
+    for first in 0..edges.len() {
+        if used[first] {
+            continue;
+        }
+        used[first] = true;
+        let start = edges[first].0;
+        path.move_to(points.points[start]);
+        let mut at = edges[first].1;
+        let mut count = 1;
+        while at != start && count <= edges.len() {
+            path.line_to(points.points[at]);
+            let Some(next) = from
+                .get(&at)
+                .and_then(|list| list.iter().copied().find(|&e| !used[e]))
+            else {
+                break;
+            };
+            used[next] = true;
+            at = edges[next].1;
+            count += 1;
+        }
+        path.close_path();
+    }
+    path
+}
