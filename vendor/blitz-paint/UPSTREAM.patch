+    }
+
+    fn draw_svg_mask(
+        &self,
+        scene: &mut impl PaintScene,
+        url: &style::values::computed::url::ComputedUrl,
+        mode: StyloMaskMode,
+        layer: usize,
+    ) -> bool {
+        use super::clip_path::svg_reference::*;
+        let dom = self.context.dom;
