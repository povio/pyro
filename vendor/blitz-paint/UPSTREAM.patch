+        (1.0 - t) * (1.0 - t),
+        2.0 * std::f64::consts::FRAC_1_SQRT_2 * t * (1.0 - t),
+        t * t,
+    );
+    let sum = points[0].to_vec2() * a + points[1].to_vec2() * b + points[2].to_vec2() * c;
+    (sum / (a + b + c)).to_point()
