+/// the rest of the paint; `scratch` holds the chain walked.
+fn propagated_decorations(
+    doc: &BaseDocument,
+    node_id: NodeId,
+    cache: &mut Vec<Option<(NodeId, Propagated)>>,
+    scratch: &mut Vec<NodeId>,
