+/// A colour's luminance mask value as its alpha, over black: `alpha × luminance`.
+fn luminance_color(color: Color) -> Color {
+    let [r, g, b, a] = color.components;
+    Color::new([0.0, 0.0, 0.0, (a * luminance([r, g, b])).clamp(0.0, 1.0)])
