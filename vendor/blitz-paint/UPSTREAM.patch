+            return None;
+        }
+        let half = self.width.max(0.0) / 2.0;
+        let inner = self.oval?.inflate(-half, -half);
+        ((inner.width() - inner.height()).abs() < 1e-6 && inner.width() > 0.0).then_some(inner)
