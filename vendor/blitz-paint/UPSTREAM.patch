+//! pyro: Chromium's 16x16 broken-image icon: its `IDR_BROKENIMAGE` resource
+//! (https://chromium.googlesource.com/chromium/src/, `ui/resources/default_100_percent/common/`),
+//! as Chrome draws it at 1x, captured over white and over black to recover its alpha: RGBA8,
+//! straight alpha, row by row.
+//!
+//! Copyright 2015 The Chromium Authors. Used under Chromium's BSD-style (3-clause) license; the
+//! full notice is in the repository's NOTICE file.
+
+pub(crate) const BROKEN_IMAGE_16: [u8; 1024] = [
+    0xad, 0xaf, 0xb2, 0xff, 0xc0, 0xc4, 0xcb, 0xff, 0xc2, 0xc6, 0xcd, 0xff, 0xc2, 0xc6, 0xcd, 0xff,
+    0xc2, 0xc6, 0xcd, 0xff, 0xc2, 0xc6, 0xcd, 0xff, 0xc2, 0xc6, 0xcd, 0xff, 0xc2, 0xc6, 0xcd, 0xff,
+    0xc2, 0xc6, 0xcd, 0xff, 0xc2, 0xc6, 0xcd, 0xff, 0xbc, 0xbf, 0xc5, 0xff, 0xa2, 0xa2, 0xa4, 0xb0,
+    0x96, 0x96, 0x96, 0x22, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0xb8, 0xbd, 0xc6, 0xff, 0xd1, 0xdf, 0xf6, 0xff, 0xd3, 0xe2, 0xfb, 0xff, 0xd3, 0xe2, 0xfb, 0xff,
+    0xd3, 0xe2, 0xfb, 0xff, 0xd3, 0xe2, 0xfb, 0xff, 0xd3, 0xe2, 0xfb, 0xff, 0xd3, 0xe2, 0xfb, 0xff,
