+                return path;
+            }
+            return BezPath::new();
+        }
+        let shapes = [flatten(&self.outer), self.stroke_area(&self.outer, total.abs() * 2.0)];
+        if total > 0.0 {
+            boolean(&shapes, |inside| inside[0] || inside[1])
+        } else {
+            boolean(&shapes, |inside| inside[0] && !inside[1])
+        }
+    }
