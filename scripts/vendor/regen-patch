const CANDIDATES = [
  { rev: HEAD, name: 'HEAD' },
  ...mergeHeads.map((rev, i) => ({ rev, name: mergeHeads.length > 1 ? `MERGE_HEAD ${i + 1}` : 'MERGE_HEAD' })),
  ...pickHeads.map((rev) => ({ rev, name: 'the commit being applied' })),
