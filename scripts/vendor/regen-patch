  const section = (rel, flags) => {
    const a = up.has(rel) ? path.join(dir, 'a', rel) : null, b = work.has(rel) ? path.join(dir, 'b', rel) : null;
    const la = a ? `a/${P(rel)}` : '/dev/null', lb = b ? `b/${P(rel)}` : '/dev/null';
    if (style === 'apple-git') {
      const head = [`diff --git a/${P(rel)} b/${P(rel)}`, ...(a ? [] : ['new file mode 100644']), ...(b ? [] : ['deleted file mode 100644'])];
      return head.join('\n') + '\n' + appleDiff(flags, a, b, la, lb);
    }
    if (style === 'unified') return appleDiff(flags, a, b, la, lb);
    if (style === 'diff-ruN') {
      const t = ctx.times(rel);
      return `diff -ruN a/${P(rel)} b/${P(rel)}\n` + appleDiff(flags, a, b, `a/${P(rel)}\t${t.a}`, `b/${P(rel)}\t${t.b}`);
    }
    throw new Error(`${crate}: unknown style ${style}`);
  };
  for (const rel of rels) {
    let text = section(rel, ['-u']);
    // --fresh: a file as committed whose section another variant of the diff wrote (ALT_DIFF) takes that variant's.
    const committed = ctx.committed(rel);
    if (committed !== undefined && text !== committed) {
      for (const flags of CRATES[crate].alt ?? []) {
        const t = section(rel, flags);
        if (t === committed) { text = t; ctx.alt.push(`${rel} (diff ${flags.join(' ')})`); break; }
      }
    }
    out.set(rel, text.replace(/\n$/, ''));
  }
  return out;
}

function compare(order) {
  const byPath = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
  if (order !== 'tree') return byPath;
  return (a, b) => {
    const x = a.split('/'), y = b.split('/');
    for (let i = 0; i < Math.min(x.length, y.length); i++) if (x[i] !== y[i]) return byPath(x[i], y[i]);
    return x.length - y.length;
  };
}

// ---------- one crate ----------
const conflictMarker = /^(<{7}|>{7}) /m;

function regen(crate) {
  const cfg = CRATES[crate];
  if (!cfg) throw new Error(`${crate}: not in CRATES (scripts/vendor/regen-patch): add its patch style there`);
  const dir = `vendor/${crate}`;
  const work = workFiles(crate);
  const readme = path.join(ROOT, dir, 'README.pyro.md');
  const workTitle = fs.existsSync(readme) ? firstLine(fs.readFileSync(readme)) : null;

  // Each revision's upstream: its committed patch reverse-applied to its sources (null when it does not apply).
  const revs = CANDIDATES.map((c) => ({ ...c, ...revFiles(c.rev, crate) })).filter((r) => r.patch !== null);
  if (!revs.length) throw new Error(`${crate}: none of ${CANDIDATES.map((c) => c.name).join(', ')} has a committed ${dir}/UPSTREAM.patch to reconstruct the upstream from`);
  for (const [i, r] of revs.entries()) {
    const twin = revs.slice(0, i).find((x) => x.patch === r.patch && sameFiles(x.files, r.files));
    if (twin) { r.up = twin.up; r.err = twin.err; continue; }
    try {
      r.up = applyPatch(r.files, r.patch, crate, { reverse: true });
    } catch (e) {
      r.up = null;
      r.err = e.message;
    }
  }
  const label = (r) => `${short(r.rev)} (${r.name})`;
  // The upstream comes from main's side of a merge, else from the base: the first of them whose patch reverse-applies.
  // Main's wins over the base's because a merge carries main's patch on: main fixed a stale patch the base has, or
  // has a stale one this merge keeps (CI's check keeps main's right). A crate the base does not have yet: the first
  // revision that has its patch.
  const prefs = [MAIN_SIDE, BASE].filter(Boolean).map((rev) => revs.find((r) => r.rev === rev)).filter(Boolean);
  let src = prefs.find((r) => r.up);
  if (!src && prefs.length) {
    throw new Error(`${crate}: the UPSTREAM.patch committed at ${label(prefs[0])} does not reverse-apply to its sources (a stale patch: pass --base with a revision whose patch is right): ${prefs[0].err}`);
  }
  if (!src) {
    src = revs[0];
    if (!src.up) throw new Error(`${crate}: the UPSTREAM.patch committed at ${label(src)} does not reverse-apply to its sources: ${src.err}`);
    console.error(`${crate}: the base has no UPSTREAM.patch; the upstream is reconstructed from ${src.name}'s`);
  }
  // A README.pyro.md title that is not src's: the crate moved to a new upstream. A revision on it (HEAD first) has the
  // upstream; with none, --base overrides the check (a title edited for its wording).
  if (workTitle && src.title && workTitle !== src.title) {
    const on = revs.find((r) => r.up && r.title === workTitle);
    if (on) console.error(`${crate}: README.pyro.md names another upstream than ${label(src)} ("${workTitle}" vs "${src.title}"): the upstream is rebuilt from ${label(on)}, which is on it`);
    else if (!opt('--base')) throw new Error(`${crate}: README.pyro.md names another upstream than ${label(src)} does ("${workTitle}" vs "${src.title}"): pass --base with a revision on the new upstream`);
    src = on ?? src;
  }
  const where = label(src);
  const up = src.up;
  if (opt('--upstream')) {
    const out = path.resolve(opt('--upstream'), crate);
    fs.rmSync(out, { recursive: true, force: true });
    writeDir(out, up);
  }
  // Both sides of a merge agreeing against the base, neither of them main's: the base is the odd one out.
  const others = revs.filter((r) => r !== src && r.up);
  if (!opt('--base') && !MAIN_SIDE && src.rev === BASE && others.length >= 2 &&
    others.every((r) => !sameFiles(r.up, up) && sameFiles(r.up, others[0].up))) {
    throw new Error(`${crate}: the upstream reconstructed at ${where} differs from the one ${others.map(label).join(' and ')} make` +
      ` (${differing(others[0].up, up).slice(0, 4).join(', ')}): a stale patch at the base, or a new upstream; pass --base ${others[0].name}`);
  }
  // Another revision's section of a file is reused only where its patch rebuilds the same upstream copy of the file.
  const sameUp = (r, rel) => !!r.up && (r.up.has(rel) ? up.has(rel) && r.up.get(rel).equals(up.get(rel)) : !up.has(rel));
  const refs = [];
  for (const r of revs) {
    if (r !== src) {
      const moved = r.title && src.title && r.title !== src.title;
      const bad = r.up ? differing(r.up, up) : null;
      if (moved) {
        console.error(`${crate}: ${label(r)} is on another upstream ("${r.title}" vs "${src.title}"): its sections are not reused`);
        continue;
      }
      if (!r.up) {
        console.error(`${crate}: warning: the UPSTREAM.patch committed at ${label(r)} does not reverse-apply to its sources: a stale patch there; its sections are regenerated, not reused`);
        continue;
      }
      if (bad.length) {
        const taken = `${short(src.rev)} (${src.name}${src.rev === MAIN_SIDE ? ", main's side" : ''}, taken)`;
        console.error(`${crate}: warning: ${label(r)} rebuilds another upstream than ${taken} in ${bad.slice(0, 4).join(', ')}` +
          `${bad.length > 4 ? `, … (${bad.length} files)` : ''}: a stale patch at one of them; its sections of those files are not reused` +
          ` (if ${short(src.rev)}'s is the stale one, pass --base ${short(r.rev)})`);
      }
    }
    try {
      refs.push({ ...r, sections: sections(r.patch, crate), usable: (rel) => sameUp(r, rel) });
    } catch (e) {
      if (r === src) throw e;
      console.error(`${crate}: warning: ${label(r)}'s UPSTREAM.patch is not read (${e.message}): its sections are regenerated, not reused`);
    }
  }
  return { cfg, dir, work, up, src, where, refs };
}

function writePatch(crate) {
  const r = regen(crate);
  const { cfg, dir, work, up, src, refs } = r;
  const rels = [...new Set([...up.keys(), ...work.keys()])].filter((f) => !(up.has(f) && work.has(f) && up.get(f).equals(work.get(f))));
  const base = refs.find((x) => x.rev === src.rev);
  // The revision whose patch has a section for the file as it is now.
  const asCommitted = (rel) => {
    const sha = work.has(rel) ? blobSha(work.get(rel)) : null;
    return refs.find((x) => x.usable(rel) && (x.shas.get(rel) ?? null) === sha && x.sections.has(rel));
  };
  const kept = new Map(), regenerate = [];
  for (const rel of rels) {
    const from = flag('--fresh') ? null : asCommitted(rel);
    if (from) kept.set(rel, { text: from.sections.get(rel).text, from: from.name });
    else regenerate.push(rel);
  }
  const abbrev = /^index ([0-9a-f]+)\.\./m.exec(base.patch)?.[1].length ?? 7;
  // stylo's labels hold file times: the committed ones where the file is as committed, else upstream's copy time and
  // the file's modification time, as `diff -ruN` writes them.
  const labelTime = (l) => l?.split('\t')[1];
  // A missing file's label: GNU diff's epoch, with its zone; git reads it as no file (a new or deleted one).
  const epoch = '1970-01-01 00:00:00.000000000 +0000';
  const count = (list) => list.reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map());
  const copyTime = [...count([...base.sections.values()].map((s) => labelTime(s.labels.a)).filter(Boolean))].sort((x, y) => y[1] - x[1])[0]?.[0] ?? epoch;
  const times = (rel) => {
    const any = refs.filter((x) => x.usable(rel)).map((x) => x.sections.get(rel)).find(Boolean);
    const same = asCommitted(rel);
    return {
      a: !up.has(rel) ? epoch : labelTime(any?.labels.a) ?? copyTime,
      b: !work.has(rel) ? epoch : same ? labelTime(same.sections.get(rel).labels.b) : localTime(fs.statSync(path.join(ROOT, dir, rel)).mtime),
    };
  };
  const ctx = { abbrev, times, committed: (rel) => asCommitted(rel)?.sections.get(rel).text, alt: [] };
  const made = regenerate.length ? generate(crate, up, work, regenerate, ctx) : new Map();
  const cmp = compare(cfg.order);
  let order = [...rels].sort((a, b) => cmp(cfg.prefix + a, cfg.prefix + b));
  if (cfg.order === 'committed') {
    const seen = [];
    for (const x of refs) for (const rel of x.sections.keys()) if (rels.includes(rel) && !seen.includes(rel)) seen.push(rel);
    order = [...seen, ...order.filter((f) => !seen.includes(f))];
  }
  const text = order.map((rel) => (kept.has(rel) ? kept.get(rel).text : made.get(rel) + '\n')).join('');
  const file = path.join(ROOT, dir, 'UPSTREAM.patch');
  const before = fs.existsSync(file) ? fs.readFileSync(file, 'latin1') : null;
  if (before !== text) fs.writeFileSync(file, text, 'latin1');
  const keptBy = count([...kept.values()].map((k) => k.from));
  const keptNote = [...keptBy].map(([k, n]) => `${n} from ${k}`).join(', ');
  console.log(`${crate}: UPSTREAM.patch ${before === text ? 'unchanged' : 'written'}: ${order.length} file(s)` +
    `${kept.size ? `, ${kept.size} section(s) kept as committed (${keptNote})` : ''}, ${regenerate.length} regenerated` +
    `${regenerate.length && regenerate.length <= 12 ? ` (${regenerate.sort().join(', ')})` : ''}${ctx.alt.length ? `; written by another diff variant: ${ctx.alt.sort().join(', ')}` : ''}`);
  return checkPatch(crate, { ...r, text });
}

function checkPatch(crate, ctx) {
  const dir = `vendor/${crate}`;
  const { work, up, where } = ctx ?? regen(crate);
  const file = path.join(ROOT, dir, 'UPSTREAM.patch');
  const text = ctx?.text ?? (fs.existsSync(file) ? fs.readFileSync(file, 'latin1') : '');
  if (/^(<{7}|={7}|>{7})( |$)/m.test(text)) {
    console.log(`${crate}: FAIL: ${dir}/UPSTREAM.patch has conflict markers (run scripts/vendor/regen-patch ${crate})`);
    return false;
  }
  let got;
  try {
    got = text.trim() ? applyPatch(up, text, crate) : new Map(up);
  } catch (e) {
    console.log(`${crate}: FAIL: ${dir}/UPSTREAM.patch does not apply to the upstream reconstructed at ${where}:\n${e.message}`);
    return false;
  }
  const bad = differing(got, work);
  const what = CRATES[crate].files ? CRATES[crate].files.map((f) => `${dir}/${f}`).join(', ') : dir;
  if (bad.length) {
    console.log(`${crate}: FAIL: ${dir}/UPSTREAM.patch applied to the upstream reconstructed at ${where} differs from the working tree in ${bad.length} file(s): ${bad.slice(0, 10).join(', ')}${bad.length > 10 ? ', …' : ''}`);
    return false;
  }
  // The next run rebuilds the upstream with `git apply -R` (a deleted file's section needs its `deleted file mode`).
  let back;
  try {
    back = text.trim() ? applyPatch(work, text, crate, { reverse: true }) : new Map(work);
  } catch (e) {
    console.log(`${crate}: FAIL: ${dir}/UPSTREAM.patch applies, but does not reverse-apply to ${what} (git apply -R), as the next run needs:\n${e.message}`);
    return false;
  }
  const badBack = differing(back, up);
  if (badBack.length) {
    console.log(`${crate}: FAIL: ${dir}/UPSTREAM.patch reverse-applied to ${what} gives another upstream than ${where}'s in ${badBack.length} file(s): ${badBack.slice(0, 10).join(', ')}`);
    return false;
  }
  console.log(`${crate}: patch verified: git apply on the upstream reconstructed at ${where} reproduces ${what}, and git apply -R gives it back`);
  return true;
}

// ---------- main ----------
const all = fs.readdirSync(path.join(ROOT, 'vendor')).filter((c) => fs.existsSync(path.join(ROOT, 'vendor', c, 'UPSTREAM.patch')) || lsTree(BASE, `vendor/${c}`).has('UPSTREAM.patch')).sort();
const list = flag('--all') ? all : names;
for (const c of list) if (!fs.existsSync(path.join(ROOT, 'vendor', c))) throw new Error(`no vendor/${c}`);
console.error(`base: ${short(BASE)} (${baseWhy})${mergeHeads.length ? `; merging ${mergeHeads.map(short).join(', ')}` : ''}` +
  `${MAIN_SIDE ? `; main's side: ${short(MAIN_SIDE)} (${MAIN_SIDE === HEAD ? 'HEAD' : 'MERGE_HEAD'})` : ''}`);
// In a merge: without the baseline driver git merged bench/wpt/*baseline.json as text (a pass can be lost silently).
if (mergeHeads.length) {
  const driver = spawnSync('git', ['config', '--get', 'merge.wpt-baseline.driver'], { cwd: ROOT }).stdout?.toString().trim();
  const wrapper = path.join(path.resolve(ROOT, git(['rev-parse', '--git-common-dir']).trim()), 'pyro-merge-wpt-baseline.sh');
  if (!driver || !fs.existsSync(wrapper)) {
    console.error('warning: the wpt-baseline merge driver is not set up in this clone, so git merged bench/wpt/baseline.json and' +
      ' reftest-baseline.json as text: check them (scripts/vendor/setup-merge-drivers.sh sets it up for the next merge)');
  }
}
let ok = true;
for (const crate of list) {
  try {
    ok = (flag('--check') ? checkPatch(crate) : writePatch(crate)) && ok;
  } catch (e) {
    console.log(`${crate}: FAIL: ${e.message.startsWith(`${crate}: `) ? e.message.slice(crate.length + 2) : e.message}`);
    ok = false;
  }
}
process.exit(ok ? 0 : 1);
