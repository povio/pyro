].filter((c, i, all) => c.rev && all.findIndex((d) => d.rev === c.rev) === i);

// ---------- trees ----------
// A tree is a Map rel -> Buffer: the covered files of vendor/<crate> at a revision, in the working tree, or in a
// scratch directory.
const covered = (crate, rel) => {
