  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    if (oldLeft > 0 || newLeft > 0) {
      const c = l[0];
      if (c === '\\') { cur.lines.push(l); continue; }
      if (c === '+') newLeft--;
      else if (c === '-') oldLeft--;
      else { oldLeft--; newLeft--; }
      cur.lines.push(l);
      continue;
    }
    if (l.startsWith('diff ')) {
      finish();
      const parts = l.split(' ');
      cur = { lines: [l], rel: relOf(parts.at(-1)), labels: {}, hunks: 0 };
    } else if (l.startsWith('--- ') && lines[i + 1]?.startsWith('+++ ')) {
      if (!cur || cur.hunks) { finish(); cur = { lines: [], rel: null, labels: {}, hunks: 0 }; }
      const a = l.slice(4), b = lines[i + 1].slice(4);
      cur.labels = { a, b };
      cur.rel ??= relOf(b.startsWith('/dev/null') ? a : b);
      cur.lines.push(l, lines[++i]);
    } else if (l.startsWith('@@ ')) {
      const m = /^@@ -\d+(?:,(\d+))? \+\d+(?:,(\d+))? @@/.exec(l);
      if (!m || !cur) throw new Error(`${crate}: unreadable hunk header in UPSTREAM.patch: ${l}`);
      oldLeft = m[1] === undefined ? 1 : Number(m[1]);
      newLeft = m[2] === undefined ? 1 : Number(m[2]);
      cur.hunks++;
      cur.lines.push(l);
