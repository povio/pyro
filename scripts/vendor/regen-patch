const CRATES = {
  anyrender_svg: { files: null, prefix: '', style: 'git-dirs', order: 'tree' },
  anyrender_vello_cpu: { files: null, prefix: '', style: 'git-dirs', order: 'tree' },
  'blitz-dom': { files: ['src', 'assets'], prefix: 'packages/blitz-dom/', style: 'blitz-dom', order: 'path' },
  'blitz-paint': { files: ['src'], prefix: 'packages/blitz-paint/', style: 'apple-git', order: 'path' },
  fontique: { files: null, prefix: '', style: 'git-repo', order: 'path' },
  parley: { files: null, prefix: '', style: 'git-repo', order: 'path' },
  parley_engine: { files: null, prefix: '', style: 'unified', order: 'committed' },
  // The sections last written on 2026-11-11 are minimal diffs (`diff -d`); later ones are plain `diff -u`.
  stylo: { files: null, prefix: '', style: 'diff-ruN', order: 'tree', alt: [['-u', '-d']] },
  // Cargo.toml is not upstream's (the workspace sections are cut), so it is not covered.
  taffy: { files: ['src', 'examples', 'README.md'], prefix: '', style: 'git-repo', order: 'path' },
