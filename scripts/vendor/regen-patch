// ---------- patch sections ----------
// Splits a patch into one section per file, by its hunks' line counts (a removed line that starts with "-- " is not
// taken for a file header). Returns Map rel -> text, in the patch's order, and each section's labels.
function sections(patch, crate) {
  const lines = patch.split('\n');
  if (lines.at(-1) === '') lines.pop();
  const out = new Map();
  let cur = null, oldLeft = 0, newLeft = 0;
  const finish = () => {
    if (!cur) return;
    if (!cur.rel) throw new Error(`${crate}: a section of the committed UPSTREAM.patch names no file:\n${cur.lines.slice(0, 3).join('\n')}`);
    out.set(cur.rel, { text: cur.lines.join('\n') + '\n', labels: cur.labels });
    cur = null;
  };
  const relOf = (p) => {
    const noTab = p.split('\t')[0];
    const stripped = noTab.slice(noTab.indexOf('/') + 1);
    const { prefix } = CRATES[crate];
    if (!stripped.startsWith(prefix)) throw new Error(`${crate}: UPSTREAM.patch names ${noTab}, outside ${prefix || 'the crate'}`);
    return stripped.slice(prefix.length);
