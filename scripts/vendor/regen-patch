  return r.status === 0 ? r.stdout.toString().trim() : null;
};

const TMP = fs.mkdtempSync(path.join(os.tmpdir(), 'regen-patch-'));
process.on('exit', () => fs.rmSync(TMP, { recursive: true, force: true }));
// Commands on the scratch trees: no user or system configuration (diff.algorithm, apply.whitespace, an attributes file
// with diff drivers), and no repository around them.
const SCRATCH_ENV = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith('GIT_')));
Object.assign(SCRATCH_ENV, {
  GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null', GIT_ATTR_NOSYSTEM: '1', GIT_CEILING_DIRECTORIES: TMP,
  HOME: TMP, XDG_CONFIG_HOME: TMP, LC_ALL: 'C',
});
